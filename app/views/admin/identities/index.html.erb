<% content_for :title, "Accounts · Admin" %>

<header class="page-header">
  <p class="eyebrow">Admin</p>
  <h1>Accounts</h1>
  <p class="page-header__lede">Newest first. Sign-ups are <%= Identity.signups_open? ? "open" : "closed" %>.</p>
  <%= render "admin/nav" %>
</header>

<%= render "admin/search", search_label: "Search accounts", placeholder: "Email or name" %>

<div class="admin-table">
  <table>
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Email</th>
        <th scope="col">Joined</th>
        <th scope="col">Last sign-in</th>
        <th scope="col">Passkeys</th>
        <th scope="col">Plan</th>
        <th scope="col">Feedback</th>
        <th scope="col">Campaigns</th>
      </tr>
    </thead>
    <tbody>
      <% @identities.each do |identity| %>
        <tr>
          <td>
            <%= identity.display_name %>
            <% if identity.admin? %><span class="badge admin-badge">Admin</span><% end %>
          </td>
          <td><%= identity.email_address %></td>
          <td><%= l(identity.created_at.to_date, format: :long) %></td>
          <td><%= identity.last_signed_in_at ? "#{time_ago_in_words(identity.last_signed_in_at)} ago" : "Never" %></td>
          <td><%= @passkey_counts.fetch(identity.id, 0) %></td>
          <td>
            <%= form_with model: identity, url: admin_identity_path(identity), method: :patch, class: "admin-plan" do |form| %>
              <%= form.label :plan, "Plan for #{identity.display_name}", class: "visually-hidden" %>
              <%= form.select :plan, Plan.all.map { [ _1.name, _1.key ] }, {}, class: "field__input", id: "identity_#{identity.id}_plan" %>
              <%= form.submit "Save", class: "button button--small" %>
            <% end %>
            <% if (held = identity.held_memberships.count).positive? %>
              <small class="admin-plan__over"><%= held %> on hold</small>
            <% end %>
          </td>
          <td>
            <%# Whether the header shows them the Feedback button (Admin::Identities::FeedbackAccessesController). %>
            <% if identity.feedback_enabled? %>
              <%= button_to "On", admin_identity_feedback_access_path(identity), method: :delete, params: { q: search_query.presence, page: params[:page].presence }.compact, class: "button button--small admin-toggle admin-toggle--on", "aria-label": "Feedback is on for #{identity.display_name}: turn it off", title: "Turn feedback off" %>
            <% else %>
              <%= button_to "Off", admin_identity_feedback_access_path(identity), params: { q: search_query.presence, page: params[:page].presence }.compact, class: "button button--small button--ghost admin-toggle", "aria-label": "Feedback is off for #{identity.display_name}: turn it on", title: "Turn feedback on" %>
            <% end %>
          </td>
          <td><%= identity.memberships.map { "#{_1.campaign.name} (#{_1.gm? ? "GM" : "player"})" }.to_sentence.presence || "None" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<%= render "admin/pages", pagy: @pagy, noun: "account" %>

<section id="account-new" class="card add-card stack admin-new" aria-labelledby="account-new-title">
  <h2 id="account-new-title" class="tool-card__name">Create new account</h2>
  <%= form_with model: @identity, url: admin_identities_path, class: "stack" do |form| %>
    <% if @identity.errors.any? %>
      <p class="form-error"><%= @identity.errors.full_messages.to_sentence %></p>
    <% end %>
    <div class="field">
      <%= form.label :email_address, "Email", class: "field__label" %>
      <%= form.email_field :email_address, required: true, autocomplete: "off", class: "field__input" %>
    </div>
    <div class="field">
      <%= form.label :name, "Display name", class: "field__label" %>
      <%= form.text_field :name, maxlength: 80, autocomplete: "off", class: "field__input" %>
    </div>
    <div class="field">
      <%= form.label :plan, class: "field__label" %>
      <%= form.select :plan, Plan.all.map { [ _1.name, _1.key ] }, {}, class: "field__input" %>
    </div>
    <%= form.submit "Create account", class: "button button--primary" %>
  <% end %>
  <p class="field__hint">They sign in with an emailed code. Without a name, they're asked for one the first time.</p>
</section>
