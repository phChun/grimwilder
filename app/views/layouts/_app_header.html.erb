<%# locals: (membership:) %>
<%# The shell: wordmark, tabs (All campaigns first, signed in) and account. Inside a campaign the tabs are the campaign's; elsewhere they're the toolkit's. %>
<header class="app-header">
  <%= link_to root_path, class: "brand" do %>
    <%= brand_mark %>
    <span class="brand__name">Grimwilder</span>
    <span class="brand__beta">Beta</span>
  <% end %>

  <% if membership %>
    <nav class="tabs" aria-label="Campaign">
      <% campaign_tabs(membership).each do |text, path, current| %>
        <% if path.is_a?(Array) %>
          <%# More than one character seated here: a menu of their sheets. %>
          <details class="tab-menu" data-controller="menu" data-action="toggle->menu#place">
            <summary class="<%= class_names("tabs__link", "tab-menu__button", "tabs__link--current": current) %>"><%= text %><%= icon(:chevron, size: 14) %></summary>
            <ul class="tab-menu__menu" data-menu-target="panel">
              <%= render "shared/popover_head", title: text, list: true %>
              <% path.each do |name, sheet_path, open| %>
                <li><%= link_to name, sheet_path, "aria-current": (open ? "page" : nil) %></li>
              <% end %>
            </ul>
          </details>
        <% else %>
          <%= link_to text, path, class: "tabs__link", "aria-current": (current ? "page" : nil) %>
        <% end %>
      <% end %>
      <% text, path, current = characters_tab %>
      <%= link_to text, path, class: "tabs__link", "aria-current": (current ? "page" : nil) %>
      <% if admin_tab %>
        <% text, path, current = admin_tab %>
        <%= link_to text, path, class: "tabs__link", "aria-current": (current ? "page" : nil) %>
      <% end %>
    </nav>
  <% else %>
    <nav class="tabs" aria-label="Toolkit">
      <% if authenticated? %>
        <% text, path, current = all_campaigns_tab %>
        <%= link_to text, path, class: "tabs__link", "aria-current": (current ? "page" : nil) %>
      <% end %>
      <% toolkit_nav.each do |item| %>
        <% if item[:ready] %>
          <% path = public_send(item[:path]) %>
          <%= link_to item[:label], path, class: "tabs__link", "aria-current": (current_page?(path) ? "page" : nil) %>
        <% else %>
          <span class="tabs__link tabs__link--soon" title="Coming soon"><%= item[:label] %></span>
        <% end %>
      <% end %>
      <% if authenticated? %>
        <% text, path, current = characters_tab %>
        <%= link_to text, path, class: "tabs__link", "aria-current": (current ? "page" : nil) %>
        <% if admin_tab %>
          <% text, path, current = admin_tab %>
          <%= link_to text, path, class: "tabs__link", "aria-current": (current ? "page" : nil) %>
        <% end %>
      <% end %>
    </nav>
  <% end %>

  <% if authenticated? %>
    <%# While it's in beta, anything saved may be wiped, so everyone with an account is told on every page. %>
    <p class="reset-notice">While in beta, data may be reset any time</p>
    <%# A hand-written <a> on purpose (the linter's link_to hint is wrong here): Herb compiles link_to statically and drops the quotes around an interpolated aria-label with a space, either way it's written. %>
    <a class="account" href="<%= profile_path %>" aria-label="Account: <%= Current.identity.display_name %>"><%= initial(Current.identity.display_name) %></a>
  <% else %>
    <%= link_to "Sign in", new_session_path, class: "account account--signin" %>
  <% end %>
</header>
