<%# locals: (membership:) %>
<%# The shell: wordmark, tabs (All campaigns first, signed in) and account. Inside a campaign the tabs are the campaign's; elsewhere they're the toolkit's (layouts/_nav_items). On a phone the tabs, Feedback and the account fold into the ☰ menu. %>
<header class="app-header">
  <%= link_to root_path, class: "brand" do %>
    <%= brand_mark %>
    <span class="brand__name">Grimwilder</span>
    <span class="brand__beta">Beta</span>
  <% end %>

  <nav class="tabs" aria-label="<%= membership ? "Campaign" : "Toolkit" %>">
    <%= render "layouts/nav_items", membership: membership %>
  </nav>

  <% if authenticated? %>
    <%# While it's in beta, anything saved may be wiped, so everyone with an account is told on every page. %>
    <p class="reset-notice">While in beta, data may be reset any time</p>
    <%# Accounts an admin turned feedback on for: a box for what they think, with this page's path (feedbacks/new, in the frame modal). %>
    <% if Current.identity.feedback_enabled? %>
      <%= link_to new_feedback_path(path: request.fullpath), class: "button button--small feedback-button", title: "Send feedback about this page", "aria-label": "Send feedback", data: { turbo_frame: "modal" } do %><%= icon(:message, size: 16) %><span>Feedback</span><% end %>
    <% end %>
    <%# A hand-written <a> on purpose (the linter's link_to hint is wrong here): Herb compiles link_to statically and drops the quotes around an interpolated aria-label with a space, either way it's written. %>
    <a class="account" href="<%= profile_path %>" aria-label="Account: <%= Current.identity.display_name %>"><%= initial(Current.identity.display_name) %></a>
  <% else %>
    <%= link_to "Sign in", new_session_path, class: "account account--signin" %>
  <% end %>

  <%# Phones: everything above but the wordmark, in one menu. %>
  <details class="nav-menu" data-controller="menu" data-action="toggle->menu#place">
    <summary class="button nav-menu__toggle" aria-label="Menu"><%= icon(:menu, size: 20) %></summary>
    <div class="nav-menu__panel" data-menu-target="panel">
      <%= render "shared/popover_head", title: "Menu" %>
      <nav class="nav-menu__links" aria-label="<%= membership ? "Campaign" : "Toolkit" %>">
        <%= render "layouts/nav_items", membership: membership, menu: true %>
      </nav>
      <div class="nav-menu__links nav-menu__links--account">
        <% if authenticated? %>
          <% if Current.identity.feedback_enabled? %>
            <%= link_to new_feedback_path(path: request.fullpath), class: "nav-menu__link", data: { turbo_frame: "modal" } do %><%= icon(:message, size: 16) %> Send feedback<% end %>
          <% end %>
          <a class="nav-menu__link nav-menu__account" href="<%= profile_path %>"><span class="account account--inline" aria-hidden="true"><%= initial(Current.identity.display_name) %></span> Account · <%= Current.identity.display_name %></a>
        <% else %>
          <%= link_to "Sign in", new_session_path, class: "nav-menu__link" %>
        <% end %>
      </div>
    </div>
  </details>
</header>
