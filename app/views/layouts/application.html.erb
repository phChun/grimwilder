<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Grimwilder" : "Grimwilder — a Grimwild play toolkit" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Dice, pools, crucibles and characters for Grimwild: Community Edition.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Grimwilder">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="color-scheme" content="dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# List stylesheets explicitly: Herb compiles stylesheet_link_tag to a static <link> via stylesheet_path, which doesn't understand Propshaft's :app shorthand. %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <% membership = context_membership %>
    <%= render "layouts/app_header", membership: membership %>
    <% if membership %>
      <%= turbo_stream_from membership.campaign, :live %>
      <% if live_banner?(membership) %>
        <div id="<%= membership.campaign.live_banner_id %>"><%= render "campaigns/live_banner", campaign: membership.campaign %></div>
      <% end %>
    <% end %>

    <main id="main" class="site-main">
      <%= yield %>
    </main>

    <% if membership %>
      <%# Permanent, so a morph refresh doesn't close the roll call's modal; broadcasts update what's inside. %>
      <div id="<%= membership.campaign.roll_call_slot_id %>" data-turbo-permanent>
        <%= render "roll_calls/frame", campaign: membership.campaign, call: RollCall.showing_for(membership.campaign, membership) %>
      </div>
    <% end %>
    <%= render "shared/toasts" %>
    <%= render "shared/confirm" %>
    <%= render "shared/frame_modal" %>

    <footer class="site-footer">
      <nav aria-label="Toolkit">
        <ul class="site-footer__tools">
          <% toolkit_nav.select { _1[:ready] }.each do |item| %>
            <li><%= link_to item[:label], public_send(item[:path]) %></li>
          <% end %>
        </ul>
      </nav>
      <p>
        Grimwilder is an unofficial fan toolkit. Rules from
        <cite>Grimwild: <%= Grimwild::EDITION %></cite>, based on <cite>Grimwild</cite> by J.&nbsp;D.&nbsp;Maxwell (Oddity Press),
        used under <a href="https://creativecommons.org/licenses/by/4.0/">CC&nbsp;BY&nbsp;4.0</a>.
        Not endorsed by or affiliated with the original creator.
      </p>
    </footer>
  </body>
</html>
