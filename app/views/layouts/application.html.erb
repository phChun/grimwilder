<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Grimwilder" : "Grimwilder — a Grimwild play toolkit" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Dice, pools, crucibles and characters for Grimwild: Community Edition.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Grimwilder">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IM+Fell+English+SC&family=Zilla+Slab:ital,wght@0,400;0,600;0,700;1,400&display=swap">

    <%# List stylesheets explicitly: Herb compiles stylesheet_link_tag to a static <link> via stylesheet_path, which doesn't understand Propshaft's :app shorthand. %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="site-header__inner">
        <%= link_to root_path, class: "brand" do %>
          <span class="brand__mark" aria-hidden="true">&#10033;</span>
          <span class="brand__name">Grimwilder</span>
        <% end %>

        <nav class="site-nav" aria-label="Toolkit">
          <% toolkit_nav.each do |item| %>
            <% if item[:ready] %>
              <% path = public_send(item[:path]) %>
              <%= link_to item[:label], path, class: "site-nav__link", "aria-current": (current_page?(path) ? "page" : nil) %>
            <% else %>
              <span class="site-nav__link site-nav__link--soon" title="Coming soon"><%= item[:label] %></span>
            <% end %>
          <% end %>
        </nav>

        <nav class="account-nav" aria-label="Account">
          <% if authenticated? %>
            <%= link_to "Campaigns", campaigns_path, class: "site-nav__link", "aria-current": (current_page?(campaigns_path) ? "page" : nil) %>
            <%= link_to Current.identity.display_name, profile_path, class: "site-nav__link account-nav__me" %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "site-nav__link account-nav__signin" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main id="main" class="site-main">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <footer class="site-footer">
      <p>
        Grimwilder is an unofficial fan toolkit. Rules from
        <cite>Grimwild: Community Edition</cite>, based on <cite>Grimwild</cite> by J.&nbsp;D.&nbsp;Maxwell (Oddity Press),
        used under <a href="https://creativecommons.org/licenses/by/4.0/">CC&nbsp;BY&nbsp;4.0</a>.
        Not endorsed by or affiliated with the original creator.
      </p>
    </footer>
  </body>
</html>
