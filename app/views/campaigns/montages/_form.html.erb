<%# locals: (characters:, classes: nil) %>
<%# Called while ending a scene (then=end_scene), it stays in the modal (data-modal-stay) and goes back to ending it; cut= carries on to the next scene after. %>
<% ending = params[:then] == "end_scene" %>
<%= form_with url: campaign_montages_path(Current.campaign), class: class_names("stack quarrel-form", classes), data: (ending ? { modal_stay: true } : { turbo_frame: "_top" }) do %>
  <% if ending %><input type="hidden" name="then" value="end_scene"><% end %>
  <% if ending && params[:cut].present? %><input type="hidden" name="cut" value="1"><% end %>
  <div class="field">
    <label class="field__label" for="montage_scene">The scene</label>
    <input type="text" id="montage_scene" name="scene" value="<%= params[:scene] %>" maxlength="200" autocomplete="off" placeholder="The six-hour climb to the sanctum" class="field__input">
  </div>

  <fieldset class="roll-setup__group">
    <legend class="field__label">Who takes part</legend>
    <ul class="list">
      <% characters.each do |character| %>
        <% choice = params.dig(:participants, character.id.to_s) || {} %>
        <li class="list__item quarrel-form__row">
          <label class="check">
            <%= check_box_tag "participants[#{character.id}][in]", "1", choice[:in] == "1", id: "montage_in_#{character.id}" %>
            <span>
              <strong><%= character.name %></strong>
              <small><%= character.identity.display_name %> · <%= pluralize(character.spark, "spark") %></small>
            </span>
          </label>
        </li>
      <% end %>
    </ul>
  </fieldset>

  <p class="field__hint">Each player then rolls their own, with any spark they spend.</p>
  <button type="submit" class="button button--primary">Call for the montage</button>
<% end %>
