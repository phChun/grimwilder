<% content_for :title, "End scene #{@scene.number} · #{Current.campaign.name}" %>

<header class="page-header">
  <p class="eyebrow"><%= link_to Current.campaign.name, campaign_path(Current.campaign) %></p>
  <h1>End scene <%= @scene.number %>: <%= @scene.title %></h1>
  <p class="page-header__lede">Close it once it has served its purpose, usually with a montage roll (pg. 95).</p>
</header>

<%= form_with url: campaign_scene_ending_path(Current.campaign, @scene), class: "panel stack session-form" do %>
  <div class="field">
    <label class="field__label" for="scene_closing">Close with a montage</label>
    <% if @montages.any? %>
      <%= select_tag :closing_roll_id, options_for_select(@montages.map { [ "#{_1.question || _1.name}: #{_1.outcome}", _1.id ] }, @montages.first.id), include_blank: "No montage", id: "scene_closing", class: "field__input" %>
    <% else %>
      <p class="field__hint">No montage rolled in this scene yet.</p>
    <% end %>
    <p class="field__hint"><%= link_to "Roll a montage", new_campaign_montage_path(Current.campaign, then: "end_scene", scene: @scene.title) %>, then come back here.</p>
  </div>

  <div class="field">
    <label class="field__label" for="scene_notes">Notes</label>
    <textarea id="scene_notes" name="notes" rows="4" class="field__input" autocomplete="off" placeholder="What happened, what's left hanging…"></textarea>
  </div>

  <%= render "campaigns/scenes/lingering_conditions", scene: @scene %>

  <button type="submit" class="button button--primary">End the scene</button>
<% end %>
