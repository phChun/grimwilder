<% content_for :title, "Start a scene · #{Current.campaign.name}" %>

<%# Its own page, and from the GM table's "Start scene" a modal (shared/_frame_modal). The prepared scenes come first: each scene collection's, closed but for the one the last scene came from (first), then the standalone ones, open; each starts as written, or fills in the form below to adjust first (plan=). Then a new scene. Starting forms target _top, so the table refreshes. %>
<%= turbo_frame_tag "modal" do %>
  <header class="page-header">
    <p class="eyebrow"><%= link_to Current.campaign.name, campaign_path(Current.campaign) %></p>
    <h1>Start a scene</h1>
    <p class="page-header__lede">Open in the middle of the action (pg. 96). If the setup is unclear, open with a story roll: give the scene a question, and the story roll opens with it.</p>
  </header>

  <% if @session %>
    <% if @choices.any? %>
      <div class="scene-picker">
        <% @choices.each do |collection, plans| %>
          <%= tag.details class: "fold scene-picker__group", open: (@plan ? plans.include?(@plan) : (collection.nil? || collection == @last_collection)) do %>
            <summary class="fold__summary">
              <span class="fold__title"><%= collection ? collection.title : "Standalone scenes" %><% if collection && collection == @last_collection %> <span class="scene-collection__tag">In progress</span><% end %></span>
              <span class="fold__meta"><%= pluralize(plans.size, "scene") %></span>
            </summary>
            <% if collection&.notes %><p class="scene-plans__notes"><%= collection.notes %></p><% end %>
            <ol class="scene-plans">
              <% plans.each do |plan| %>
                <li class="<%= class_names("scene-plans__item", "scene-plans__item--picked": plan == @plan) %>">
                  <div class="scene-plans__main">
                    <strong class="scene-plans__title"><%= plan.title %></strong>
                    <% if plan.story_question %><span class="field__hint">Story roll: <%= plan.story_question %></span><% end %>
                    <% if plan.notes %><p class="scene-plans__notes scene-plans__notes--short"><%= plan.notes %></p><% end %>
                  </div>
                  <div class="scene-plans__actions">
                    <%= button_to "Start", campaign_scenes_path(Current.campaign), params: { scene_plan_id: plan.id, as_written: 1 }, class: "button button--small button--primary", form: { data: { turbo_frame: "_top" } }, "aria-label": "Start #{plan.title}" %>
                    <%= link_to "Adjust first", new_campaign_scene_path(Current.campaign, plan: plan.id, anchor: "scene_title"), class: "button button--small", "aria-label": "Adjust #{plan.title} first" %>
                  </div>
                </li>
              <% end %>
            </ol>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="field__hint">Nothing prepared to play. <%= link_to "Scene prep", campaign_scene_plans_path(Current.campaign), data: { turbo_frame: "_top" } %></p>
    <% end %>

    <%= tag.details class: "fold scene-picker__new", open: @plan.present? || @choices.empty? || flash[:alert].present? do %>
      <summary class="fold__summary">
        <span class="fold__title"><%= @plan ? "Adjust #{@plan.title}" : "A new scene" %></span>
      </summary>
      <%= form_with url: campaign_scenes_path(Current.campaign), class: "stack session-form", data: { turbo_frame: "_top" } do %>
        <% if @plan %><input type="hidden" name="scene_plan_id" value="<%= @plan.id %>"><% end %>
        <div class="field">
          <label class="field__label" for="scene_title">Title</label>
          <input type="text" id="scene_title" name="title" value="<%= params[:title] || @plan&.title %>" required maxlength="120" autocomplete="off" placeholder="The bridge at Mirefall" class="field__input">
          <p class="field__hint">Scene <%= @session.scenes.maximum(:number).to_i + 1 %> of <%= @session.title.downcase %>.</p>
        </div>
        <div class="field">
          <label class="field__label" for="scene_notes">Notes <small>(optional, for you: they show on the table while the scene is on)</small></label>
          <textarea id="scene_notes" name="notes" rows="3" maxlength="2000" class="field__input"><%= params[:notes] || @plan&.notes %></textarea>
        </div>

        <div class="field">
          <label class="field__label" for="scene_story_question">Story roll question <small>(optional)</small></label>
          <input type="text" id="scene_story_question" name="story_question" value="<%= params[:story_question] || @plan&.story_question %>" maxlength="200" autocomplete="off" placeholder="Are the guards awake?" class="field__input" aria-describedby="scene_story_hint">
          <p id="scene_story_hint" class="field__hint">The story roll opens with it as the scene starts, to pick the odds and who rolls.</p>
        </div>

        <button type="submit" class="button button--primary">Start the scene</button>
      <% end %>
    <% end %>
  <% else %>
    <div class="panel stack">
      <p>No session is going. A scene happens within a session.</p>
      <p><%= link_to "Start a session first", new_campaign_play_session_path(Current.campaign), class: "button button--primary", data: { turbo_frame: "_top" } %> <%= link_to "Scene prep", campaign_scene_plans_path(Current.campaign), class: "button", data: { turbo_frame: "_top" } %></p>
    </div>
  <% end %>
<% end %>
