<% content_for :title, "Settings · #{Current.campaign.name}" %>
<% campaign = Current.campaign %>

<header class="page-header">
  <p class="eyebrow"><%= link_to campaign.name, campaign_path(campaign) %></p>
  <h1>Campaign settings</h1>
</header>

<div class="settings">
  <% if gm? %>
    <section class="card stack" aria-labelledby="settings-pitch">
      <h2 id="settings-pitch" class="card__title">The pitch</h2>
      <p class="field__hint">What the campaign page leads with. Settle these at session zero (pg. 45).</p>
      <datalist id="group-arcs"><% Grimwild.arcs.values.flatten.each do |arc| %><option value="<%= title_case(arc) %>"></option><% end %></datalist>
      <%= form_with model: campaign, class: "stack" do |form| %>
        <% if campaign.errors.any? %>
          <p class="form-error"><%= campaign.errors.full_messages.to_sentence %></p>
        <% end %>
        <div class="field">
          <%= form.label :name, "Campaign name", class: "field__label" %>
          <%= form.text_field :name, required: true, maxlength: 80, class: "field__input" %>
        </div>
        <div class="field">
          <%= form.label :pitch, "One-line pitch", class: "field__label" %>
          <%= form.text_field :pitch, maxlength: 200, autocomplete: "off", placeholder: "Toll-roads, drowned villages, and an accord that's quietly coming apart.", class: "field__input" %>
        </div>
        <fieldset class="fieldset">
          <legend class="field__label">The party is <small>two concepts</small></legend>
          <div class="two-up">
            <% 2.times do |index| %>
              <input type="text" name="campaign[party_is][]" value="<%= campaign.party_is[index] %>" maxlength="40" autocomplete="off" class="field__input" aria-label="Party concept <%= index + 1 %>" placeholder="<%= index.zero? ? "Wardens" : "Outsiders" %>">
            <% end %>
          </div>
        </fieldset>
        <div class="two-up">
          <div class="field">
            <%= form.label :party_never, "Never", class: "field__label" %>
            <%= form.text_field :party_never, maxlength: 80, autocomplete: "off", placeholder: "Mercenaries", class: "field__input" %>
          </div>
          <div class="field">
            <%= form.label :group_arc, "Group arc", class: "field__label" %>
            <%= form.text_field :group_arc, maxlength: 80, autocomplete: "off", list: "group-arcs", placeholder: type_or_select, class: "field__input" %>
          </div>
        </div>
        <div class="field">
          <%= form.label :setting, "Setting", class: "field__label" %>
          <%= form.text_field :setting, maxlength: 80, autocomplete: "off", placeholder: "The Bramble Marches", class: "field__input" %>
        </div>
        <%= form.submit "Save", class: "button button--primary" %>
      <% end %>
    </section>

    <%# What the GM decides about characters here (Campaign::CharacterSettings). %>
    <section id="settings-characters" class="card stack" aria-labelledby="settings-characters-title">
      <h2 id="settings-characters-title" class="card__title">Characters</h2>
      <%= form_with model: campaign, class: "stack settings-form" do |form| %>
        <input type="hidden" name="section" value="settings-characters">
        <label class="check">
          <%= form.check_box :players_make_characters %>
          <span><strong>Players make their own characters.</strong> Off, you make them (up for grabs) and players pick one.</span>
        </label>
        <label class="check">
          <%= form.check_box :players_set_level %>
          <span><strong>Players set their own level.</strong> Off, levels change only with XP or a milestone.</span>
        </label>
        <div class="field field--inline">
          <%= form.label :starting_level, "New characters start at", class: "field__label" %>
          <%= form.select :starting_level, [ [ "The player's choice", "" ], *(campaign.optional_rule?(:level_zero) ? [ [ "Level 0", 0 ] ] : []), *(1..Grimwild::MAX_LEVEL).map { [ "Level #{_1}", _1 ] } ], {}, class: "field__input" %>
        </div>
        <fieldset class="fieldset settings-form__paths">
          <legend class="field__label">Paths open here</legend>
          <input type="hidden" name="campaign[allowed_paths][]" value="">
          <div class="settings-form__grid">
            <% Grimwild.paths.each_key do |path| %>
              <label class="check">
                <%= check_box_tag "campaign[allowed_paths][]", path, campaign.path_allowed?(path), id: "path-#{path.parameterize}" %>
                <%= path %>
              </label>
            <% end %>
          </div>
          <p class="field__hint">Untick a path to close it. Characters already playing keep theirs.</p>
        </fieldset>
        <%= form.submit "Save", class: "button button--primary" %>
      <% end %>
    </section>

    <%# The optional rules (Campaign::OptionalRules), grouped as GROUPS lays them out. %>
    <section id="settings-rules" class="card stack" aria-labelledby="settings-rules-title">
      <h2 id="settings-rules-title" class="card__title">Optional rules</h2>
      <p class="field__hint">From the book's Game Options (pg. 175–179). Pools a rule gives arrive at once; characters already using an option keep it if you turn it off.</p>
      <%= form_with model: campaign, class: "stack settings-form" do |form| %>
        <input type="hidden" name="section" value="settings-rules">
        <input type="hidden" name="campaign[optional_rules][]" value="">
        <% Campaign::OptionalRules::GROUPS.each do |group, rules| %>
          <fieldset class="fieldset settings-form__group">
            <legend class="field__label"><%= group %></legend>
            <% rules.each do |rule| %>
              <% rule_name, page, does = Campaign::OptionalRules::RULES.fetch(rule) %>
              <label class="check settings-form__rule">
                <%= check_box_tag "campaign[optional_rules][]", rule, campaign.optional_rule?(rule), id: "rule-#{rule}" %>
                <span><strong><%= rule_name %></strong> <small>pg. <%= page %></small><br><span class="field__hint"><%= does %></span></span>
              </label>
            <% end %>
          </fieldset>
        <% end %>
        <%= form.submit "Save", class: "button button--primary" %>
      <% end %>
    </section>
  <% end %>

  <section id="settings" class="card stack" aria-label="Invite and members">
    <%= render "campaigns/settings", memberships: @memberships, gm: gm? %>
  </section>
</div>
