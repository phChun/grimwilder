<%# locals: (rolls:, after:, before:, open: nil) %>
<%# The log between two sessions (rests, downtime, rolls, notes made outside one), in its place in the history, oldest first, folded like the sessions. after/before: the sessions either side; nil at the ends, and both nil before the first session. %>
<% title = if after && before then "Between Sessions #{after.number} and #{before.number}"
           elsif before then "Before #{before.title}"
           elsif after then "Since #{after.title}"
           else "Before Session 1"
           end %>
<% key = before ? "between-before-#{before.number}" : "between-since" %>
<li class="panel session-card session-card--between">
  <%= tag.details id: key, class: "fold session-card__fold", open: open, data: { details_memory_target: "section", section: key, phone_open: open.to_s } do %>
    <summary class="fold__summary session-card__head">
      <h3 class="session-card__title"><%= title %></h3>
      <span class="session-card__date"><%= pluralize(rolls.size, "entry") %></span>
    </summary>
    <ol class="roll-log"><%= render partial: "rolls/roll", collection: rolls, as: :roll %></ol>
  <% end %>
</li>
