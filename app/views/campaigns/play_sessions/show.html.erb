<% content_for :title, "#{@session.title} · #{Current.campaign.name}" %>

<header class="page-header">
  <p class="eyebrow"><%= link_to Current.campaign.name, campaign_path(Current.campaign) %> · <%= link_to "Sessions", campaign_play_sessions_path(Current.campaign) %></p>
  <h1><%= @session.title %></h1>
  <p class="page-header__lede">
    <%= l(@session.started_at.to_date, format: :long) %><%= " · going now" if @session.open? %>
    <% if @session.standout? %> · a standout session<% end %>
  </p>
</header>

<div class="session-page">
  <%# The log first (each scene with its rolls, then anything outside scenes), then the recap, notes and who was there. %>
  <% @session.scenes.ordered.each do |scene| %>
    <section id="<%= dom_id(scene) %>" class="panel stack session-scene" aria-labelledby="<%= dom_id(scene, :title) %>">
      <h2 id="<%= dom_id(scene, :title) %>" class="panel__title">Scene <%= scene.number %>: <%= scene.title %></h2>
      <% if scene.opening_roll %><p class="session-scene__bookend">Opened with a story roll: <strong><%= scene.opening_roll.outcome %></strong><%= " (#{scene.opening_roll.question})" if scene.opening_roll.question %></p><% end %>
      <% if scene.closing_roll %><p class="session-scene__bookend">Closed with a montage: <strong><%= scene.closing_roll.outcome %></strong></p><% end %>
      <% if scene.notes.present? %><p class="session-page__text"><%= scene.notes %></p><% end %>
      <% if gm? %>
        <details class="fold">
          <summary class="fold__summary"><span class="fold__title session-page__edit">Edit scene</span></summary>
          <%= form_with model: scene, url: campaign_scene_path(Current.campaign, scene), class: "stack" do |form| %>
            <div class="field">
              <%= form.label :title, "Title", class: "field__label" %>
              <%= form.text_field :title, required: true, maxlength: 120, class: "field__input" %>
            </div>
            <div class="field">
              <%= form.label :notes, "Notes", class: "field__label" %>
              <%= form.text_area :notes, rows: 3, class: "field__input" %>
            </div>
            <%= form.submit "Save", class: "button button--small" %>
          <% end %>
        </details>
      <% end %>
      <% if (rolls = @rolls[scene.id]).present? %>
        <ol class="roll-log"><%= render partial: "rolls/roll", collection: rolls, as: :roll %></ol>
      <% end %>
    </section>
  <% end %>

  <% if (loose = @rolls[nil]).present? %>
    <section class="panel stack" aria-labelledby="session-loose">
      <h2 id="session-loose" class="panel__title">Outside scenes</h2>
      <ol class="roll-log"><%= render partial: "rolls/roll", collection: loose, as: :roll %></ol>
    </section>
  <% end %>

  <section class="panel stack" aria-labelledby="session-recap">
    <h2 id="session-recap" class="panel__title">Previously on…</h2>
    <% if @session.recap.present? %><p class="session-page__text"><%= @session.recap %></p><% elsif !@session.first? %><p class="empty">No recap.</p><% end %>
    <% if @session.notes.present? %>
      <h3 class="fold__heading">Notes</h3>
      <p class="session-page__text"><%= @session.notes %></p>
    <% end %>
    <% if gm? %>
      <details class="fold">
        <summary class="fold__summary"><span class="fold__title session-page__edit">Edit recap and notes</span></summary>
        <%= form_with model: @session, url: campaign_play_session_path(Current.campaign, @session), class: "stack" do |form| %>
          <div class="field">
            <%= form.label :recap, "Previously on…", class: "field__label" %>
            <%= form.text_area :recap, rows: 5, class: "field__input" %>
          </div>
          <div class="field">
            <%= form.label :notes, "Notes", class: "field__label" %>
            <%= form.text_area :notes, rows: 4, class: "field__input" %>
          </div>
          <%= form.submit "Save", class: "button button--small" %>
        <% end %>
      </details>
    <% end %>
  </section>

  <section class="panel stack" aria-labelledby="session-attendance">
    <h2 id="session-attendance" class="panel__title">Who was there</h2>
    <% if @session.characters.any? %>
      <p><%= safe_join(@session.characters.ordered.map { link_to(_1.name, character_path(_1)) }, ", ") %></p>
    <% else %>
      <p class="empty">No one was marked present.</p>
    <% end %>
  </section>
</div>
