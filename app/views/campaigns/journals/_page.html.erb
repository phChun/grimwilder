<%# locals: (journal:, page:, viewer:, compact: nil, character: nil) %>
<%# One page of a journal: its title (or the day it was started), whether it's the GM's, and the words. The player stars it to keep it on top. In full (the journal), its title opens it in the modal, to read or, for whoever may change it, edit. compact (a sheet's Journal card): its title folds the words open, read only, with Edit for whoever may change it. %>
<% favoritable = journal.favoritable_by?(viewer) %>
<% star = capture do %>
  <% if favoritable %>
    <%= button_to campaign_journal_page_favorite_path(journal.campaign, journal.membership, page), method: page.favorite? ? :delete : :post, params: { character_id: character&.id }.compact,
      class: class_names("journal-page__star", "journal-page__star--on": page.favorite?), "aria-label": page.favorite? ? "Unstar #{page.heading}" : "Star #{page.heading}", title: page.favorite? ? "Starred" : "Star it to keep it on top" do %><%= icon(:star, size: 18) %><% end %>
  <% elsif page.favorite? %>
    <span class="journal-page__star journal-page__star--on" title="Starred"><%= icon(:star, size: 18, label: "Starred") %></span>
  <% end %>
<% end %>
<% tags = capture do %>
  <% if page.shared? %><span class="journal-page__tag">With the GM</span>
  <% elsif page.by_gm? %><span class="journal-page__tag">From the GM</span><span class="journal-page__tag journal-page__tag--quiet">Read only</span><% end %>
  <span class="field__hint">written <%= time_ago_in_words(page.updated_at) %> ago</span>
<% end %>
<% words = capture do %>
  <% if page.body.present? %>
    <div class="journal-page__text"><%= chat_format(page.body) %></div>
  <% else %>
    <p class="field__hint">Nothing written yet.</p>
  <% end %>
<% end %>
<% if compact %>
  <article id="page-<%= page.id %>" class="<%= class_names("journal-page journal-page--compact", "journal-page--favorite": page.favorite?, "journal-page--starrable": star.present?) %>">
    <%= star %>
    <details class="journal-page__fold">
      <summary class="journal-page__head journal-page__summary">
        <h4 class="journal-page__title"><%= page.heading %></h4>
        <%= tags %>
        <%= icon(:chevron, size: 16) %>
      </summary>
      <div class="stack journal-page__fold-body">
        <%= words %>
        <% if journal.editable_by?(page, viewer) %>
          <p class="journal-page__actions"><a href="<%= campaign_journal_page_path(journal.campaign, journal.membership, page, character_id: character&.id) %>" class="button button--small" data-turbo-frame="modal" aria-label="Edit <%= page.heading %>">Edit</a></p>
        <% end %>
      </div>
    </details>
  </article>
<% else %>
  <article id="page-<%= page.id %>" class="<%= class_names("journal-page card stack", "journal-page--favorite": page.favorite?) %>">
    <header class="journal-page__head">
      <%= star %>
      <h2 class="journal-page__title"><%= link_to page.heading, campaign_journal_page_path(journal.campaign, journal.membership, page), class: "journal-page__open", data: { turbo_frame: "modal" } %></h2>
      <%= tags %>
    </header>
    <%= words %>
  </article>
<% end %>
