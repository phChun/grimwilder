<%# locals: (journal:, page:, viewer:) %>
<%# One page of a journal: its title (or the day it was started), who wrote it if it was the GM, and the words. Whoever may change it edits it in the modal. %>
<article id="page-<%= page.id %>" class="card stack journal-page">
  <header class="journal-page__head">
    <h2 class="journal-page__title"><%= page.heading %></h2>
    <% if page.by_gm? %><span class="journal-page__tag">From the GM</span><% end %>
    <% if page.locked? %><span class="journal-page__tag journal-page__tag--quiet">Read only</span><% end %>
    <span class="field__hint">written <%= time_ago_in_words(page.updated_at) %> ago</span>
  </header>
  <p class="journal-page__text"><%= chat_format(page.body) %></p>
  <% if journal.editable_by?(page, viewer) %>
    <p><%= link_to "Edit", edit_campaign_journal_page_path(journal.campaign, journal.membership, page), class: "button button--small", data: { turbo_frame: "modal" }, "aria-label": "Edit #{page.heading}" %></p>
  <% end %>
</article>
