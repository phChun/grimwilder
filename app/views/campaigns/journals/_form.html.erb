<%# locals: (journal:, page:, viewer:, character: nil, cancel_url: nil) %>
<%# A page's fields, new or being changed: an optional title and the words. The player may star a new one; a GM's page may be locked, so the player can read it but not change it. From a sheet's Journal card (character), saving comes back to the sheet. With cancel_url, Cancel sits beside Save. %>
<% id = "journal_page_#{page.id || "new"}#{"_sheet" if character}" %>
<% url = page.persisted? ? campaign_journal_page_path(journal.campaign, journal.membership, page) : campaign_journal_pages_path(journal.campaign, journal.membership) %>
<%= form_with model: page, scope: :journal_page, url: url, method: page.persisted? ? :patch : :post, class: "stack journal-form", data: { turbo_frame: "_top" } do |form| %>
  <% if character %><input type="hidden" name="character_id" value="<%= character.id %>"><% end %>
  <div class="field">
    <%= form.label :title, "Title", class: "field__label", for: "#{id}_title" %>
    <%= form.text_field :title, id: "#{id}_title", maxlength: JournalPage::TITLE_LIMIT, placeholder: "Optional", class: "field__input" %>
  </div>
  <div class="field">
    <%= form.label :body, "Page", class: "field__label", for: "#{id}_body" %>
    <%= form.text_area :body, id: "#{id}_body", rows: page.persisted? ? 12 : 6, maxlength: JournalPage::BODY_LIMIT, placeholder: viewer.gm? ? "A secret, a backstory, something only they know…" : "What happened, who you met, what you're afraid of…", class: "field__input journal-page__body", "aria-describedby": "#{id}_format" %>
    <p id="<%= id %>_format" class="field__hint">*italics* **bold**, - or 1. to start a list, as in the chat</p>
  </div>
  <% if page.new_record? && journal.favoritable_by?(viewer) %>
    <label class="check">
      <%= tag.input type: "checkbox", name: "journal_page[favorite]", value: "1", id: "#{id}_favorite" %>
      <span>Star it, to keep it on top</span>
    </label>
  <% end %>
  <% if viewer.gm? %>
    <label class="check">
      <input type="hidden" name="journal_page[locked]" value="0">
      <%= tag.input type: "checkbox", name: "journal_page[locked]", value: "1", checked: page.new_record? || page.locked?, id: "#{id}_locked" %>
      <span>Read only for <%= journal.membership.identity.display_name %></span>
    </label>
  <% end %>
  <div class="journal-form__actions">
    <%= form.submit page.persisted? ? "Save" : "Add page", class: "button button--primary" %>
    <% if cancel_url %><%= link_to "Cancel", cancel_url, class: "button button--danger", data: { turbo_frame: "journal_new" } %><% end %>
  </div>
<% end %>
