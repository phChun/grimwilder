<% content_for :title, "#{@page.title} · Your journal · #{Current.campaign.name}" %>

<%# Its own page, and from the journal a modal (shared/_frame_modal). The form targets _top, so saving refreshes the journal. %>
<%= turbo_frame_tag "modal" do %>
  <header class="page-header">
    <p class="eyebrow"><%= link_to "Your journal", campaign_journal_path(Current.campaign, @journal.membership) %></p>
    <h1><%= @page.title %></h1>
    <p class="page-header__lede">Leave it blank to clear the page.</p>
  </header>

  <%= form_with scope: :journal_entry, url: campaign_journal_page_path(Current.campaign, @journal.membership, @page.key), method: :patch, class: "panel stack", data: { turbo_frame: "_top" } do |form| %>
    <%= form.label :body, "What happened, as you saw it", class: "field__label" %>
    <%= form.text_area :body, value: @body || @page.body, rows: 12, maxlength: JournalEntry::BODY_LIMIT, class: "field__input journal-page__body", "aria-describedby": "journal_format" %>
    <p id="journal_format" class="field__hint">*italics* **bold**, as in the chat</p>
    <%= form.submit "Save", class: "button button--primary" %>
  <% end %>
<% end %>
