<% content_for :title, "#{@page.heading} · Journal · #{Current.campaign.name}" %>

<%# Its own page, and from the journal a modal (shared/_frame_modal). The form targets _top, so saving refreshes the journal. %>
<%= turbo_frame_tag "modal" do %>
  <header class="page-header">
    <p class="eyebrow"><%= link_to "Journal", campaign_journal_path(Current.campaign, @journal.membership) %></p>
    <h1><%= @page.heading %></h1>
  </header>

  <div class="panel stack">
    <%= render "campaigns/journals/form", journal: @journal, page: @page, viewer: Current.membership %>
    <%= button_to "Tear out this page", campaign_journal_page_path(Current.campaign, @journal.membership, @page), method: :delete, class: "button button--small button--ghost button--danger-text", form: { data: { turbo_frame: "_top", turbo_confirm: "Tear out #{@page.heading}? This can't be undone." } } %>
  </div>
<% end %>
