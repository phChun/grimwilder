<% own = @journal.membership == Current.membership %>
<% owner = @journal.membership.identity %>
<% content_for :title, "#{own ? "Your journal" : "#{owner.display_name}'s journal"} · #{Current.campaign.name}" %>

<%# A player's journal: a New page button that opens its form in place, then a Sort select (Journal::SORTS: favorites first, chronologically or last updated), then the pages across the page. A GM adds pages of their own here (read only for the player by default) and reads the player's while it's shared. %>
<header class="page-header">
  <p class="eyebrow"><%= link_to Current.campaign.name, campaign_path(Current.campaign) %><% unless own %> · <%= link_to "Journals", campaign_journals_path(Current.campaign) %><% end %></p>
  <h1><%= own ? "Your journal" : "#{owner.display_name}'s journal" %></h1>
  <% if own %>
    <div class="journal-share">
      <p class="page-header__lede">
        <%= @journal.membership.journal_shared? ? "The GM can read it. Nobody else at the table can." : "Only you can read it, and the GM the pages they're in." %>
      </p>
      <%= button_to @journal.membership.journal_shared? ? "Keep it private" : "Let the GM read it",
        campaign_journal_path(Current.campaign, @journal.membership), method: :patch,
        params: { membership: { journal_shared: @journal.membership.journal_shared? ? "0" : "1" } }, class: "button button--small" %>
    </div>
  <% elsif @journal.membership.journal_shared? %>
    <p class="page-header__lede">Shared with the GM. <%= owner.display_name %> can make it private at any time.</p>
  <% else %>
    <p class="page-header__lede"><%= owner.display_name %> keeps it private: you see only the GM's pages.</p>
  <% end %>
</header>

<div class="journal">
  <%= render "campaigns/journals/new_button", journal: @journal %>
  <hr class="journal__rule">
  <% if @pages.any? %>
    <%# The order the pages are in (Journal::SORTS), kept in the URL. %>
    <%= form_with url: campaign_journal_path(Current.campaign, @journal.membership), method: :get, class: "journal__sort", data: { controller: "auto-submit", turbo_action: "replace" } do |form| %>
      <%= form.label :sort, "Sort", class: "field__label", for: "journal_sort" %>
      <%= form.select :sort, Journal::SORTS.invert.to_a, { selected: @sort }, id: "journal_sort", class: "field__input", data: { action: "change->auto-submit#submit" } %>
      <noscript><%= form.submit "Sort", class: "button button--small" %></noscript>
    <% end %>
    <div class="journal__pages">
      <%= render partial: "campaigns/journals/page", collection: @pages, as: :page, locals: { journal: @journal, viewer: Current.membership } %>
    </div>
  <% else %>
    <p class="empty">No pages yet.</p>
  <% end %>
</div>
