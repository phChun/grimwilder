<%# locals: (url:) %>
<%# herb:slots client %>
<%# herb:state (copied: false) %>
<button type="button" class="button copy-invite" data-controller="clipboard" data-clipboard-text-value="<%= url %>" data-action="clipboard#copy">
  <%= icon(:link) %>
  <% if copied %>Copied<% else %>Copy invite link<% end %>
</button>
