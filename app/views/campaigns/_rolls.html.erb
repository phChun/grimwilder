<%# locals: (characters:, my_characters:) %>
<%# The table's group rolls in one fold: a story roll, a montage or a quarrel, picked with the segmented control. CSS (:has) shows the chosen form, so switching needs no script or reload. Montages need a character in the party and quarrels two; until then they're greyed out, saying so. %>
<% montage_needs = ("Needs a character at the table" if characters.none?) %>
<% quarrel_needs = ("Needs two characters at the table" if characters.size < 2) %>
<div class="rolls">
  <%= render "shared/segmented", name: "roll_kind", legend: "Kind of roll", options: [ %w[ story Story ], [ "montage", "Montage", montage_needs ], [ "quarrel", "Quarrel", quarrel_needs ] ], checked: "story", classes: "segmented--auto rolls__kinds" %>
  <% if quarrel_needs %>
    <p class="field__hint rolls__needs"><%= montage_needs ? "Montages need a character in the party, and quarrels two." : "Quarrels need two characters in the party." %> Up-for-grabs characters join once a player picks them.</p>
  <% end %>

  <div class="rolls__panel rolls__panel--story">
    <%# The GM can call on anyone at the table for a story roll; a player on their own characters. %>
    <%= render "campaigns/story_roll", my_characters: (gm? ? characters : my_characters) %>
  </div>

  <% if characters.any? %>
    <div class="rolls__panel rolls__panel--montage">
      <p class="field__hint">Zoom out over a stretch of the story. Everyone taking part rolls 2d, and the best result is the scene's outcome (pg. 16).</p>
      <%= render "campaigns/montages/form", characters: characters %>
    </div>
  <% end %>

  <% if characters.size >= 2 %>
    <div class="rolls__panel rolls__panel--quarrel">
      <p class="field__hint">Characters at odds: each side rolls 2d plus spark, allies assist with 1d, and the highest die wins. Everyone in it takes spark (pg. 23).</p>
      <%= render "campaigns/quarrels/form", characters: characters %>
    </div>
  <% end %>
</div>
