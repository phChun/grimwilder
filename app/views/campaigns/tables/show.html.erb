<% content_for :title, "Table · #{Current.campaign.name}" %>
<% content_for :head do %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>
<%= turbo_stream_from Current.campaign, :pools %>
<%= turbo_stream_from Current.campaign, :table %>

<% campaign = Current.campaign %>
<% scene = @session&.current_scene %>
<% seats = table_seats(@memberships, @characters) %>
<% first_crucible = @crucible_groups.first.last.first %>

<%# The GM table: the scene, suspense and the GM's session controls on top, the party, pools as cards and the crucible, with the table's log and chat in the rail. %>
<div class="fluid gm-view" data-controller="details-memory" data-details-memory-campaign-value="<%= campaign.id %>" data-action="toggle->details-memory#toggled:capture turbo:morph@document->details-memory#restore">
  <div class="fluid__main gm-view__main">
    <section class="scene-bar" aria-labelledby="scene-title">
      <div class="scene-bar__scene">
        <p class="scene-bar__status">
          <% if @session %>
            <span class="live-banner__dot" aria-hidden="true"></span>
            <%= @session.title %> · live <%= running_for(@session.started_at) %><% if scene %> · Scene <%= scene.number %> of <%= @session.scenes.size %><% end %>
          <% else %>
            Between sessions
          <% end %>
          · <%= link_to "History", campaign_play_sessions_path(campaign) %>
        </p>
        <h1 id="scene-title" class="scene-bar__title"><%= scene&.title || (@session ? "Between scenes" : campaign.name) %></h1>

        <%# Suspense, then the scene, the session and a break, spaced evenly across the bar, in the order the GM reaches for them. %>
        <div class="scene-bar__actions">
          <%= render "campaigns/tables/suspense_panel", campaign: campaign %>
          <% if scene %>
            <%= link_to "Cut to new scene", new_campaign_scene_ending_path(campaign, scene, then: "new_scene"), class: "button button--ghost" %>
          <% elsif @session %>
            <%= link_to "Start scene", new_campaign_scene_path(campaign), class: "button button--ghost" %>
          <% end %>
          <% if @session %>
            <%= link_to "End session", new_campaign_play_session_ending_path(campaign, @session), class: "button button--ghost" %>
          <% else %>
            <%= link_to "Start session", new_campaign_play_session_path(campaign), class: "button button--primary" %>
          <% end %>
          <details class="between-scenes" data-controller="menu" data-action="toggle->menu#place">
            <summary class="button button--ghost between-scenes__toggle">Respite</summary>
            <div class="between-scenes__actions" data-menu-target="panel">
              <%= render "shared/popover_head", title: "How long a break?" %>
              <%= button_to "Rest", campaign_rest_path(campaign), class: "button button--small", form: { data: { turbo_confirm: "Rest: clear marks and harm for #{@session ? "everyone here" : "everyone seated"}?" } } %>
              <%= link_to "Downtime", new_campaign_downtime_path(campaign), class: "button button--small", data: { turbo_frame: "modal" } %>
            </div>
          </details>
        </div>
      </div>
    </section>

    <section id="table" class="gm-section" aria-labelledby="party-title">
      <div class="gm-section__head">
        <h2 id="party-title" class="gm-section__title">Party</h2>
      </div>
      <div class="party-grid">
        <% seats.each do |membership, seated| %>
          <% if seated.empty? %>
            <div class="party-card party-card--empty">
              <span class="party-card__name"><%= membership.identity.display_name %></span>
              <span class="party-card__meta">Making a character</span>
            </div>
          <% end %>
          <% seated.each do |character| %>
            <article class="party-card">
              <div class="party-card__head">
                <%= link_to character.name, character_path(character), class: "party-card__name" %>
                <span class="party-card__meta"><%= character.path %> <%= character.level %> · <%= membership.identity.display_name %></span>
              </div>
              <p class="<%= class_names("party-card__harm", "party-card__harm--none": harm_line(character).nil?) %>"><%= harm_line(character) || "No harm" %></p>
              <p class="party-card__currency">Spark <%= character.spark %> · Thread <%= character.thread %></p>
              <% uses = talent_use_summary(character) %>
              <% if uses.present? %><p class="party-card__uses"><%= uses %></p><% end %>
              <% if (pools = @talent_pools[character.id]) %>
                <ul class="party-card__pools">
                  <% pools.each do |pool| %>
                    <li class="seat-pool">
                      <span class="seat-pool__name"><%= pool.name.delete_prefix("#{character.name}: ") %></span>
                      <span class="seat-pool__size"><%= pool.size %>d</span>
                      <% if pool.rollable? %>
                        <%= button_to "Roll", campaign_pool_roll_path(campaign, pool), class: "button button--small", "aria-label": "Roll #{pool.name}" %>
                      <% elsif pool.depleted? %>
                        <%# At 0d the GM can put it back, in case it was spent by accident. %>
                        <%= button_to pool_reset_label(pool), campaign_pool_reset_path(campaign, pool), class: "button button--small", "aria-label": "Reset #{pool.name} to #{pool.starting_size}d" %>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </article>
          <% end %>
        <% end %>
        <%# The last card adds your own character to this table. %>
        <%= link_to new_character_path(campaign_id: campaign.id), class: "party-card party-card--empty add-card--link" do %>
          <span class="party-card__name">Create new character</span>
          <span class="party-card__meta">Yours, seated here</span>
        <% end %>
      </div>
    </section>

    <section id="pools" class="gm-section" aria-labelledby="pools-title">
      <div class="gm-section__head">
        <h2 id="pools-title" class="gm-section__title">Pools</h2>
        <%= tag.details id: "pool-new", class: "pool-new", open: @pool.errors.any?, data: { controller: "menu", action: "toggle->menu#place turbo:submit-end->menu#closeOnSuccess" } do %>
          <summary class="button pool-new__toggle">+ New pool</summary>
          <div class="pool-new__panel card" data-menu-target="panel"><%= render "shared/popover_head", title: "New pool" %><%= render "campaigns/pools/form", pool: @pool %></div>
        <% end %>
      </div>
      <% if @pools.any? %>
        <div class="pool-grid">
          <% @pools.each do |pool| %>
            <%= render "campaigns/pools/card", pool: pool, my_characters: @my_characters, scene: scene %>
          <% end %>
        </div>
      <% else %>
        <p class="empty">No pools yet. Add one when the story needs a clock.</p>
      <% end %>
    </section>

    <details id="rolls" class="card gm-fold" data-details-memory-target="section" data-section="rolls">
      <summary class="gm-fold__summary"><span class="gm-section__title">Rolls</span><%= icon(:chevron, size: 18) %></summary>
      <%= render "campaigns/rolls", characters: @characters, my_characters: @my_characters %>
    </details>

    <%# Permanent, so a morph doesn't wipe a roll; details-memory remembers whether it's open. The frame is lazy, so a closed fold doesn't load its table. %>
    <details id="crucibles" class="card gm-fold crucible-row" data-details-memory-target="section" data-section="crucible" data-turbo-permanent data-controller="crucible-picker" data-crucible-picker-url-value="<%= crucible_path("__key__", embed: 1) %>">
      <summary class="gm-fold__summary"><span class="gm-section__title">Crucible</span><%= icon(:chevron, size: 18) %></summary>
      <div class="crucible-picker">
        <div class="crucible-row__head">
          <label class="visually-hidden" for="crucible-pick">Crucible table</label>
          <select id="crucible-pick" class="field__input crucible-row__pick" data-crucible-picker-target="select" data-action="crucible-picker#pick">
            <% @crucible_groups.each do |group, crucibles| %>
              <optgroup label="<%= Crucible::GROUPS.fetch(group) %>">
                <% crucibles.each do |crucible| %>
                  <option value="<%= crucible.key %>"><%= crucible.name %></option>
                <% end %>
              </optgroup>
            <% end %>
          </select>
          <span class="visually-hidden" data-crucible-picker-target="current"><%= first_crucible.name %></span>
          <p class="crucible-picker__recent" data-crucible-picker-target="recent" hidden></p>
        </div>
        <%= turbo_frame_tag "crucible", src: crucible_path(first_crucible, embed: 1), loading: "lazy", data: { crucible_picker_target: "frame" } do %>
          <p class="crucible__hint">Loading <%= first_crucible.name %>…</p>
        <% end %>
      </div>
    </details>
  </div>

  <%= render "campaigns/table_rail", campaign: campaign, membership: Current.membership, feed: @feed, speakers: [], quick_roll: "#rolls", classes: "fluid__rail" %>
</div>
