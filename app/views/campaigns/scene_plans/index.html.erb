<% content_for :title, "Scene prep · #{Current.campaign.name}" %>

<%# The GM's prep: scene collections for where the players might go (SceneCollection), each with its scenes still to play and an "Add a scene" that opens its form in place, then the individual scenes (in no collection), then "Create new scene collection", then a few that have been played. Starting a scene offers them all. %>
<header class="page-header">
  <p class="eyebrow"><%= link_to Current.campaign.name, campaign_table_path(Current.campaign) %></p>
  <h1>Scene prep</h1>
  <p class="page-header__lede">Write scenes ahead of play, gathered in scene collections for where the players might go. Starting a scene offers every collection's scenes, then the individual ones.</p>
</header>

<div class="scene-prep">
  <% @collections.each do |collection| %>
    <% plans = collection.scene_plans.select { _1.scene_id.nil? }.sort_by { [ _1.position, _1.created_at ] } %>
    <section id="<%= dom_id(collection) %>" class="card stack scene-collection" aria-labelledby="<%= dom_id(collection, :title) %>">
      <div class="scene-collection__head">
        <h2 id="<%= dom_id(collection, :title) %>" class="card__title"><%= collection.title %> <small class="field__hint"><%= pluralize(plans.size, "scene") %> to play</small></h2>
        <div class="scene-plans__actions">
          <a href="<%= edit_campaign_scene_collection_path(Current.campaign, collection) %>" class="button button--small" aria-label="Edit <%= collection.title %>">Edit</a>
          <%= button_to "Remove", campaign_scene_collection_path(Current.campaign, collection), method: :delete, class: "button button--small button--danger", "aria-label": "Remove #{collection.title}", form: { data: { turbo_confirm: "Remove #{collection.title}? Its scenes stay in your prep, as individual scenes." } } %>
        </div>
      </div>
      <% if collection.notes %><p class="scene-plans__notes"><%= collection.notes %></p><% end %>
      <% if plans.any? %>
        <ol class="scene-plans">
          <%= render partial: "campaigns/scene_plans/plan", collection: plans, as: :plan, locals: { collections: @collections } %>
        </ol>
      <% else %>
        <p class="field__hint">No scenes left to play here.</p>
      <% end %>
      <%= render "campaigns/scene_plans/add_button", scene_collection: collection %>
    </section>
  <% end %>

  <section id="scene_plans_loose" class="card stack" aria-labelledby="plans-title">
    <h2 id="plans-title" class="card__title"><%= @collections.any? ? "Individual scenes" : "To play" %></h2>
    <% if @loose.any? %>
      <ol class="scene-plans">
        <%= render partial: "campaigns/scene_plans/plan", collection: @loose, as: :plan, locals: { collections: @collections } %>
      </ol>
    <% else %>
      <p class="field__hint"><%= @collections.any? ? "Every scene to play is in a collection." : "Nothing prepared yet." %></p>
    <% end %>
    <%= render "campaigns/scene_plans/add_button", scene_collection: nil %>
  </section>

  <turbo-frame id="new_scene_collection">
    <%= link_to new_campaign_scene_collection_path(Current.campaign), class: "card add-card add-card--link scene-prep__new" do %>
      <h2 class="card__title">Create new scene collection</h2>
      <p class="field__hint">A place or thread the players might follow, to gather its scenes under.</p>
    <% end %>
  </turbo-frame>

  <% if @played.any? %>
    <section class="card stack" aria-labelledby="played-title">
      <h2 id="played-title" class="card__title">Played</h2>
      <ul class="scene-plans scene-plans--played">
        <% @played.each do |plan| %>
          <li class="scene-plans__item"><span><%= plan.title %></span> <span class="field__hint"><%= plan.scene.heading %></span></li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
