<% content_for :title, "Scene prep · #{Current.campaign.name}" %>

<%# The GM's prep, every card a fold (Expand all / Collapse all; the standalone and played ones remembered per campaign by details-memory): the scene collections for where the players might go (SceneCollection), two across when there's room, closed but for the one the last scene came from, which comes first, marked In progress, each with its scenes still to play and its buttons at the bottom, then, on one row, Create new scene collection and the standalone scenes (in no collection); then a few that have been played. Each card's Add a scene opens its form in that card (scene_plans/_add). Starting a scene offers them all. %>
<header class="page-header">
  <p class="eyebrow"><%= link_to Current.campaign.name, campaign_table_path(Current.campaign) %></p>
  <h1>Scene prep</h1>
  <p class="page-header__lede">Write scenes ahead of play, gathered in scene collections for where the players might go. Starting a scene offers every collection's scenes, then the standalone ones.</p>
</header>

<div class="scene-prep" data-controller="details-memory" data-details-memory-campaign-value="<%= Current.campaign.id %>" data-action="toggle->details-memory#toggled:capture turbo:morph@document->details-memory#restore">
  <div class="scene-prep__tools">
    <button type="button" class="button button--small button--ghost" data-action="details-memory#foldAll" data-details-memory-open-param="true">Expand all</button>
    <button type="button" class="button button--small button--ghost" data-action="details-memory#foldAll" data-details-memory-open-param="false">Collapse all</button>
  </div>

  <section aria-labelledby="scene_collections_title">
    <h2 id="scene_collections_title" class="section-title">Scene collections</h2>
    <% if @collections.any? %>
      <div class="scene-prep__grid">
        <% @collections.each do |collection| %>
          <% plans = collection.scene_plans.select { _1.scene_id.nil? }.sort_by { [ _1.position, _1.created_at ] } %>
          <% current = collection == @last_collection %>
          <%= tag.details id: dom_id(collection), class: class_names("card sheet-fold scene-collection", "scene-collection--current": current), open: current do %>
            <summary class="gm-fold__summary"><h3 class="card__title sheet-fold__title"><%= collection.title %><% if current %> <span class="scene-collection__tag">In progress</span><% end %> <small class="field__hint"><%= pluralize(plans.size, "scene") %> to play</small></h3><%= icon(:chevron, size: 18) %></summary>
            <div class="stack">
              <% if collection.notes %><p class="scene-plans__notes"><%= collection.notes %></p><% end %>
              <% if plans.any? %>
                <ol class="scene-plans">
                  <%= render partial: "campaigns/scene_plans/plan", collection: plans, as: :plan, locals: { collections: @collections } %>
                </ol>
              <% else %>
                <p class="field__hint">No scenes left to play here.</p>
              <% end %>
              <div class="scene-plans__actions scene-collection__actions">
                <%= render "campaigns/scene_plans/add", scene_collection: collection %>
                <a href="<%= edit_campaign_scene_collection_path(Current.campaign, collection) %>" class="button button--small" aria-label="Edit <%= collection.title %>">Edit</a>
                <%= button_to "Remove", campaign_scene_collection_path(Current.campaign, collection), method: :delete, class: "button button--small button--danger", "aria-label": "Remove #{collection.title}", form: { data: { turbo_confirm: "Remove #{collection.title}? Its scenes stay in your prep, as standalone scenes." } } %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="field__hint">No scene collections yet.</p>
    <% end %>
  </section>

  <div class="scene-prep__grid scene-prep__more">
    <turbo-frame id="new_scene_collection">
      <%= link_to new_campaign_scene_collection_path(Current.campaign), class: "card add-card add-card--link scene-prep__new" do %>
        <h2 class="card__title">Create new scene collection</h2>
        <p class="field__hint">A place or thread the players might follow, to gather its scenes under.</p>
      <% end %>
    </turbo-frame>
    <details id="scene_plans_loose" class="card sheet-fold" open data-details-memory-target="section" data-section="scene-prep-standalone">
      <summary class="gm-fold__summary"><h2 class="card__title sheet-fold__title">Standalone scenes <small class="field__hint"><%= pluralize(@loose.size, "scene") %> to play</small></h2><%= icon(:chevron, size: 18) %></summary>
      <div class="stack">
        <p class="field__hint">Scenes in no collection, for anywhere the story goes.</p>
        <% if @loose.any? %>
          <ol class="scene-plans">
            <%= render partial: "campaigns/scene_plans/plan", collection: @loose, as: :plan, locals: { collections: @collections } %>
          </ol>
        <% end %>
        <div class="scene-plans__actions scene-collection__actions">
          <%= render "campaigns/scene_plans/add", scene_collection: nil %>
        </div>
      </div>
    </details>
  </div>

  <% if @played.any? %>
    <details id="scene_plans_played" class="card sheet-fold" data-details-memory-target="section" data-section="scene-prep-played">
      <summary class="gm-fold__summary"><h2 class="card__title sheet-fold__title">Previously played</h2><%= icon(:chevron, size: 18) %></summary>
      <ul class="scene-plans scene-plans--played">
        <% @played.each do |plan| %>
          <li class="scene-plans__item"><span><%= plan.title %></span> <span class="field__hint"><%= plan.scene.heading %></span></li>
        <% end %>
      </ul>
    </details>
  <% end %>
</div>
