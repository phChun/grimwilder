<%# locals: (scene_collection:) %>
<%# A card's Add a scene, in its own frame at the card's buttons: the form (scene_plans/new) takes its place, its collection picked (none: standalone), and Cancel brings the button back. %>
<turbo-frame id="new_scene_plan_<%= scene_collection&.id || "standalone" %>" class="scene-prep__add">
  <a href="<%= new_campaign_scene_plan_path(Current.campaign, collection: scene_collection&.id) %>" class="button button--small" aria-label="<%= scene_collection ? "Add a scene to #{scene_collection.title}" : "Add a standalone scene" %>">Add a scene</a>
</turbo-frame>
