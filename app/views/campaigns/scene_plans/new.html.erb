<% content_for :title, "New scene · #{Current.campaign.name}" %>

<%# Takes the Add a scene card's place on the prep page (its new_scene_plan frame), a collection picked if it came from one's Add a scene; on its own (or after a failed save), a page. The form targets _top; Cancel loads the card back. %>
<turbo-frame id="new_scene_plan">
  <section class="card stack add-card scene-prep__new" aria-labelledby="new_scene_plan_title">
    <h3 id="new_scene_plan_title" class="card__title">New scene</h3>
    <%= render "campaigns/scene_plans/form", plan: @plan, collections: Current.campaign.scene_collections.ordered, cancel_url: campaign_scene_plans_path(Current.campaign), frame: "new_scene_plan" %>
  </section>
</turbo-frame>
