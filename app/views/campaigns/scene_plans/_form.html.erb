<%# locals: (plan:, collections:, framed: nil, cancel_url: nil, frame: nil) %>
<%# A prepared scene: a title, notes for the GM, and maybe the question for a story roll as it opens: starting the scene opens the story roll with it, to pick the odds and who rolls. Its collection is picked with the select (blank: unassigned). framed: its own panel (the edit page). With cancel_url, Cancel sits beside the button and loads the frame back. %>
<% id = "scene_plan_#{plan.id || "new"}" %>
<%= form_with model: [ Current.campaign, plan ], class: class_names("stack scene-plan-form", "panel": framed), data: { turbo_frame: "_top" } do |form| %>
  <% if plan.errors.any? %><p class="form-error"><%= plan.errors.full_messages.to_sentence %></p><% end %>
  <div class="field">
    <%= form.label :title, "Title", class: "field__label", for: "#{id}_title" %>
    <%= form.text_field :title, id: "#{id}_title", required: true, maxlength: 120, autocomplete: "off", autofocus: plan.new_record?, placeholder: "The bridge at Mirefall", class: "field__input" %>
  </div>
  <div class="field">
    <%= form.label :notes, "Notes", class: "field__label", for: "#{id}_notes" %>
    <%= form.text_area :notes, id: "#{id}_notes", rows: 4, maxlength: 2000, placeholder: "Who's there, what they want, what could go wrong…", class: "field__input" %>
  </div>
  <div class="field">
    <%= form.label :story_question, class: "field__label", for: "#{id}_story_question" do %>Story roll question <small>(optional)</small><% end %>
    <%= form.text_field :story_question, id: "#{id}_story_question", maxlength: 200, autocomplete: "off", placeholder: "Are the guards awake?", class: "field__input", "aria-describedby": "#{id}_story_hint" %>
    <p id="<%= id %>_story_hint" class="field__hint">Starting the scene opens the story roll with this question, to pick the odds and who rolls.</p>
  </div>
  <% if collections.any? %>
    <div class="field">
      <%= form.label :scene_collection_id, "Scene collection", class: "field__label", for: "#{id}_collection" %>
      <%= form.select :scene_collection_id, collections.map { [ _1.title, _1.id ] }, { include_blank: "Unassigned" }, id: "#{id}_collection", class: "field__input" %>
    </div>
  <% end %>
  <div class="scene-plan-form__actions">
    <%= form.submit plan.new_record? ? "Add scene" : "Save", class: "button button--primary" %>
    <% if cancel_url %><%= link_to "Cancel", cancel_url, class: "button button--danger", data: { turbo_frame: frame } %><% end %>
  </div>
<% end %>
