<% content_for :title, Current.campaign.name %>

<header class="page-header">
  <p class="eyebrow"><%= gm? ? "You're the GM" : "You're a player" %></p>
  <h1><%= Current.campaign.name %></h1>
  <p><%= link_to "Pools", campaign_pools_path(Current.campaign), class: "button" %></p>
</header>

<% Roll.streams_for(Current.campaign, Current.membership).each do |stream| %>
  <%= turbo_stream_from(*stream) %>
<% end %>

<div class="campaign">
  <section id="roll-log" class="panel stack" aria-labelledby="campaign-log">
    <h2 id="campaign-log" class="panel__title">Table log</h2>
    <ol id="roll_log" class="roll-log" aria-live="polite"><%= render partial: "rolls/roll", collection: @rolls, as: :roll %></ol>
    <p class="empty roll-log__empty">No rolls yet. Rolls from character sheets and pools land here as they happen.</p>
  </section>

  <section id="story-roll" class="panel stack" aria-labelledby="campaign-story">
    <h2 id="campaign-story" class="panel__title">Story roll</h2>
    <p class="field__hint">For luck, or how true a doubtful detail is: from good (perfect) to bad (disaster).</p>
    <%= form_with url: campaign_story_rolls_path(Current.campaign), class: "stack" do %>
      <div class="field">
        <label class="field__label" for="story_question">Question <small>(optional)</small></label>
        <input type="text" id="story_question" name="question" maxlength="200" autocomplete="off" placeholder="Do I see any guards?" class="field__input">
      </div>

      <fieldset class="roll-setup__group">
        <legend class="field__label">Odds</legend>
        <div class="segmented segmented--auto">
          <% Roll::ODDS.each do |dice, odds| %>
            <label class="segmented__option">
              <%= radio_button_tag :odds, dice, dice == 2 %>
              <span><%= dice %>d <small><%= odds.delete_suffix(" odds") %></small></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div class="field">
        <label class="field__label" for="story_thorns">Thorns <small>d8, rare</small></label>
        <input type="number" id="story_thorns" name="thorns" value="0" min="0" max="<%= Character::Rolling::MAX_EXTRA %>" inputmode="numeric" autocomplete="off" class="field__input roll-setup__number">
      </div>

      <% if @my_characters.any? %>
        <div class="field">
          <label class="field__label" for="story_character">For</label>
          <select id="story_character" name="character_id" class="field__input">
            <option value="">No one in particular</option>
            <% @my_characters.each do |character| %>
              <option value="<%= character.id %>"><%= character.name %> (<%= pluralize(character.spark, "spark") %>)</option>
            <% end %>
          </select>
        </div>

        <div class="field">
          <label class="field__label" for="story_spark">Spend spark <small>+1d each</small></label>
          <input type="number" id="story_spark" name="spark" value="0" min="0" max="<%= Grimwild::MAX_SPARK %>" inputmode="numeric" autocomplete="off" class="field__input roll-setup__number">
          <p class="field__hint">Only for a character. A disaster gives them spark.</p>
        </div>
      <% end %>

      <button type="submit" class="button button--primary">Roll</button>
    <% end %>

    <% if @characters.size >= 2 %>
      <p class="field__hint">Characters at odds? <%= link_to "Start a quarrel", new_campaign_quarrel_path(Current.campaign) %>.</p>
    <% end %>
  </section>

  <section class="panel stack" aria-labelledby="campaign-table">
    <h2 id="campaign-table" class="panel__title">At the table</h2>
    <ul class="list">
      <% @memberships.each do |membership| %>
        <li class="list__item">
          <span>
            <strong><%= membership.identity.display_name %></strong>
            <small><%= membership.gm? ? "GM" : "Player" %><%= " · you" if membership == Current.membership %></small>
          </span>
          <% if membership == Current.membership && membership.player? %>
            <%= button_to "Leave", campaign_membership_path(Current.campaign, membership), method: :delete, class: "button button--quiet button--small", form: { data: { turbo_confirm: "Leave #{Current.campaign.name}?" } } %>
          <% elsif gm? && membership.player? %>
            <%= button_to "Remove", campaign_membership_path(Current.campaign, membership), method: :delete, class: "button button--quiet button--small", form: { data: { turbo_confirm: "Remove #{membership.identity.display_name}?" } } %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>

  <section class="panel stack" aria-labelledby="campaign-characters">
    <h2 id="campaign-characters" class="panel__title">Characters</h2>
    <% if @characters.any? %>
      <ul class="list">
        <% @characters.each do |character| %>
          <li class="list__item">
            <span>
              <%= link_to character.name, character_path(character) %>
              <small><%= character.path %> · level <%= character.level %> · <%= character.identity.display_name %></small>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="empty">No characters seated yet.</p>
    <% end %>
    <p><%= link_to "Add your character", new_character_path(campaign_id: Current.campaign.id), class: "button button--small" %></p>
  </section>

  <% if gm? %>
    <section class="panel stack" aria-labelledby="campaign-invite">
      <h2 id="campaign-invite" class="panel__title">Invite players</h2>
      <p class="field__hint">Anyone with this link can sign in and join as a player.</p>
      <%= render "campaigns/join_link", url: join_url(Current.campaign.join_code) %>
      <%= button_to "Make a new link", campaign_join_code_path(Current.campaign), method: :patch, class: "button button--quiet button--small", form: { data: { turbo_confirm: "The current link will stop working. Continue?" } } %>
    </section>

    <section class="panel stack" aria-labelledby="campaign-settings">
      <h2 id="campaign-settings" class="panel__title">Settings</h2>
      <%= form_with model: Current.campaign, class: "stack" do |form| %>
        <% if Current.campaign.errors.any? %>
          <p class="form-error"><%= Current.campaign.errors.full_messages.to_sentence %></p>
        <% end %>
        <div class="field">
          <%= form.label :name, "Campaign name", class: "field__label" %>
          <%= form.text_field :name, required: true, maxlength: 80, class: "field__input" %>
        </div>
        <%= form.submit "Rename", class: "button" %>
      <% end %>
      <%= button_to "Delete campaign", campaign_path(Current.campaign), method: :delete, class: "button button--danger button--small", form: { data: { turbo_confirm: "Delete #{Current.campaign.name} for everyone? This can't be undone." } } %>
    </section>
  <% end %>
</div>
