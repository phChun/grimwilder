<% content_for :title, Current.campaign.name %>
<% content_for :head do %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>
<%= turbo_stream_from Current.campaign, :pools %>
<%= turbo_stream_from Current.campaign, :table %>

<% campaign = Current.campaign %>
<% gm = gm? %>

<%# The campaign page reads like a series overview: what it's about, who's in it, what looms and what happened last time, with the table's chat beside it. It's for reading: players roll on their sheets (characters/_table_rolls), the GM at the GM table. %>
<% gms = @memberships.select(&:gm?).map { _1.identity.display_name } %>
<div class="fluid campaign-page" data-controller="details-memory" data-details-memory-campaign-value="<%= campaign.id %>" data-action="toggle->details-memory#toggled:capture turbo:morph@document->details-memory#restore">
  <div class="fluid__main campaign-page__main">
    <section class="campaign-hero" aria-labelledby="campaign-name">
      <p class="eyebrow">Campaign<% if campaign.archived? %> · Archived <%= l(campaign.archived_at.to_date, format: :long) %><% end %> · <%= gm ? "You're the GM" : "GM #{gms.to_sentence}" %><% if !gm && @mine %> · Playing <%= @mine_all.map(&:short_name).to_sentence %><% end %></p>
      <h1 id="campaign-name" class="campaign-hero__title"><%= campaign.name %></h1>
      <%# Campaign::Hold: the GM's plan runs fewer campaigns; chat and sheets go on. %>
      <% if campaign.on_hold? %>
        <p class="campaign-hero__hold"><span class="campaign-hero__hold-chip">On hold</span>
          <% if gm %>Your plan has <%= campaign.name %> on hold. Chat and sheets still work; <%= link_to "choose to play it", campaigns_path %> from the campaigns list.<% else %>Your GM's plan has this campaign on hold. Chat and sheets still work.<% end %>
        </p>
      <% end %>
      <% if campaign.pitch.present? %>
        <p class="campaign-hero__pitch"><%= campaign.pitch %></p>
      <% elsif gm %>
        <p class="campaign-hero__pitch campaign-hero__pitch--empty"><%= link_to "Add a one-line pitch", edit_campaign_path(campaign) %>, what the party is and never is, the group arc and the setting.</p>
      <% end %>
      <% if campaign.pitched? %>
        <dl class="campaign-hero__facts">
          <div><dt>The party is</dt><dd><%= campaign.party_is.join(", ").presence || "—" %></dd></div>
          <div><dt>Never</dt><dd><%= campaign.party_never || "—" %></dd></div>
          <div><dt>Group arc</dt><dd><%= campaign.group_arc.present? ? title_case(campaign.group_arc) : "—" %></dd></div>
          <div><dt>Setting</dt><dd><%= campaign.setting || "—" %></dd></div>
        </dl>
      <% end %>
      <%# The table's optional rules, one quiet line; each says what it does on hover or focus. %>
      <% if campaign.rules_in_play.any? %>
        <p class="campaign-hero__rules"><span class="campaign-hero__rules-label">Optional rules</span>
          <% campaign.rules_in_play.each do |rule_name, page, does| %>
            <span class="campaign-hero__rule" tabindex="0" data-tip="<%= does %> (pg. <%= page %>)"><%= rule_name %></span>
          <% end %>
        </p>
      <% end %>

      <%# What to do here: the GM's table, invite link and settings, or a player's character. Campaign::Archive: a read-only archive; the history is the way back in, and the GM unarchives it from settings. %>
      <div class="campaign-actions" aria-label="Campaign actions" role="group">
        <% if campaign.archived? %>
          <%= link_to "Read the history", campaign_play_sessions_path(campaign), class: "button button--primary" %>
          <% if gm %>
            <%= link_to "Unarchive it", edit_campaign_path(campaign, anchor: "archive"), class: "button" %>
          <% end %>
        <% elsif gm %>
          <% if campaign.on_hold? %>
            <%= link_to "Choose what to play", campaigns_path, class: "button button--primary" %>
          <% else %>
            <%= link_to "Open the GM table", campaign_table_path(campaign), class: "button button--primary" %>
          <% end %>
          <%= render "campaigns/copy_join_button", url: join_url(campaign.join_code) %>
        <% elsif @mine_all.many? %>
          <%# More than one character here: the button opens a menu of their sheets. %>
          <details id="open-character" class="go-menu" data-controller="menu" data-action="toggle->menu#place">
            <summary class="button button--primary go-menu__button">Open my character <%= icon(:chevron, size: 16) %></summary>
            <ul class="go-menu__list" data-menu-target="panel">
              <%= render "shared/popover_head", title: "Open which character?", list: true %>
              <% @mine_all.each do |character| %>
                <li>
                  <%= link_to character_path(character), class: "go-menu__item" do %>
                    <span class="go-menu__name"><%= character.name %></span>
                    <span class="go-menu__meta"><%= character.path %> · level <%= character.level %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </details>
        <% elsif @mine %>
          <%= link_to "Open my character", character_path(@mine), class: "button button--primary" %>
        <% elsif campaign.makes_characters?(Current.identity) %>
          <%= link_to "Make your character", new_character_path(campaign_id: campaign.id), class: "button button--primary" %>
        <% else %>
          <span class="field__hint">The GM makes the characters here: pick one up for grabs.</span>
        <% end %>
        <% if gm %>
          <%= link_to "Campaign settings", edit_campaign_path(campaign), class: "button campaign-actions__end" %>
        <% else %>
          <%= button_to "Leave campaign", campaign_membership_path(campaign, Current.membership), method: :delete, class: "button button--ghost", form: { class: "campaign-actions__end", data: { turbo_confirm: "Leave #{campaign.name}? Your characters stay yours, unseated." } } %>
        <% end %>
      </div>
      <% if campaign.archived? %>
        <p class="campaign-actions__hint"><em class="campaign-actions__done">The story's told.</em> Everything here stays to look back on.<% if @mine %> Playing somewhere new? Move <%= @mine_all.map(&:short_name).to_sentence %> from <%= link_to "Edit sheet", edit_character_path(@mine, anchor: "at-the-table") %>.<% end %></p>
      <% elsif !gm && !@mine %>
        <p class="campaign-actions__hint">Seat them in <%= campaign.name %> and they'll join the party.<% if @up_for_grabs.any? %> Or <a href="#up-for-grabs">pick one that's up for grabs</a>.<% end %></p>
      <% end %>
    </section>

      <section id="party" class="gm-section" aria-labelledby="party-title">
        <div class="gm-section__head">
          <h2 id="party-title" class="gm-section__title">The party</h2>
        </div>
        <div class="party-grid party-grid--wide">
          <% table_seats(@memberships, @party).each do |membership, seated| %>
            <% if seated.empty? %>
              <div class="hero-card hero-card--empty">
                <div class="hero-card__who">
                  <span class="monogram monogram--44 monogram--empty" aria-hidden="true"><%= initial(membership.identity.display_name) %></span>
                  <div>
                    <p class="hero-card__name"><%= membership.identity.display_name %> joined</p>
                    <p class="hero-card__meta">Still making a character</p>
                  </div>
                </div>
              </div>
            <% end %>
            <% seated.each do |character| %>
              <article class="hero-card">
                <div class="hero-card__who">
                  <span class="monogram monogram--44" aria-hidden="true"><%= initial(character.short_name) %></span>
                  <div class="hero-card__titles">
                    <%= link_to character.short_name, character_path(character), class: "hero-card__name", title: character.name %>
                    <p class="hero-card__meta"><%= character.path %> <%= character.level %> · played by <%= membership.identity.display_name %></p>
                  </div>
                  <%= render "shared/pips", kind: "spark", value: character.spark, max: Grimwild::MAX_SPARK %>
                </div>
                <div class="stat-tiles">
                  <% Grimwild::STATS.each do |stat| %>
                    <% marked = character.marked?(stat) %>
                    <div class="<%= class_names("stat-tile", "stat-tile--marked": marked) %>">
                      <span class="stat-tile__value"><%= character.stat(stat) %></span>
                      <span class="stat-tile__name"><abbr title="<%= stat.capitalize %><%= " (marked)" if marked %>"><%= stat.first(3).upcase %></abbr><% if marked %> <span aria-hidden="true">✕</span><span class="visually-hidden">marked</span><% end %></span>
                    </div>
                  <% end %>
                </div>
                <p class="<%= class_names("hero-card__harm", "hero-card__harm--none": harm_line(character).nil?) %>"><%= harm_line(character) || "No harm" %></p>
                <% if gm %>
                  <%= button_to "Put up for grabs", character_claim_path(character), method: :delete, class: "button button--ghost button--small hero-card__release", form: { data: { turbo_confirm: "#{character.name} goes back to you, for any player to pick. Continue?" } } %>
                <% end %>
              </article>
            <% end %>
          <% end %>
          <%# The last card makes a character for the table, up for grabs until a player picks it. %>
          <% if gm && !campaign.archived? %>
            <%= link_to new_character_path(campaign_id: campaign.id, up_for_grabs: 1), class: "hero-card hero-card--empty add-card--link" do %>
              <span class="hero-card__name">Create new character</span>
              <span class="hero-card__meta">For the table: up for grabs until a player picks it</span>
            <% end %>
          <% end %>
        </div>
        <% if @up_for_grabs.any? %>
          <div id="up-for-grabs" class="grabs">
            <h3 class="grabs__title">Up for grabs</h3>
            <p class="grabs__hint"><%= gm ? "Waiting for a player to pick. You hold them until then." : "Made by the GM, or given back. Pick one to play it: it becomes yours." %></p>
            <ul class="grabs__list">
              <% @up_for_grabs.each do |character| %>
                <li class="grabs__item">
                  <span class="monogram monogram--44 monogram--empty" aria-hidden="true"><%= initial(character.short_name) %></span>
                  <div class="grabs__who">
                    <%= link_to character.name, character_path(character), class: "grabs__name" %>
                    <span class="grabs__meta"><%= character.path %> <%= character.level %></span>
                  </div>
                  <% unless gm %>
                    <%= button_to "Play #{character.short_name}", character_claim_path(character), class: "button button--small button--primary" %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <%# Characters whose story ended (Character::Farewell), remembered under the party. %>
        <% if @gone.any? %>
          <div id="fallen-and-retired" class="farewells">
            <h3 class="farewells__title">Fallen or retired</h3>
            <div class="farewells__list">
              <% @gone.sort_by { _1.status_changed_at || _1.updated_at }.reverse_each do |character| %>
                <%= render "characters/farewell_card", character: character, player: true %>
              <% end %>
            </div>
          </div>
        <% end %>
      </section>

      <%# What looms: the shared pools as tracks, for reading. Players roll them on their sheets; the GM at the GM table. %>
      <section id="pools" class="gm-section" aria-labelledby="pools-title">
        <div class="gm-section__head">
          <h2 id="pools-title" class="gm-section__title">What looms</h2>
          <% if gm && !campaign.archived? %>
            <%= link_to "Pools at the table", campaign_table_path(campaign, anchor: "pools"), class: "button button--ghost button--small" %>
          <% elsif @mine && !campaign.archived? %>
            <%= link_to "Roll from your sheet", character_path(@mine, anchor: "table-rolls"), class: "button button--ghost button--small" %>
          <% end %>
        </div>
        <% shown = @pools.reject(&:hidden?) %>
        <% if shown.any? %>
          <div class="looms">
            <% shown.each do |pool| %>
              <div class="pool-glance card">
                <div class="pool-glance__head"><span><%= pool.name %></span><span class="pool-glance__size"><%= pool.size %>d</span></div>
                <%= render "shared/pool_track", pool: pool %>
                <span class="pool-glance__kind"><%= pool.kind.capitalize %> pool</span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="empty"><%= gm ? "No pools showing." : "Nothing yet. Your GM adds pools as the story needs." %></p>
        <% end %>
        <% if gm && @hidden_pools.positive? %>
          <p class="pool-glance__hidden"><%= icon(:eye_off) %> <%= pluralize(@hidden_pools, "hidden pool") %>, only you see <%= @hidden_pools == 1 ? "it" : "them" %></p>
        <% end %>
      </section>

      <section id="previously" class="gm-section" aria-labelledby="previously-title">
        <h2 id="previously-title" class="gm-section__title">Previously on…</h2>
        <% if @previous %>
          <article class="previously">
            <div class="previously__session">
              <p class="previously__meta"><%= session_date(@previous) %> · <%= session_counts(@previous) %></p>
              <h3 class="previously__title"><%= link_to @previous.title, campaign_play_session_path(campaign, @previous) %></h3>
              <% if @previous.recap.present? %><p class="previously__recap"><%= @previous.recap %></p><% end %>
              <% if @previous.scenes.any? %>
                <ol class="previously__scenes">
                  <% @previous.scenes.ordered.each do |scene| %>
                    <li>
                      <span class="previously__number"><%= scene.number %></span>
                      <span class="previously__scene"><%= scene.title %></span>
                      <span class="previously__outcome"><%= scene_outcome(scene) %></span>
                    </li>
                  <% end %>
                </ol>
              <% end %>
            </div>
          </article>

          <ol class="older-sessions">
            <% @older.each do |session| %>
              <li>
                <%= link_to campaign_play_session_path(campaign, session), class: "older-sessions__link" do %>
                  <span class="older-sessions__number">S<%= session.number %></span>
                  <span class="older-sessions__title"><%= session.recap.to_s.truncate(60, separator: " ").presence || session.title %></span>
                  <span class="older-sessions__meta"><%= session.started_at.strftime("%b %-d") %> · <%= pluralize(session.scenes.size, "scene") %></span>
                <% end %>
              </li>
            <% end %>
            <li><%= link_to "All #{pluralize(@session_count, "session")}", campaign_play_sessions_path(campaign), class: "older-sessions__all" %></li>
          </ol>
        <% else %>
          <p class="empty"><%= @session ? "#{@session.title} is the first. Its story shows here once it ends." : "No sessions yet." %> <%= link_to "Session history", campaign_play_sessions_path(campaign) %></p>
        <% end %>
      </section>

      <%= render "campaigns/kept_crucibles" %>
    </div>

    <%= render "campaigns/table_rail", campaign: campaign, membership: Current.membership, feed: @feed, speakers: (gm ? [] : @my_characters.select(&:active?)), suspense: true, classes: "fluid__rail" %>
</div>
