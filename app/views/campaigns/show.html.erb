<% content_for :title, Current.campaign.name %>
<% content_for :head do %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>
<%= turbo_stream_from Current.campaign, :pools %>
<%= turbo_stream_from Current.campaign, :table %>

<% seats = table_seats(@memberships, @characters) %>
<% alert = table_alert(@characters) %>
<% latest = @rolls.first %>
<% first_crucible = @crucible_groups.first.last.first %>

<div class="gm-table" data-controller="details-memory" data-details-memory-campaign-value="<%= Current.campaign.id %>" data-action="toggle->details-memory#toggled:capture turbo:morph@document->details-memory#restore">
  <header class="gm-table__header">
    <div class="gm-table__heading">
      <p class="eyebrow"><%= gm? ? "You're the GM" : "You're a player" %></p>
      <h1 class="gm-table__name"><%= Current.campaign.name %></h1>
      <%= render "campaigns/session_bar", campaign: Current.campaign, session: @session, gm: gm? %>
    </div>
    <div class="gm-table__tools">
      <% if gm? %><%= render "campaigns/copy_join_button", url: join_url(Current.campaign.join_code) %><% end %>
      <a href="#settings" class="button button--small gm-table__icon" aria-label="Invite and settings" title="Invite and settings" data-action="details-memory#jump">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"></path></svg>
      </a>
    </div>
  </header>

  <%# The GM can write anyone's moment from the session page; here, only your own characters prompt you. %>
  <% if @session && (writable = @session.characters_needing_moments(Current.identity).select { _1.owned_by?(Current.identity) }).any? %>
    <details id="moment-prompt" class="fold fold--panel moment-prompt" open data-details-memory-target="section" data-section="moments-<%= @session.id %>" data-phone-open="true">
      <summary class="fold__summary"><span class="fold__title">Best moment from last session</span><span class="fold__meta">close to dismiss</span></summary>
      <p class="field__hint">Recall last session and share your character's best moment (pg. 31).</p>
      <%= render "campaigns/play_sessions/moment_form", session: @session, characters: writable %>
    </details>
  <% end %>

  <nav class="gm-table__tabs" aria-label="Sections">
    <a href="#pools" class="gm-table__tab" data-action="details-memory#jump">Pools</a>
    <a href="#crucibles" class="gm-table__tab" data-action="details-memory#jump">Crucibles</a>
    <a href="#table" class="gm-table__tab" data-action="details-memory#jump">Table</a>
    <a href="#roll-log" class="gm-table__tab" data-action="details-memory#jump">Log</a>
  </nav>

  <div class="gm-table__columns">
    <div class="gm-table__column gm-table__column--side">
      <details id="table" class="fold fold--panel gm-table__seats" open data-details-memory-target="section" data-section="table">
        <summary class="fold__summary">
          <span class="fold__title">At the table</span>
          <span class="fold__meta fold__meta--wide"><%= pluralize(seats.count { _1.first.player? }, "player") %></span>
          <% if alert %><span class="status-chip status-chip--harm fold__meta--phone"><%= alert %></span><% end %>
        </summary>
        <ul class="seats">
          <% seats.each do |membership, seated| %>
            <% if seated.empty? %>
              <li class="seat">
                <div class="seat__line">
                  <span class="seat__name seat__name--empty"><%= membership.identity.display_name %></span>
                  <span class="seat__meta">no character yet</span>
                </div>
              </li>
            <% end %>
            <% seated.each do |character| %>
              <li class="seat">
                <div class="seat__line">
                  <%= link_to character.name, character_path(character), class: "seat__name" %>
                  <span class="seat__meta"><%= character.path %> <%= character.level %> · <%= membership.identity.display_name %></span>
                  <%= spark_dots(character) %>
                </div>
                <% chips = character_chips(character) %>
                <% if chips.present? %><div class="seat__chips"><%= chips %></div><% end %>
                <% uses = talent_use_summary(character) %>
                <% if uses.present? %><p class="seat__uses"><%= uses %></p><% end %>
                <% if (pools = @talent_pools[character.id]) %>
                  <ul class="seat__pools">
                    <% pools.each do |pool| %>
                      <li class="<%= class_names("seat-pool", "pool--#{pool.kind}") %>">
                        <span class="seat-pool__name"><%= pool.name.delete_prefix("#{character.name}: ") %></span>
                        <span class="seat-pool__size"><%= pool.size %>d</span>
                        <% if pool.rollable? %>
                          <%= button_to "Roll", campaign_pool_roll_path(Current.campaign, pool), class: "button button--small", "aria-label": "Roll #{pool.name}" %>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                <% end %>
              </li>
            <% end %>
          <% end %>
        </ul>
        <p class="fold__footer"><%= link_to "Add your character", new_character_path(campaign_id: Current.campaign.id) %></p>
      </details>

      <details id="roll-log" class="fold fold--panel gm-table__log" open data-details-memory-target="section" data-section="log">
        <summary class="fold__summary">
          <span class="fold__title">Roll log</span>
          <span class="live fold__meta--wide"><span class="live__dot" aria-hidden="true"></span>Live</span>
          <% if latest %>
            <span class="fold__meta fold__meta--phone fold__meta--fill"><%= roll_headline(latest) %></span>
            <% if latest.outcome %><span class="<%= class_names("result-badge", "result-badge--#{latest.outcome}", "fold__meta--phone") %>"><%= latest.outcome.capitalize %></span><% end %>
          <% end %>
        </summary>
        <%= render "rolls/log", campaign: Current.campaign, membership: Current.membership, rolls: @rolls %>
        <%= form_with url: campaign_notes_path(Current.campaign), class: "inline-form log-note-form" do %>
          <input type="text" name="text" required maxlength="200" autocomplete="off" placeholder="Tibbs enters a frenzy…" class="field__input" aria-label="Add a note to the log">
          <button type="submit" class="button button--small">Note</button>
        <% end %>
      </details>

      <%= tag.details id: "settings", class: "fold fold--panel gm-table__settings", open: Current.campaign.errors.any?, data: { details_memory_target: "section", section: "settings" } do %>
        <summary class="fold__summary"><span class="fold__title">Invite &amp; settings</span></summary>
        <div class="fold__body stack">
          <%= render "campaigns/settings", memberships: @memberships, gm: gm? %>
        </div>
      <% end %>
    </div>

    <div class="gm-table__column gm-table__column--main">
      <details id="pools" class="fold fold--panel gm-table__pools" open data-details-memory-target="section" data-section="pools" data-phone-open="true">
        <summary class="fold__summary">
          <span class="fold__title">Pools</span>
          <span class="fold__meta"><%= @pools.size %></span>
          <span class="fold__meta fold__meta--wide">Everyone sees rolls live</span>
        </summary>
        <div class="pool-rows">
          <% @pools.each do |pool| %>
            <%= render "campaigns/pools/pool", pool: pool, my_characters: @my_characters, gm: gm? %>
          <% end %>
        </div>
        <% if @pools.none? %>
          <p class="empty"><%= gm? ? "No pools yet. Add one when the story needs a clock." : "No pools yet. Your GM adds them as the story needs." %></p>
        <% end %>
        <% if gm? %>
          <%= tag.details id: "pool-new", class: "fold pool-add", open: @pool.errors.any? do %>
            <summary class="fold__summary pool-add__summary"><span class="fold__title">+ Add pool</span></summary>
            <%= render "campaigns/pools/form", pool: @pool %>
          <% end %>
        <% end %>
      </details>

      <details id="story-roll" class="fold fold--panel gm-table__story" data-details-memory-target="section" data-section="story">
        <summary class="fold__summary">
          <span class="fold__title">Story roll</span>
          <span class="fold__meta">montage · quarrel</span>
        </summary>
        <div class="fold__body">
          <%= render "campaigns/story_roll", characters: @characters, my_characters: @my_characters %>
        </div>
      </details>
    </div>

    <div class="gm-table__column gm-table__column--tools">
      <details id="crucibles" class="fold fold--panel gm-table__crucibles" open data-details-memory-target="section" data-section="crucibles" data-turbo-permanent>
        <summary class="fold__summary">
          <span class="fold__title">Crucibles</span>
          <span class="fold__meta" data-crucible-picker-target="current"><%= first_crucible.name %></span>
        </summary>
        <div class="fold__body crucible-picker" data-controller="crucible-picker" data-crucible-picker-url-value="<%= crucible_path("__key__", embed: 1) %>">
          <div class="crucible-picker__choose">
            <label class="visually-hidden" for="crucible-pick">Crucible</label>
            <select id="crucible-pick" class="field__input" data-crucible-picker-target="select" data-action="crucible-picker#pick">
              <% @crucible_groups.each do |group, crucibles| %>
                <optgroup label="<%= Crucible::GROUPS.fetch(group) %>">
                  <% crucibles.each do |crucible| %>
                    <option value="<%= crucible.key %>"><%= crucible.name %></option>
                  <% end %>
                </optgroup>
              <% end %>
            </select>
          </div>
          <p class="crucible-picker__recent" data-crucible-picker-target="recent" hidden></p>
          <%= turbo_frame_tag "crucible", src: crucible_path(first_crucible, embed: 1), data: { crucible_picker_target: "frame" } do %>
            <p class="crucible__hint">Loading <%= first_crucible.name %>…</p>
          <% end %>
        </div>
      </details>
    </div>
  </div>
</div>
