<% content_for :title, Current.campaign.name %>
<% content_for :head do %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>
<%= turbo_stream_from Current.campaign, :pools %>
<%= turbo_stream_from Current.campaign, :table %>

<% campaign = Current.campaign %>
<% gm = gm? %>

<%# The campaign page reads like a series overview: who's in it, what it's about, what happened last time. Players also roll pools and story rolls here, and follow the log. %>
<div class="campaign-page" data-controller="details-memory" data-details-memory-campaign-value="<%= campaign.id %>" data-action="toggle->details-memory#toggled:capture turbo:morph@document->details-memory#restore">
  <section class="campaign-hero" aria-labelledby="campaign-name">
    <div class="campaign-hero__about">
      <p class="eyebrow">Campaign · <%= gm ? "You're the GM" : (@mine ? "Playing #{@mine.short_name}" : "You're a player") %></p>
      <h1 id="campaign-name" class="campaign-hero__title"><%= campaign.name %></h1>
      <% if campaign.pitch.present? %>
        <p class="campaign-hero__pitch"><%= campaign.pitch %></p>
      <% elsif gm %>
        <p class="campaign-hero__pitch campaign-hero__pitch--empty"><%= link_to "Add a one-line pitch", edit_campaign_path(campaign) %>, what the party is and never is, the group arc and the setting.</p>
      <% end %>
      <% if campaign.pitched? %>
        <dl class="campaign-hero__facts">
          <div><dt>The party is</dt><dd><%= campaign.party_is.join(", ").presence || "—" %></dd></div>
          <div><dt>Never</dt><dd><%= campaign.party_never || "—" %></dd></div>
          <div><dt>Group arc</dt><dd><%= campaign.group_arc&.capitalize || "—" %></dd></div>
          <div><dt>Setting</dt><dd><%= campaign.setting || "—" %></dd></div>
        </dl>
      <% end %>
    </div>

    <div class="card campaign-hero__action">
      <% if gm %>
        <%= link_to "Open the GM table", campaign_table_path(campaign), class: "button button--primary campaign-hero__go" %>
        <%= render "campaigns/copy_join_button", url: join_url(campaign.join_code) %>
        <p class="campaign-hero__hint">
          Anyone with the link joins as a player and goes straight to making a character.
          <%= button_to "Reset link", campaign_join_code_path(campaign), method: :patch, class: "link-button", form: { class: "inline-button", data: { turbo_confirm: "The current link will stop working. Continue?" } } %>
        </p>
      <% elsif @mine %>
        <%= link_to "Open my character", character_path(@mine), class: "button button--primary campaign-hero__go" %>
      <% else %>
        <%= link_to "Make your character", new_character_path(campaign_id: campaign.id), class: "button button--primary campaign-hero__go" %>
        <p class="campaign-hero__hint">Seat them in <%= campaign.name %> and they'll join the party.</p>
      <% end %>
    </div>
  </section>

  <% if @session && (writable = @session.characters_needing_moments(Current.identity).select { _1.owned_by?(Current.identity) }).any? %>
    <details id="moment-prompt" class="card moment-prompt" open data-details-memory-target="section" data-section="moments-<%= @session.id %>" data-phone-open="true">
      <summary class="fold__summary"><span class="fold__title">Best moment from last session</span><span class="fold__meta">close to dismiss</span></summary>
      <p class="field__hint">Recall last session and share your character's best moment (pg. 31).</p>
      <%= render "campaigns/play_sessions/moment_form", session: @session, characters: writable %>
    </details>
  <% end %>

  <div class="fluid">
    <div class="fluid__main campaign-page__main">
      <section id="party" class="gm-section" aria-labelledby="party-title">
        <div class="gm-section__head">
          <h2 id="party-title" class="gm-section__title">The party</h2>
        </div>
        <div class="party-grid party-grid--wide">
          <% table_seats(@memberships, @party).each do |membership, seated| %>
            <% if seated.empty? %>
              <div class="hero-card hero-card--empty">
                <div class="hero-card__who">
                  <span class="monogram monogram--44 monogram--empty" aria-hidden="true"><%= initial(membership.identity.display_name) %></span>
                  <div>
                    <p class="hero-card__name"><%= membership.identity.display_name %> joined</p>
                    <p class="hero-card__meta">Still making a character</p>
                  </div>
                </div>
              </div>
            <% end %>
            <% seated.each do |character| %>
              <article class="hero-card">
                <div class="hero-card__who">
                  <span class="monogram monogram--44" aria-hidden="true"><%= initial(character.short_name) %></span>
                  <div class="hero-card__titles">
                    <%= link_to character.short_name, character_path(character), class: "hero-card__name", title: character.name %>
                    <p class="hero-card__meta"><%= character.path %> <%= character.level %> · played by <%= membership.identity.display_name %></p>
                  </div>
                  <%= render "shared/pips", kind: "spark", value: character.spark, max: Grimwild::MAX_SPARK %>
                </div>
                <div class="stat-tiles">
                  <% Grimwild::STATS.each do |stat| %>
                    <% marked = character.marked?(stat) %>
                    <div class="<%= class_names("stat-tile", "stat-tile--marked": marked) %>">
                      <span class="stat-tile__value"><%= character.stat(stat) %></span>
                      <span class="stat-tile__name"><abbr title="<%= stat.capitalize %><%= " (marked)" if marked %>"><%= stat.first(3).upcase %></abbr><% if marked %> <span aria-hidden="true">✕</span><span class="visually-hidden">marked</span><% end %></span>
                    </div>
                  <% end %>
                </div>
                <p class="<%= class_names("hero-card__harm", "hero-card__harm--none": harm_line(character).nil?) %>"><%= harm_line(character) || "No harm" %></p>
              </article>
            <% end %>
          <% end %>
        </div>
        <% if @gone.any? %>
          <p class="party-gone">
            Fallen and retired:
            <% @gone.each_with_index do |character, index| %><%= " · " if index.positive? %><%= link_to character.name, character_path(character) %>, <%= gone_line(character) %><% end %>
          </p>
        <% end %>
      </section>

      <section id="previously" class="gm-section" aria-labelledby="previously-title">
        <h2 id="previously-title" class="gm-section__title">Previously on…</h2>
        <% if @previous %>
          <article class="previously">
            <div class="previously__session">
              <p class="previously__meta"><%= session_date(@previous) %> · <%= session_counts(@previous) %></p>
              <h3 class="previously__title"><%= link_to @previous.title, campaign_play_session_path(campaign, @previous) %></h3>
              <% if @previous.recap.present? %><p class="previously__recap"><%= @previous.recap %></p><% end %>
              <% if @previous.scenes.any? %>
                <ol class="previously__scenes">
                  <% @previous.scenes.ordered.each do |scene| %>
                    <li>
                      <span class="previously__number"><%= scene.number %></span>
                      <span class="previously__scene"><%= scene.title %></span>
                      <span class="previously__outcome"><%= scene_outcome(scene) %></span>
                    </li>
                  <% end %>
                </ol>
              <% end %>
            </div>
            <% if (moment = @previous.moments_about.first) %>
              <div class="previously__moment">
                <p class="previously__label">Best moment</p>
                <blockquote class="previously__quote"><%= moment.text %></blockquote>
                <p class="previously__by"><%= moment.character.short_name %> · written by <%= moment.identity.display_name %></p>
              </div>
            <% end %>
          </article>

          <ol class="older-sessions">
            <% @older.each do |session| %>
              <li>
                <%= link_to campaign_play_session_path(campaign, session), class: "older-sessions__link" do %>
                  <span class="older-sessions__number">S<%= session.number %></span>
                  <span class="older-sessions__title"><%= session.recap.to_s.truncate(60, separator: " ").presence || session.title %></span>
                  <span class="older-sessions__meta"><%= session.started_at.strftime("%b %-d") %> · <%= pluralize(session.scenes.size, "scene") %></span>
                <% end %>
              </li>
            <% end %>
            <li><%= link_to "All #{pluralize(@session_count, "session")}", campaign_play_sessions_path(campaign), class: "older-sessions__all" %></li>
          </ol>
        <% else %>
          <p class="empty"><%= @session ? "#{@session.title} is the first. Its story shows here once it ends." : "No sessions yet." %> <%= link_to "Session history", campaign_play_sessions_path(campaign) %></p>
        <% end %>
      </section>
    </div>

    <aside class="fluid__rail campaign-page__side" aria-label="The table at a glance">
      <section id="pools" class="card side-card" aria-labelledby="pools-title">
        <h2 id="pools-title" class="side-card__title">Hanging over them</h2>
        <% shown = @pools.reject(&:hidden?) %>
        <% if gm %>
          <% shown.each do |pool| %>
            <div class="pool-glance">
              <div class="pool-glance__head"><span><%= pool.name %></span><span class="pool-glance__size"><%= pool.size %>d</span></div>
              <%= render "shared/pool_track", pool: pool %>
            </div>
          <% end %>
          <% if @hidden_pools.positive? %>
            <p class="pool-glance__hidden"><%= icon(:eye_off) %> <%= pluralize(@hidden_pools, "hidden pool") %>, only you see <%= @hidden_pools == 1 ? "it" : "them" %></p>
          <% end %>
          <% if @pools.none? %><p class="empty">No pools yet. Add them at the <%= link_to "GM table", campaign_table_path(campaign, anchor: "pools") %>.</p><% end %>
        <% else %>
          <div class="pool-rows">
            <% shown.each do |pool| %>
              <%= render "campaigns/pools/pool", pool: pool, my_characters: @my_characters, gm: false %>
            <% end %>
          </div>
          <% if shown.none? %><p class="empty">Nothing yet. Your GM adds pools as the story needs.</p><% end %>
        <% end %>
      </section>

      <% unless gm %>
        <details id="story-roll" class="card side-card" data-details-memory-target="section" data-section="story">
          <summary class="gm-fold__summary"><span class="side-card__title">Story roll</span></summary>
          <%= render "campaigns/story_roll", characters: @characters, my_characters: @my_characters %>
        </details>
      <% end %>

      <section class="card side-card" aria-labelledby="members-title">
        <h2 id="members-title" class="side-card__title">At the table</h2>
        <ul class="members">
          <% @memberships.each do |membership| %>
            <li class="members__item">
              <span class="monogram monogram--28" aria-hidden="true"><%= initial(membership.identity.display_name) %></span>
              <span class="members__name"><%= membership.identity.display_name %></span>
              <span class="<%= class_names("members__role", "members__role--gm": membership.gm?) %>"><%= member_role(membership, @characters) %></span>
            </li>
          <% end %>
        </ul>
        <%= link_to "Campaign settings", edit_campaign_path(campaign) %>
      </section>

      <section class="card side-card" aria-labelledby="kept-title" data-controller="kept-crucibles" hidden>
        <h2 id="kept-title" class="side-card__title">Kept crucibles</h2>
        <p class="kept-line" data-kept-crucibles-target="line"></p>
        <p class="side-card__note">Kept on this device, from the <%= link_to "crucibles", crucibles_path %>.</p>
      </section>

      <% unless gm %>
        <div class="table-rail">
          <div class="table-rail__head">
            <h2 class="table-rail__title">The table</h2>
            <%= render "campaigns/suspense_meter", campaign: campaign %>
          </div>
          <details id="roll-log" class="table-rail__section" open data-details-memory-target="section" data-section="log">
            <summary class="table-rail__summary">
              <span>Roll log</span>
              <span class="live"><span class="live__dot" aria-hidden="true"></span>Live</span>
            </summary>
            <div class="play-view__scroll">
              <%= render "rolls/log", campaign: campaign, membership: Current.membership, rolls: @rolls %>
            </div>
            <%= form_with url: campaign_notes_path(campaign), class: "inline-form log-note-form" do %>
              <input type="text" name="text" required maxlength="200" autocomplete="off" placeholder="Tibbs enters a frenzy…" class="field__input" aria-label="Add a note to the log">
              <button type="submit" class="button button--small">Note</button>
            <% end %>
          </details>
          <details id="chat" class="table-rail__section" open data-details-memory-target="section" data-section="chat">
            <summary class="table-rail__summary">
              <span>Chat</span>
              <span class="live"><span class="live__dot" aria-hidden="true"></span>Live</span>
            </summary>
            <%= render "messages/chat", campaign: campaign, messages: @messages, speakers: @my_characters, speaker: nil %>
          </details>
          <p class="table-rail__links"><%= link_to "Montage", new_campaign_montage_path(campaign) %> · <%= link_to "Quarrel", new_campaign_quarrel_path(campaign) %></p>
        </div>
      <% end %>
    </aside>
  </div>
</div>
