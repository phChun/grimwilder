<%# locals: (memberships:, blocks:, gm:) %>
<% if gm && !Current.campaign.archived? %>
  <div class="stack">
    <h3 class="fold__heading">Invite players</h3>
    <p class="field__hint">Anyone with this link can sign in and join as a player.</p>
    <%= render "campaigns/join_link", url: join_url(Current.campaign.join_code) %>
    <%= button_to "Make a new link", campaign_join_code_path(Current.campaign), method: :patch, class: "button button--quiet button--small", form: { data: { turbo_confirm: "The current link will stop working. Continue?" } } %>
  </div>
<% end %>

<div class="stack">
  <h3 class="fold__heading">Who's here</h3>
  <ul class="list">
    <% memberships.each do |membership| %>
      <li class="list__item">
        <span>
          <strong><%= membership.identity.display_name %></strong>
          <small><%= membership.gm? ? "GM" : "Player" %><%= " · you" if membership == Current.membership %></small>
        </span>
        <% if gm && membership.player? %>
          <%# Remove: the invite link still lets them back. Block: removed, and kept out (Campaign::Blocking). %>
          <span class="list__actions">
            <%= button_to "Remove", campaign_membership_path(Current.campaign, membership), method: :delete, class: "button button--quiet button--small", form: { data: { turbo_confirm: "Remove #{membership.identity.display_name}? They can join again with the invite link." } } %>
            <%= button_to "Block", campaign_blocks_path(Current.campaign), params: { membership_id: membership.id }, class: "button button--quiet button--danger-text button--small", form: { data: { turbo_confirm: "Block #{membership.identity.display_name}? They're removed, and the invite link won't let them back in until you unblock them." } } %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
  <% if gm && blocks.any? %>
    <h3 class="fold__heading">Blocked</h3>
    <ul class="list">
      <% blocks.each do |block| %>
        <li class="list__item">
          <span>
            <strong><%= block.identity.display_name %></strong>
            <small>since <%= l(block.created_at.to_date, format: :long) %></small>
          </span>
          <%= button_to "Unblock", campaign_block_path(Current.campaign, block), method: :delete, class: "button button--quiet button--small" %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>

<%# Campaign::Archive: read-only, and it frees everyone for another campaign. %>
<% if gm %>
  <div id="archive" class="stack">
    <h3 class="fold__heading">Archive</h3>
    <% if Current.campaign.archived? %>
      <p class="field__hint">Archived since <%= l(Current.campaign.archived_at.to_date, format: :long) %>. Unarchiving makes it everyone's active campaign again, so it can't while someone here is at another one.</p>
      <%= button_to "Unarchive #{Current.campaign.name}", campaign_archive_path(Current.campaign), method: :delete, class: "button button--small" %>
    <% else %>
      <p class="field__hint">When the story's told: the campaign stays to read (its page, history, log and sheets), but nothing new is played, and everyone's free to start or join another.<%= " End the session first." if Current.campaign.current_session %></p>
      <%= button_to "Archive #{Current.campaign.name}", campaign_archive_path(Current.campaign), class: "button button--small", disabled: Current.campaign.current_session.present?, form: { data: { turbo_confirm: archive_confirmation(Current.campaign) } } %>
    <% end %>
  </div>

  <% unless Current.campaign.archived? %>
    <%# Campaign::Reset: start play over, keeping the chat. %>
    <div class="stack">
      <h3 class="fold__heading">Reset</h3>
      <p class="field__hint">Clears every session and scene and the whole roll log, so play starts again at Session 1. Chat stays, and so do pools, suspense and the characters with their XP.</p>
      <%= button_to "Reset #{Current.campaign.name}", campaign_reset_path(Current.campaign), class: "button button--danger button--small", form: { data: { turbo_confirm: "Reset #{Current.campaign.name}? Every session and the whole roll log are deleted for everyone. Chat stays. This can't be undone." } } %>
    </div>
  <% end %>

  <div class="stack">
    <h3 class="fold__heading">Delete</h3>
    <%= button_to "Delete campaign", campaign_path(Current.campaign), method: :delete, class: "button button--danger button--small", form: { data: { turbo_confirm: "Delete #{Current.campaign.name} for everyone? This can't be undone." } } %>
  </div>
<% end %>
