<%# locals: (pool:) %>
<%# herb:slots client %>
<%# herb:state (new_size: 4) %>
<%= form_with model: [ Current.campaign, pool ], class: "stack pool-form" do |form| %>
  <% if pool.errors.any? %>
    <p class="form-error"><%= pool.errors.full_messages.to_sentence %></p>
  <% end %>

  <div class="field">
    <%= form.label :name, "Name", class: "field__label" %>
    <%= form.text_field :name, required: true, maxlength: 80, autocomplete: "off", placeholder: "Lookouts spot you", class: "field__input" %>
  </div>

  <div class="field">
    <%= form.label :kind, "Type", class: "field__label" %>
    <%= form.select :kind, Pool::LABELS.invert, {}, class: "field__input" %>
  </div>

  <div class="field">
    <label class="field__label" for="pool_starting_size">Dice</label>
    <%# The presets are radios bound to new_size, so the chosen one shows like any button group, and typing a size lights its preset. Written out, not looped: herb:state compares only against literals. %>
    <div class="size-picker">
      <fieldset class="segmented segmented--auto size-picker__presets">
        <legend class="visually-hidden">Common sizes</legend>
        <label class="segmented__option"><input type="radio" name="pool_size_preset" value="2" checked="<%= new_size == 2 %>" data-herb-set="change->new_size=2"><span>2d <small>short</small></span></label>
        <label class="segmented__option"><input type="radio" name="pool_size_preset" value="4" checked="<%= new_size == 4 %>" data-herb-set="change->new_size=4"><span>4d <small>medium</small></span></label>
        <label class="segmented__option"><input type="radio" name="pool_size_preset" value="6" checked="<%= new_size == 6 %>" data-herb-set="change->new_size=6"><span>6d</span></label>
        <label class="segmented__option"><input type="radio" name="pool_size_preset" value="8" checked="<%= new_size == 8 %>" data-herb-set="change->new_size=8"><span>8d <small>long</small></span></label>
      </fieldset>
      <label class="visually-hidden" for="pool_starting_size">Dice</label>
      <input type="number" id="pool_starting_size" name="pool[starting_size]" class="field__input size-picker__input" min="1" max="<%= Pool::MAX_SIZE %>" step="1" required autocomplete="off" value="<%= new_size %>" data-herb-set="new_size=$value">
    </div>
    <p class="field__hint">Or any size up to <%= Pool::MAX_SIZE %>d. Bigger pools take only a little longer to clear.</p>
  </div>

  <div class="field">
    <%= form.label :phases_text, "Linked phases", class: "field__label" %>
    <%= form.text_field :phases_text, maxlength: 200, autocomplete: "off", placeholder: "4d Claws + 4d Tail + 4d Body", class: "field__input" %>
    <p class="field__hint">Optional. Only the current phase rolls; the next unlocks at 0d. Replaces the dice above.</p>
  </div>

  <label class="check">
    <%= form.check_box :hidden %>
    Hide from players
  </label>

  <%= form.submit "Add pool", class: "button button--primary" %>
<% end %>
