<%# herb:slots client %>
<%# herb:state (new_size: 4) %>
<% content_for :title, "Pools · #{Current.campaign.name}" %>
<% content_for :head do %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>
<%= turbo_stream_from Current.campaign, :pools %>

<header class="page-header">
  <p class="eyebrow"><%= link_to Current.campaign.name, campaign_path(Current.campaign) %></p>
  <h1>Pools</h1>
  <p class="page-header__lede">Roll a pool when the story triggers it. Every die showing 1–3 drops; at 0d, it happens. Everyone at the table sees rolls as they land.</p>
</header>

<div class="pools">
  <section class="pools__list" aria-label="Pools">
    <% if @pools.any? %>
      <div class="pool-grid">
        <% @pools.each do |pool| %>
          <%# herb:key pool.id %>
          <%# herb:state (drop_first: false) %>
          <article id="<%= dom_id(pool) %>" class="<%= class_names("pool", "pool--#{pool.kind}", "pool--depleted": pool.depleted?) %>">
            <header class="pool__header">
              <h2 class="pool__name"><%= pool.name %></h2>
              <p class="pool__kind" title="<%= pool.description %>">
                <%= pool.kind.humanize %> pool<% if pool.hidden? %> · <span class="tag">GM only</span><% end %>
              </p>
            </header>

            <div class="pool__meter" aria-label="<%= pool.size %> of <%= pool.starting_size %> dice left">
              <span class="pool__size"><%= pool.size %>d</span>
              <span class="pool__pips" aria-hidden="true"><% pool.starting_size.times do |i| %><span class="pip<%= " pip--gone" if i >= pool.size %>"></span><% end %></span>
            </div>

            <% if pool.depleted? %>
              <p class="pool__outcome"><%= pool.outcome %></p>
            <% end %>

            <% if pool.last_action.present? %>
              <div class="pool__last">
                <% if pool.last_dice.any? %>
                  <span class="pool__dice"><% pool.last_dice.each do |die| %><span class="die die--d6 die--small<%= die >= 4 ? " die--top" : " die--dropped" %>"><%= die %></span><% end %></span>
                <% end %>
                <p class="pool__summary">
                  <% if pool.last_action == "pushed" %>
                    Pushed by <%= pool.last_rolled_by&.display_name || "someone" %>: 1d dropped, take a mark.
                  <% else %>
                    <%= pool.last_dropped.to_i.zero? ? "Nothing dropped" : "#{pool.last_dropped}d dropped" %><%= " (1d before rolling)" if pool.last_action == "rolled_after_drop" %>
                    · <%= pool.last_rolled_by&.display_name || "someone" %>, <%= time_ago_in_words(pool.last_rolled_at) %> ago
                  <% end %>
                </p>
              </div>
            <% end %>

            <div class="pool__actions">
              <% if pool.rollable? %>
                <%= form_with url: campaign_pool_roll_path(Current.campaign, pool), class: "pool__roll" do %>
                  <label class="check">
                    <input type="checkbox" name="drop_first" value="1" checked="<%= drop_first %>" data-herb-toggle="drop_first">
                    Drop 1d first
                  </label>
                  <button type="submit" class="button button--primary">
                    <% if drop_first %>Drop 1d, then roll<% else %>Roll<% end %>
                  </button>
                <% end %>
              <% end %>

              <% if pool.pushable? %>
                <%= button_to "Push (take a mark)", campaign_pool_push_path(Current.campaign, pool), class: "button button--small" %>
              <% end %>

              <% if gm? %>
                <div class="pool__gm">
                  <% if pool.resettable? %>
                    <%= button_to "Reset to #{pool.starting_size}d", campaign_pool_reset_path(Current.campaign, pool), class: "button button--quiet button--small" %>
                  <% end %>
                  <%= button_to (pool.hidden? ? "Show to players" : "Hide from players"), campaign_pool_path(Current.campaign, pool), method: :patch, params: { pool: { hidden: !pool.hidden? } }, class: "button button--quiet button--small" %>
                  <%= button_to "Delete", campaign_pool_path(Current.campaign, pool), method: :delete, class: "button button--quiet button--small", form: { data: { turbo_confirm: "Delete #{pool.name}?" } } %>
                </div>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="empty"><%= gm? ? "No pools yet. Add one when the story needs a clock." : "No pools yet. Your GM adds them as the story needs." %></p>
    <% end %>
  </section>

  <div class="pools__side stack">
    <% if gm? %>
      <section class="panel stack" aria-labelledby="pool-new">
        <h2 id="pool-new" class="panel__title">New pool</h2>
        <%= form_with model: [ Current.campaign, @pool ], class: "stack" do |form| %>
          <% if @pool.errors.any? %>
            <p class="form-error"><%= @pool.errors.full_messages.to_sentence %></p>
          <% end %>

          <div class="field">
            <%= form.label :name, "Name", class: "field__label" %>
            <%= form.text_field :name, required: true, maxlength: 80, autocomplete: "off", placeholder: "Lookouts spot you", class: "field__input" %>
          </div>

          <div class="field">
            <%= form.label :kind, "Type", class: "field__label" %>
            <%= form.select :kind, Pool::LABELS.invert, {}, class: "field__input" %>
          </div>

          <div class="field">
            <label class="field__label" for="pool_starting_size">Dice</label>
            <div class="size-picker">
              <button type="button" class="button button--small" data-herb-set="new_size=2" aria-label="2 dice, short">2d</button>
              <button type="button" class="button button--small" data-herb-set="new_size=4" aria-label="4 dice, medium">4d</button>
              <button type="button" class="button button--small" data-herb-set="new_size=6" aria-label="6 dice">6d</button>
              <button type="button" class="button button--small" data-herb-set="new_size=8" aria-label="8 dice, long">8d</button>
              <input type="number" id="pool_starting_size" name="pool[starting_size]" class="field__input size-picker__input" min="1" max="<%= Pool::MAX_SIZE %>" step="1" required autocomplete="off" value="<%= new_size %>" data-herb-set="new_size=$value">
            </div>
            <p class="field__hint">2d short, 4d medium, 8d long. Bigger pools take only a little longer to clear.</p>
          </div>

          <label class="check">
            <%= form.check_box :hidden %>
            Hide from players
          </label>

          <%= form.submit "Add pool", class: "button button--primary" %>
        <% end %>
      </section>
    <% end %>

    <%= render "rolls/log", campaign: Current.campaign, membership: Current.membership, rolls: @rolls %>
  </div>
</div>
