<%# locals: (campaign:, membership:, feed:, speakers:, speaker: nil, suspense: nil, classes: nil, view: nil) %>
<%# The table's rail: chat and log in one time-ordered stream (TableFeed), filtered in the browser, with the composer. speakers: the active characters this member can speak as; speaker: the one picked first; view: the Show choice it opens on (Everything unless given). %>
<% feed.streams.each do |stream| %>
  <%= turbo_stream_from(*stream) %>
<% end %>
<% session = campaign.current_session %>
<% scene = session&.current_scene %>
<% gm = membership.gm? %>
<% prefix = "rail_#{campaign.id}" %>

<%# On a phone the rail drops below the page: a button to jump down to it, shown only while it's stacked below and out of view (chat_jump_controller.js). %>
<a href="#<%= prefix %>_rail" class="chat-jump" hidden data-controller="chat-jump" data-chat-jump-rail-value="<%= prefix %>_rail"><%= icon(:message, size: 18) %> Chat</a>
<section id="<%= prefix %>_rail" class="<%= class_names("table-rail", classes, "table-rail--gm": gm && !campaign.archived?, "table-rail--open": !campaign.archived?) %>" aria-labelledby="<%= prefix %>_title" data-controller="feed presence" data-presence-campaign-value="<%= campaign.id %>" data-action="turbo:morph@document->feed#render" data-feed-viewer-value="<%= membership.identity_id %>" data-feed-side-value="<%= gm ? "gm" : membership.identity_id %>" data-feed-before-value="<%= feed.oldest_at&.iso8601(6) %>" data-feed-more-value="<%= feed.more? %>" data-feed-older-url-value="<%= campaign_feed_path(campaign) %>">
  <div class="table-rail__head">
    <div class="table-rail__titles">
      <h2 id="<%= prefix %>_title" class="table-rail__title">The table</h2>
      <p class="table-rail__where"><%= session ? [ session.title, scene&.title ].compact.join(" · ") : "Between sessions" %></p>
    </div>
    <% if suspense %><%= render "campaigns/suspense_meter", campaign: campaign %><% end %>
    <%# Who's at the table, haloed by presence_controller.js: green in use, yellow idle, plain when away. Hovering one shows its name and presence (data-label, in presence_controller.js's tooltip). %>
    <span class="avatars" role="group" aria-label="At the table">
      <% campaign.memberships.includes(:identity).order(:role, :created_at).first(5).each do |member| %>
        <span class="<%= class_names("avatar", "avatar--gm": member.gm?) %>" role="img" aria-label="<%= member.identity.display_name %>" data-label="<%= member.identity.display_name %>" data-presence-identity="<%= member.identity_id %>" data-presence-name="<%= member.identity.display_name %>"><%= initial(member.identity.display_name) %></span>
      <% end %>
    </span>
  </div>

  <div class="feed">
    <%# What the feed shows, and where the composer sends (it's the form's context): CSS hides the rest (components.css, "Filters"), lines that arrive live included. A private conversation is picked by the other side: feed_controller.js marks its lines and sets the composer's line and placeholder. %>
    <% filters = feed_filters(campaign, membership, speakers) %>
    <% view ||= "all" %>
    <% opening = filters.find { _1.second == view } || filters.first %>
    <div class="feed__filter">
      <label class="feed__filter-label" for="<%= prefix %>_filter">Show</label>
      <%= select_tag :context, options_for_select(filters, opening.second), id: "#{prefix}_filter", form: "#{prefix}_composer", class: "field__input feed__filter-select", data: { feed_target: "filter", action: "feed#filter" } %>
      <%# Unread private messages (feed_controller.js); it opens the first conversation with any. %>
      <button type="button" class="feed__unread" hidden data-feed-target="unread" data-action="feed#openUnread"></button>
    </div>

    <div class="feed__scroller" data-feed-target="scroller" data-action="scroll->feed#scrolled">
      <div>
        <%# Scrolling up to here loads the page before (feed_controller.js); it says so while it does, and when there's nothing earlier. %>
        <p class="feed__older" data-feed-target="older" aria-live="polite"></p>
        <ol id="table_feed" class="feed__items" aria-live="polite" aria-label="Table chat and log" data-feed-target="list">
          <%= render "campaigns/feed_entries", feed: feed %>
        </ol>
        <div class="empty feed__empty">
          <p class="feed__empty-title">No scribbles here yet</p>
          <p>The quill's sharpened and the parchment's bare. Rolls, scenes and talk land here as they happen.</p>
        </div>
      </div>
    </div>
    <%# Shown by feed_controller.js when lines arrive while you're scrolled up reading. %>
    <button type="button" class="feed__new" hidden data-feed-target="newPill" data-action="feed#latest">
      <span data-feed-target="newCount">New</span>
      <%= icon(:chevron, size: 14) %>
    </button>
  </div>

  <%# An archived campaign's log is for reading (Campaign::Archive). %>
  <% if campaign.archived? %>
    <p class="table-rail__archived"><%= campaign.name %> is archived. The log stays here to read.</p>
  <% else %>
    <%# No picker for where it goes: Show decides (the GM may still voice an NPC in the story views, and a player with more than one character here picks which speaks). %>
    <%= form_with url: campaign_messages_path(campaign), id: "#{prefix}_composer", class: class_names("composer", "composer--no-character": !gm && speakers.none?), data: { controller: "chat-form", action: "turbo:submit-end->chat-form#sent keydown->chat-form#keydown" } do %>
      <p class="composer__to" data-feed-target="to"><%= opening.last[:data][:to] %></p>
      <% if gm %>
        <div class="composer__voices">
          <%= render "shared/segmented", name: "voice", legend: "Who's speaking", options: [ %w[ narration Narrate ], [ "npc", "As NPC" ] ], checked: "narration", id_prefix: "#{prefix}_voice", classes: "composer__voice-pick" %>
          <div class="composer__npc">
            <label class="visually-hidden" for="<%= prefix %>_npc">NPC name</label>
            <input type="text" id="<%= prefix %>_npc" name="speaker_name" maxlength="60" autocomplete="off" placeholder="Who's speaking? Miller Hode…" class="field__input">
          </div>
        </div>
      <% elsif speakers.many? %>
        <div class="composer__voices">
          <%= render "shared/segmented", name: "character_id", legend: "Who's speaking", options: speakers.map { [ _1.id, "As #{_1.short_name}" ] }, checked: (speaker || speakers.first).id, id_prefix: "#{prefix}_speaker", classes: "composer__voice-pick" %>
        </div>
      <% elsif speakers.one? %>
        <input type="hidden" name="character_id" value="<%= speakers.first.id %>">
      <% end %>
      <label class="visually-hidden" for="<%= prefix %>_body">Message</label>
      <textarea id="<%= prefix %>_body" name="body" rows="3" required maxlength="<%= Message::MAX_LENGTH %>" autocomplete="off" placeholder="<%= opening.last[:data][:placeholder] %>" aria-describedby="<%= prefix %>_hint" class="field__input composer__input" data-chat-form-target="body"></textarea>
      <div class="composer__row">
        <p class="composer__hint" id="<%= prefix %>_hint">*italics* **bold** · Shift+Enter: new line</p>
        <button type="submit" class="button button--primary composer__send">Send</button>
      </div>
    <% end %>
  <% end %>
</section>
