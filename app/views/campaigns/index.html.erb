<% content_for :title, "Campaigns" %>

<header class="page-header">
  <p class="eyebrow">Your tables</p>
  <h1>Campaigns</h1>
  <p class="page-header__lede">Start a campaign to run it as GM, or open a join link from your GM to play in theirs.</p>
</header>

<div class="campaigns">
  <section aria-labelledby="campaign-list">
    <h2 id="campaign-list" class="visually-hidden">Your campaigns</h2>
    <% if @memberships.any? %>
      <ul class="tool-grid__list">
        <% @memberships.each do |membership| %>
          <li>
            <%= link_to campaign_path(membership.campaign), class: "tool-card tool-card--ready" do %>
              <span class="tool-card__name"><%= membership.campaign.name %></span>
              <span class="tool-card__desc"><%= membership.gm? ? "You're the GM" : "You're a player" %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="empty">No campaigns yet.</p>
    <% end %>
  </section>

  <section class="panel stack" aria-labelledby="campaign-new">
    <h2 id="campaign-new" class="panel__title">Start a campaign</h2>
    <%= form_with model: @campaign, class: "stack" do |form| %>
      <% if @campaign.errors.any? %>
        <p class="form-error"><%= @campaign.errors.full_messages.to_sentence %></p>
      <% end %>
      <div class="field">
        <%= form.label :name, "Campaign name", class: "field__label" %>
        <%= form.text_field :name, required: true, maxlength: 80, placeholder: "The Bramblewood Accord", class: "field__input" %>
      </div>
      <%= form.submit "Start campaign", class: "button button--primary" %>
    <% end %>
    <p class="field__hint">You'll be its GM. Players join with a link you share.</p>
  </section>
</div>
