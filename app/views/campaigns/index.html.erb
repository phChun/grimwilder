<% content_for :title, "Campaigns" %>

<header class="page-header">
  <p class="eyebrow">Your tables</p>
  <h1>Campaigns</h1>
  <p class="page-header__lede">Start a campaign to run it as GM, or open a join link from your GM to play in theirs.</p>
</header>

<%# Active campaigns lead, archived ones follow, and the last card starts a new one, or says why the plan has no room (Identity::Plans). %>
<% active, archived = @memberships.partition { !_1.campaign.archived? } %>
<ul class="tool-grid__list" aria-label="Your campaigns">
  <% (active + archived).each do |membership| %>
    <% campaign = membership.campaign %>
    <li class="campaign-card">
      <%# Straight to where you play: the GM table, or your character's sheet (Campaigns::PlaysController); an archived campaign opens its page. %>
      <%= link_to (campaign.archived? ? campaign_path(campaign) : campaign_play_path(campaign)), class: class_names("tool-card", "tool-card--ready": !campaign.archived?) do %>
        <span class="tool-card__name"><%= campaign.name %></span>
        <span class="tool-card__desc"><%= membership.gm? ? "You're the GM" : "You're a player" %><% if campaign.archived? %> · archived <%= l(campaign.archived_at.to_date, format: :long) %><% end %></span>
      <% end %>
      <%# The GM's ⋯: archive or unarchive from here (Campaigns::ArchivesController, back to this list). Players leave from the campaign page. %>
      <% if membership.gm? %>
        <details id="<%= dom_id(campaign, :more) %>" class="campaign-card__more" data-controller="menu" data-action="toggle->menu#place">
          <summary class="button campaign-card__toggle" aria-label="More for <%= campaign.name %>"><%= icon(:more, size: 18) %></summary>
          <div class="campaign-card__menu" data-menu-target="panel">
            <%= render "shared/popover_head", title: campaign.name %>
            <% if campaign.archived? %>
              <%= button_to "Unarchive", campaign_archive_path(campaign), method: :delete, params: { return_to: "campaigns" }, class: "button button--small" %>
            <% elsif campaign.current_session %>
              <button type="button" class="button button--small" disabled>Archive</button>
              <p class="field__hint">End the session first.</p>
            <% else %>
              <%= button_to "Archive", campaign_archive_path(campaign), params: { return_to: "campaigns" }, class: "button button--small", form: { data: { turbo_confirm: archive_confirmation(campaign) } } %>
            <% end %>
          </div>
        </details>
      <% end %>
    </li>
  <% end %>
  <li>
    <section id="campaign-new" class="tool-card add-card" aria-labelledby="campaign-new-title">
      <h2 id="campaign-new-title" class="tool-card__name">Create new campaign</h2>
      <% if !Current.identity.room_to_run? && @campaign.errors.none? %>
        <p class="tool-card__desc"><%= Current.identity.plan_limit_message(:gm) %></p>
      <% else %>
        <%= form_with model: @campaign, class: "stack" do |form| %>
          <% if @campaign.errors.any? %>
            <p class="form-error"><%= @campaign.errors.full_messages.to_sentence %></p>
          <% end %>
          <div class="field">
            <%= form.label :name, "Campaign name", class: "field__label" %>
            <%= form.text_field :name, required: true, maxlength: 80, placeholder: "The Bramblewood Accord", class: "field__input" %>
          </div>
          <%= form.submit "Start campaign", class: "button button--primary" %>
        <% end %>
        <p class="field__hint">You'll be its GM. Players join with a link you share.</p>
      <% end %>
    </section>
  </li>
</ul>
