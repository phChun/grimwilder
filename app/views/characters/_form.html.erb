<%# locals: (character:) %>
<%= form_with model: character, class: "character-form" do |form| %>
  <% if character.errors.any? %>
    <p class="flash flash--alert"><%= character.errors.full_messages.to_sentence %></p>
  <% end %>

  <%= render "characters/fields/datalists" %>

  <section class="panel stack" aria-labelledby="form-basics">
    <h2 id="form-basics" class="panel__title">Who they are</h2>
    <div class="field">
      <%= form.label :name, class: "field__label" %>
      <%= form.text_field :name, required: true, maxlength: 80, autocomplete: "off", placeholder: "Gibbletibble \"Tibbs\"", class: "field__input" %>
    </div>
    <div class="field">
      <span class="field__label">Path</span>
      <%# The table's GM may close some paths and options (Campaign::CharacterSettings); a character keeps what it already has. %>
      <% table = character.campaign %>
      <% paths = Grimwild.paths.keys.select { |path| table.nil? || table.path_allowed?(path) || path == character.path_was } %>
      <%= render "characters/path_picker", form: form, character: character, paths: paths %>
      <% if table && table.allowed_paths.any? %><p class="field__hint"><%= table.name %> has <%= pluralize(table.allowed_paths.size, "path") %> open.</p><% end %>
      <% legacy = Talent.all.select(&:legacy_core_of) %>
      <% unless character.persisted? %>
        <% if (start = table&.starting_level) %>
          <p class="field__hint">New characters at <%= table.name %> start at level <%= start %>.</p>
        <% else %>
          <div class="field field--inline">
            <%= form.label :level, "Level", class: "field__label" %>
            <%= form.select :level, (1..Grimwild::MAX_LEVEL).to_a, {}, class: "field__input field__input--short" %>
          </div>
          <p class="field__hint">Joining a table that's already under way? Start at its level: a talent for each level, and the core talent's growth.</p>
          <% if character.rule_allows?(:level_zero) %>
            <label class="check">
              <%= form.check_box :level_zero %>
              Start at level 0: no core talent yet, and 3 stat points instead of 4 (optional rule, pg. 177).
            </label>
          <% end %>
        <% end %>
      <% end %>
      <% if character.rule_allows?(:legacy_cores) || character.legacy_core? %>
        <label class="check">
          <%= form.check_box :legacy_core %>
          Use the legacy core talent, where the path has one (<%= legacy.map { "#{_1.legacy_core_of}: #{_1.name.delete_suffix(" (Legacy)")}" }.to_sentence %>; pg. 179).
        </label>
      <% end %>
    </div>
    <%# Once made, the edit page's "At the table" section seats or moves the character. %>
    <% unless character.persisted? %>
      <div class="field">
        <%= form.label :campaign_id, "Campaign", class: "field__label" %>
        <%= form.select :campaign_id, Current.identity.campaigns.active.order(:name).select { _1.makes_characters?(Current.identity) }.map { |campaign| [ campaign.name, campaign.id ] }, { include_blank: "Not in a campaign" }, class: "field__input" %>
      </div>
    <% end %>
    <% if Current.identity.memberships.gm.exists? %>
      <div class="field">
        <label class="check">
          <%= form.check_box :up_for_grabs %>
          Up for grabs
        </label>
        <p class="field__hint">For a campaign you GM: the character waits on the campaign page for a player to pick, and you hold it until then.</p>
      </div>
    <% end %>
    <% if character.persisted? %>
      <% unless character.active? %>
        <div class="field">
          <%= form.label :farewell, "How it ended", class: "field__label" %>
          <%= form.text_field :farewell, maxlength: Character::Farewell::FAREWELL_LIMIT, autocomplete: "off", class: "field__input" %>
        </div>
      <% end %>
      <% if character.sets_own_level? %>
        <div class="field field--inline">
          <%= form.label :level, class: "field__label" %>
          <%= form.number_field :level, min: (character.level_zero? ? 0 : 1), max: Grimwild::MAX_LEVEL, class: "field__input field__input--short" %>
        </div>
      <% else %>
        <p class="field__hint">Level <%= character.level %>: at <%= character.campaign.name %>, levels change with XP and milestones.</p>
      <% end %>
    <% end %>
  </section>

  <section class="panel stack" aria-labelledby="form-stats">
    <h2 id="form-stats" class="panel__title">Stats</h2>
    <p class="field__hint">Start with 1 in each, then add 4 points (3 at level 0), up to 3 in any one stat.</p>
    <div class="stat-inputs">
      <% Grimwild.stats.each do |stat, description| %>
        <div class="field">
          <%= form.label stat, class: "field__label" %>
          <%= form.select stat, (1..3).to_a, {}, class: "field__input" %>
          <p class="field__hint"><%= description %></p>
        </div>
      <% end %>
    </div>
  </section>

  <%# Once made, who they are and their story are edited on the sheet, each card on its own (Characters::ProfilesController, Characters::StoriesController). %>
  <% unless character.persisted? %>
    <section class="panel stack" aria-labelledby="form-backgrounds">
      <h2 id="form-backgrounds" class="panel__title">Backgrounds</h2>
      <%= render "characters/fields/backgrounds", character: character %>
    </section>

    <section class="panel stack" aria-labelledby="form-heart">
      <h2 id="form-heart" class="panel__title">Traits and desires</h2>
      <%= render "characters/fields/heart", form: form, character: character %>
    </section>

    <section class="panel stack" aria-labelledby="form-look">
      <h2 id="form-look" class="panel__title">Features and weapons</h2>
      <%= render "characters/fields/look", form: form, character: character %>
    </section>

    <section class="panel stack" aria-labelledby="form-story">
      <h2 id="form-story" class="panel__title">Story</h2>
      <%= render "characters/fields/story", character: character %>
    </section>
  <% end %>

  <section class="panel stack" aria-labelledby="form-talents">
    <h2 id="form-talents" class="panel__title">Talents and notes</h2>
    <%# The talents themselves come from the catalog (characters/talents#new), which a new character goes to right after this form. %>
    <% if character.persisted? %>
      <div class="field">
        <p class="field__label">Talents</p>
        <ul class="talent-names">
          <% character.talent_entries.each do |talent| %>
            <li><%= talent.name %><% if talent.key == character.core_talent_entry&.key %> <span class="tag">core</span><% end %></li>
          <% end %>
        </ul>
        <p class="field__hint">
          <% if character.talents_to_choose.positive? %>
            <%= link_to "Choose #{pluralize(character.talents_to_choose, "more talent")}", new_character_talent_path(character) %>.
          <% else %>
            That's the full set for level <%= character.level %>.
          <% end %>
          Remove or re-skin them on the <%= link_to "sheet", character_path(character, anchor: "talents") %>.
        </p>
      </div>
    <% else %>
      <p class="field__hint">Next, you'll choose a first talent from the catalog. Your path's core talent comes with it.</p>
    <% end %>
    <div class="field">
      <%= form.label :talents, "Talent notes", class: "field__label" %>
      <%= form.text_area :talents, rows: 4, class: "field__input", placeholder: "Homebrew talents, or anything else your talents ask you to note." %>
    </div>
    <% if character.persisted? %>
      <p class="field__hint">Who <%= character.short_name %> is, their bonds, arcs and notes: edit them on <%= link_to "the sheet", character_path(character, anchor: "who") %>, each in its card.</p>
    <% else %>
      <div class="field">
        <%= form.label :notes, class: "field__label" %>
        <%= form.text_area :notes, rows: 4, class: "field__input", placeholder: "Gear, contacts, secrets…" %>
      </div>
    <% end %>
  </section>

  <div class="character-form__actions">
    <%= form.submit (character.persisted? ? "Save sheet" : "Create character"), class: "button button--primary" %>
    <%= link_to "Cancel", (character.persisted? ? character_path(character) : characters_path), class: "button button--quiet" %>
  </div>
<% end %>
