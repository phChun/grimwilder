<%# locals: (character:) %>
<%= form_with model: character, class: "character-form" do |form| %>
  <% if character.errors.any? %>
    <p class="flash flash--alert"><%= character.errors.full_messages.to_sentence %></p>
  <% end %>

  <datalist id="traits-list"><% Grimwild.traits.each do |trait| %><option value="<%= title_case(trait) %>"></option><% end %></datalist>
  <datalist id="desires-list"><% Grimwild.desires.each do |desire| %><option value="<%= title_case(desire) %>"></option><% end %></datalist>
  <datalist id="styles-list"><% Grimwild.weapon_styles.each do |style| %><option value="<%= title_case(style) %>"></option><% end %></datalist>
  <datalist id="backgrounds-list"><% Grimwild.backgrounds.each_key do |background| %><option value="<%= background %>"></option><% end %></datalist>
  <datalist id="arcs-list"><% Grimwild.arcs.values.flatten.each do |arc| %><option value="<%= title_case(arc) %>"></option><% end %></datalist>

  <section class="panel stack" aria-labelledby="form-basics">
    <h2 id="form-basics" class="panel__title">Who they are</h2>
    <div class="field">
      <%= form.label :name, class: "field__label" %>
      <%= form.text_field :name, required: true, maxlength: 80, autocomplete: "off", placeholder: "Gibbletibble \"Tibbs\"", class: "field__input" %>
    </div>
    <div class="field">
      <span class="field__label">Path</span>
      <%# The table's GM may close some paths and options (Campaign::CharacterSettings); a character keeps what it already has. %>
      <% table = character.campaign %>
      <% paths = Grimwild.paths.keys.select { |path| table.nil? || table.path_allowed?(path) || path == character.path_was } %>
      <%= render "characters/path_picker", form: form, character: character, paths: paths %>
      <% if table && table.allowed_paths.any? %><p class="field__hint"><%= table.name %> has <%= pluralize(table.allowed_paths.size, "path") %> open.</p><% end %>
      <% legacy = Talent.all.select(&:legacy_core_of) %>
      <% unless character.persisted? %>
        <% if (start = table&.starting_level) %>
          <p class="field__hint">New characters at <%= table.name %> start at level <%= start %>.</p>
        <% else %>
          <div class="field field--inline">
            <%= form.label :level, "Level", class: "field__label" %>
            <%= form.select :level, (1..Grimwild::MAX_LEVEL).to_a, {}, class: "field__input field__input--short" %>
          </div>
          <p class="field__hint">Joining a table that's already under way? Start at its level: a talent for each level, and the core talent's growth.</p>
          <% if character.rule_allows?(:level_zero) %>
            <label class="check">
              <%= form.check_box :level_zero %>
              Start at level 0: no core talent yet, and 3 stat points instead of 4 (optional rule, pg. 177).
            </label>
          <% end %>
        <% end %>
      <% end %>
      <% if character.rule_allows?(:legacy_cores) || character.legacy_core? %>
        <label class="check">
          <%= form.check_box :legacy_core %>
          Use the legacy core talent, where the path has one (<%= legacy.map { "#{_1.legacy_core_of}: #{_1.name.delete_suffix(" (Legacy)")}" }.to_sentence %>; pg. 179).
        </label>
      <% end %>
    </div>
    <%# Once made, the edit page's "At the table" section seats or moves the character. %>
    <% unless character.persisted? %>
      <div class="field">
        <%= form.label :campaign_id, "Campaign", class: "field__label" %>
        <%= form.select :campaign_id, Current.identity.campaigns.active.order(:name).select { _1.makes_characters?(Current.identity) }.map { |campaign| [ campaign.name, campaign.id ] }, { include_blank: "Not in a campaign" }, class: "field__input" %>
      </div>
    <% end %>
    <% if Current.identity.memberships.gm.exists? %>
      <div class="field">
        <label class="check">
          <%= form.check_box :up_for_grabs %>
          Up for grabs
        </label>
        <p class="field__hint">For a campaign you GM: the character waits on the campaign page for a player to pick, and you hold it until then.</p>
      </div>
    <% end %>
    <% if character.persisted? %>
      <% unless character.active? %>
        <div class="field">
          <%= form.label :farewell, "How it ended", class: "field__label" %>
          <%= form.text_field :farewell, maxlength: Character::Farewell::FAREWELL_LIMIT, autocomplete: "off", class: "field__input" %>
        </div>
      <% end %>
      <% if character.sets_own_level? %>
        <div class="field field--inline">
          <%= form.label :level, class: "field__label" %>
          <%= form.number_field :level, min: (character.level_zero? ? 0 : 1), max: Grimwild::MAX_LEVEL, class: "field__input field__input--short" %>
        </div>
      <% else %>
        <p class="field__hint">Level <%= character.level %>: at <%= character.campaign.name %>, levels change with XP and milestones.</p>
      <% end %>
    <% end %>
  </section>

  <section class="panel stack" aria-labelledby="form-stats">
    <h2 id="form-stats" class="panel__title">Stats</h2>
    <p class="field__hint">Start with 1 in each, then add 4 points (3 at level 0), up to 3 in any one stat.</p>
    <div class="stat-inputs">
      <% Grimwild.stats.each do |stat, description| %>
        <div class="field">
          <%= form.label stat, class: "field__label" %>
          <%= form.select stat, (1..3).to_a, {}, class: "field__input" %>
          <p class="field__hint"><%= description %></p>
        </div>
      <% end %>
    </div>
  </section>

  <section class="panel stack" aria-labelledby="form-backgrounds" data-controller="background" data-background-wises-value="<%= Grimwild.backgrounds.transform_values { |wises| wises.map { title_case(_1) } }.to_json %>">
    <h2 id="form-backgrounds" class="panel__title">Backgrounds</h2>
    <p class="field__hint">Two backgrounds, each with three wises. Pick a common one to fill in its wises, then make them your own.</p>
    <div class="two-up">
      <% 2.times do |i| %>
        <% background = character.backgrounds[i] || {} %>
        <fieldset class="fieldset">
          <legend class="field__label">Background <%= i + 1 %></legend>
          <input type="text" maxlength="<%= Character::WORD_LIMIT %>" name="character[backgrounds][<%= i %>][name]" value="<%= background["name"] %>" list="backgrounds-list" placeholder="<%= type_or_select %>" autocomplete="off" class="field__input" aria-label="Background <%= i + 1 %> name" data-controller="datalist" data-action="focus->datalist#open blur->datalist#close change->background#fill" data-background-target="name" data-index="<%= i %>">
          <% 3.times do |w| %>
            <input type="text" maxlength="<%= Character::WORD_LIMIT %>" name="character[backgrounds][<%= i %>][wises][]" value="<%= background.fetch("wises", [])[w] %>" placeholder="Wise" autocomplete="off" class="field__input field__input--small" aria-label="Background <%= i + 1 %> wise <%= w + 1 %>" data-background-target="wise" data-index="<%= i %>">
          <% end %>
        </fieldset>
      <% end %>
    </div>
  </section>

  <section class="panel stack" aria-labelledby="form-heart">
    <h2 id="form-heart" class="panel__title">Traits and desires</h2>
    <div class="two-up">
      <fieldset class="fieldset">
        <legend class="field__label">Traits: 2 you are, 1 you aren't</legend>
        <% 2.times do |i| %>
          <input type="text" maxlength="<%= Character::WORD_LIMIT %>" name="character[traits][]" value="<%= character.traits[i] %>" list="traits-list" placeholder="<%= type_or_select %>" autocomplete="off" class="field__input" aria-label="Trait <%= i + 1 %>">
        <% end %>
        <%= form.text_field :not_trait, maxlength: Character::WORD_LIMIT, list: "traits-list", autocomplete: "off", placeholder: type_or_select("But not…"), class: "field__input field__input--not", "aria-label": "Trait you aren't" %>
      </fieldset>
      <fieldset class="fieldset">
        <legend class="field__label">Desires: 2 you want, 1 you don't</legend>
        <% 2.times do |i| %>
          <input type="text" maxlength="<%= Character::WORD_LIMIT %>" name="character[desires][]" value="<%= character.desires[i] %>" list="desires-list" placeholder="<%= type_or_select %>" autocomplete="off" class="field__input" aria-label="Desire <%= i + 1 %>">
        <% end %>
        <%= form.text_field :not_desire, maxlength: Character::WORD_LIMIT, list: "desires-list", autocomplete: "off", placeholder: type_or_select("But not…"), class: "field__input field__input--not", "aria-label": "Desire you don't want" %>
      </fieldset>
    </div>
  </section>

  <section class="panel stack" aria-labelledby="form-look">
    <h2 id="form-look" class="panel__title">Features and weapons</h2>
    <%# The features crucible rolls right here (a lazy frame, fetched when the fold opens): tapping a word puts it in the next empty box (feature_fill_controller.js). %>
    <fieldset class="fieldset" data-controller="feature-fill" data-feature-fill-nouns-value="<%= { "Clothing" => "clothes", "Voice" => "voice", "Eyes" => "eyes" }.to_json %>" data-action="crucible:pick->feature-fill#fill">
      <legend class="field__label">Three distinctive features</legend>
      <% 3.times do |i| %>
        <input type="text" maxlength="<%= Character::WORD_LIMIT %>" name="character[features][]" value="<%= character.features[i] %>" autocomplete="off" placeholder="<%= [ "shock of brown hair", "cane", "kind eyes" ][i] %>" class="field__input" aria-label="Feature <%= i + 1 %>" data-feature-fill-target="input">
      <% end %>
      <details class="fold feature-crucible">
        <summary class="fold__summary"><span class="fold__title">Roll the Features Crucible for Ideas</span></summary>
        <p class="field__hint" data-feature-fill-target="status" aria-live="polite">Roll, then tap a word to put it in the next empty box.</p>
        <turbo-frame id="crucible" src="<%= crucible_path("features", embed: 1) %>" loading="lazy"></turbo-frame>
      </details>
    </fieldset>
    <div class="field">
      <%= form.label :weapons, "Weapons", class: "field__label" %>
      <%= form.text_field :weapons, maxlength: Character::WORD_LIMIT, autocomplete: "off", placeholder: "short sword and buckler", class: "field__input" %>
    </div>
    <% if character.campaign&.optional_rule?(:armor) || character.armor %>
      <%# The Armor optional rule (pg. 176): light or heavy armor gives an Armor pool each session. %>
      <div class="field">
        <%= form.label :armor, "Armor", class: "field__label" %>
        <%= form.select :armor, [ [ "None", "" ], [ "Light: 1d Armor pool, Lightly Armored", "light" ], [ "Heavy: 2d Armor pool, Heavily Armored", "heavy" ] ], {}, class: "field__input" %>
      </div>
    <% end %>
    <%# Weapon styles are an optional rule (pg. 177): asked for at a table that uses it, or once filled in. %>
    <% if weapon_styles_offered?(character) %>
    <fieldset class="fieldset">
      <legend class="field__label">Two weapon styles</legend>
      <div class="two-up">
        <% 2.times do |i| %>
          <input type="text" maxlength="<%= Character::WORD_LIMIT %>" name="character[weapon_styles][]" value="<%= character.weapon_styles[i] %>" list="styles-list" placeholder="<%= type_or_select %>" autocomplete="off" class="field__input" aria-label="Weapon style <%= i + 1 %>">
        <% end %>
      </div>
    </fieldset>
    <% end %>
  </section>

  <section class="panel stack" aria-labelledby="form-story">
    <h2 id="form-story" class="panel__title">Story</h2>
    <fieldset class="fieldset">
      <legend class="field__label">Character arcs (one or two)</legend>
      <% 2.times do |i| %>
        <input type="text" maxlength="<%= Character::WORD_LIMIT %>" name="character[arcs][]" value="<%= character.arcs[i] %>" list="arcs-list" placeholder="<%= type_or_select %>" autocomplete="off" class="field__input" aria-label="Arc <%= i + 1 %>">
      <% end %>
    </fieldset>
    <fieldset class="fieldset">
      <legend class="field__label">Bonds: how you see each other PC, and any NPCs</legend>
      <%# One bond toward each other character at the table (pg. 23, 47); bonds to anyone else, or for a character not at a table, are written in by name. %>
      <% party = character.bond_party.to_a %>
      <% others = (character.campaign ? character.bonds_beyond(party) : character.bonds) + [ {} ] %>
      <% party.each_with_index do |other, i| %>
        <div class="bond-row">
          <label class="bond-row__who" for="bond_<%= i %>"><span class="bond-row__name"><%= other.name %></span> <span class="bond-row__player"><%= other.owned_by?(character.identity) ? "also yours" : "played by #{other.identity.display_name}" %></span></label>
          <input type="hidden" name="character[bonds][<%= i %>][character_id]" value="<%= other.id %>">
          <input type="hidden" name="character[bonds][<%= i %>][to]" value="<%= other.name %>">
          <input type="text" id="bond_<%= i %>" name="character[bonds][<%= i %>][bond]" value="<%= character.bond_for(other)&.dig("bond") %>" maxlength="<%= Character::BOND_LIMIT %>" placeholder="Lowkey Affection" autocomplete="off" class="field__input">
        </div>
      <% end %>
      <% if character.campaign && party.empty? %>
        <p class="field__hint">No one else is at <%= character.campaign.name %>'s table yet. Each character who joins gets a bond here.</p>
      <% end %>
      <%# NPCs and anyone else, by name: as many as the player likes. %>
      <div class="bonds-npcs" data-controller="bonds" data-bonds-next-value="<%= party.size + others.size %>">
        <p class="bonds-npcs__title">NPCs and others</p>
        <div class="stack bonds-npcs__list" data-bonds-target="list">
          <% others.each_with_index do |bond, n| %>
            <%= render "characters/bond_row", index: party.size + n, bond: bond %>
          <% end %>
        </div>
        <template data-bonds-target="template"><%= render "characters/bond_row", index: "__INDEX__", bond: {} %></template>
        <button type="button" class="button button--small bonds-npcs__add" data-action="bonds#add">Add an NPC</button>
      </div>
      <p class="field__hint">Match an intensity (<%= Grimwild.bond_intensities.map { title_case(_1) }.to_sentence(last_word_connector: " or ") %>) with a nature like <%= Grimwild.bond_natures.first(6).map { title_case(_1) }.join(", ") %>.</p>
    </fieldset>
  </section>

  <section class="panel stack" aria-labelledby="form-talents">
    <h2 id="form-talents" class="panel__title">Talents and notes</h2>
    <%# The talents themselves come from the catalog (characters/talents#new), which a new character goes to right after this form. %>
    <% if character.persisted? %>
      <div class="field">
        <p class="field__label">Talents</p>
        <ul class="talent-names">
          <% character.talent_entries.each do |talent| %>
            <li><%= talent.name %><% if talent.key == character.core_talent_entry&.key %> <span class="tag">core</span><% end %></li>
          <% end %>
        </ul>
        <p class="field__hint">
          <% if character.talents_to_choose.positive? %>
            <%= link_to "Choose #{pluralize(character.talents_to_choose, "more talent")}", new_character_talent_path(character) %>.
          <% else %>
            That's the full set for level <%= character.level %>.
          <% end %>
          Remove or re-skin them on the <%= link_to "sheet", character_path(character, anchor: "talents") %>.
        </p>
      </div>
    <% else %>
      <p class="field__hint">Next, you'll choose a first talent from the catalog. Your path's core talent comes with it.</p>
    <% end %>
    <div class="field">
      <%= form.label :talents, "Talent notes", class: "field__label" %>
      <%= form.text_area :talents, rows: 4, class: "field__input", placeholder: "Homebrew talents, or anything else your talents ask you to note." %>
    </div>
    <div class="field">
      <%= form.label :notes, class: "field__label" %>
      <%= form.text_area :notes, rows: 4, class: "field__input", placeholder: "Gear, contacts, secrets…" %>
    </div>
  </section>

  <div class="character-form__actions">
    <%= form.submit (character.persisted? ? "Save sheet" : "Create character"), class: "button button--primary" %>
    <%= link_to "Cancel", (character.persisted? ? character_path(character) : characters_path), class: "button button--quiet" %>
  </div>
<% end %>
