<%# locals: (character:, campaigns:) %>
<%# Character::Seating: pick which of your campaigns the character plays in. %>
<%= form_with url: character_seat_path(character), method: :patch, class: "seat-form" do |form| %>
  <%= form.label :campaign_id, "Campaign", for: "seat_#{character.id}", class: "field__label" %>
  <div class="seat-form__row">
    <%= form.select :campaign_id, campaigns.map { |campaign| [ campaign.name, campaign.id ] }, { selected: character.campaign_id, include_blank: "Not in a campaign" }, id: "seat_#{character.id}", class: "field__input field__input--small" %>
    <%= form.submit (character.campaign ? "Move" : "Seat"), class: "button button--small" %>
  </div>
<% end %>
