<%# locals: (character:, can_spend:) %>
<section id="talent-uses" class="panel stack" aria-labelledby="sheet-talent-uses" data-controller="talent-uses">
  <h2 id="sheet-talent-uses" class="panel__title">Talent uses</h2>

  <% character.use_counters.each do |use| %>
    <% total, spent = use.count_at(character.level), character.uses_spent(use) %>
    <div class="tracker use-tracker">
      <span class="tracker__name"><%= use.label %></span>
      <span class="use-boxes" role="group" aria-label="<%= use.label %>: <%= total - spent %> of <%= total %> left">
        <% total.times do |index| %>
          <% used = index < spent %>
          <% if can_spend %>
            <%= button_to character_talent_uses_path(character), method: :patch, params: { use: use.id, spent: used ? index : index + 1 }, class: class_names("use-box", "use-box--spent": used), "aria-pressed": used.to_s, form: { class: "use-box__form" } do %>
              <span class="visually-hidden"><%= used ? "Unspend" : "Spend" %> <%= use.label.downcase %> <%= index + 1 %></span>
            <% end %>
          <% else %>
            <span class="<%= class_names("use-box", "use-box--spent": used) %>"></span>
          <% end %>
        <% end %>
      </span>
      <p class="field__hint tracker__hint"><%= use.resets.capitalize %>.</p>
    </div>
  <% end %>

  <% if can_spend && character.use_counters.any? %>
    <label class="check use-note">
      <input type="checkbox" data-talent-uses-target="note" data-action="talent-uses#remember">
      Post to the table log when spending
    </label>
  <% end %>

  <% if (pools = character.talent_pools.ordered.to_a).any? %>
    <div class="pool-rows pool-rows--sheet">
      <% pools.each do |pool| %>
        <%= render "campaigns/pools/pool", pool: pool, my_characters: [], gm: false, return_to: "character" %>
      <% end %>
    </div>
  <% elsif character.pool_uses.any? %>
    <p class="field__hint">Talent pools (<%= character.pool_uses.map(&:label).to_sentence %>) appear when a session starts.</p>
  <% end %>
</section>
