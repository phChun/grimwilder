<%# locals: (character:, editable:) %>
<%# The Story card's contents: what changes in play, bonds, arcs and notes. The owner edits it right here (Characters::StoriesController swaps in the form). Bonds' names are shown as written. %>
<%= turbo_frame_tag "character_story" do %>
  <dl class="facts">
    <div>
      <dt>Bonds</dt>
      <dd>
        <%# Everyone at the table (by their name now), then bonds to anyone else. %>
        <% party = character.bond_party.to_a %>
        <% bond_lines = party.map { |other| [ other.name, character.bond_for(other)&.dig("bond") ] } + character.bonds_beyond(party).map { [ _1["to"], _1["bond"] ] } %>
        <% if bond_lines.any? %>
          <ul class="facts__list"><% bond_lines.each do |to, bond| %><li><%= to %> · <%= bond.present? ? title_case(bond) : "not set yet" %></li><% end %></ul>
        <% else %>
          —
        <% end %>
      </dd>
    </div>
    <div>
      <dt><%= character.arcs.many? ? "Arcs" : "Arc" %></dt>
      <dd>
        <% if character.arcs.any? %>
          <ul class="facts__list"><% character.arcs.each do |arc| %><li class="facts__arc"><%= title_case(arc) %></li><% end %></ul>
        <% else %>
          none yet
        <% end %>
      </dd>
    </div>
  </dl>
  <% if character.notes.present? %>
    <div class="sheet-notes">
      <h3 class="sheet-notes__title">Notes</h3>
      <%= simple_format(character.notes) %>
    </div>
  <% end %>
  <% if editable %>
    <p class="sheet-fold__actions"><%= link_to "Edit", edit_character_story_path(character), class: "button button--small", "aria-label": "Edit #{character.short_name}'s story" %></p>
  <% end %>
<% end %>
