<% content_for :title, "New item · #{@character.name}" %>

<%# Its own page, and from the sheet's Arcana and items section a modal (shared/_frame_modal). %>
<%= turbo_frame_tag "modal" do %>
  <header class="page-header">
    <p class="eyebrow"><%= link_to @character.name, character_path(@character) %></p>
    <h1>New item</h1>
    <p class="page-header__lede">Something worth keeping track of that isn't magic: a key, a letter, a map, an heirloom.</p>
  </header>
  <%= render "characters/items/form", character: @character, item: @item %>
<% end %>
