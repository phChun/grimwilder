<%# locals: (character:, viewer:) %>
<%# The player's journal at this character's table (Journal), folded on the sheet: the latest page this viewer may read, and a New page form. The player sees their own; a GM sees the player's pages while they're shared, and adds pages of their own (a secret, a backstory), read only for the player unless unticked. Nobody else sees the card. %>
<% campaign = character.campaign %>
<% owner = campaign&.memberships&.find_by(identity_id: character.identity_id) %>
<% journal = owner&.journal %>
<% if journal&.readable_by?(viewer) %>
  <details id="journal" class="card sheet-fold" data-details-memory-target="section" data-section="character-<%= character.id %>-journal">
    <summary class="gm-fold__summary"><h2 class="card__title sheet-fold__title">Journal</h2><%= icon(:chevron, size: 18) %></summary>
    <% latest = journal.pages_for(viewer).first %>
    <% if latest %>
      <article class="journal-glance">
        <p class="journal-glance__title"><%= latest.heading %><% if latest.by_gm? %> <span class="journal-page__tag">From the GM</span><% end %> <span class="field__hint">· written <%= time_ago_in_words(latest.updated_at) %> ago</span></p>
        <p class="journal-glance__text"><%= chat_format(truncate(latest.body, length: 400, separator: " ")) %></p>
      </article>
    <% else %>
      <p class="empty">Nothing written yet.</p>
    <% end %>
    <% if viewer.gm? && !owner.journal_shared? %>
      <p class="field__hint"><%= owner.identity.display_name %> keeps their journal private: you see only the GM's pages.</p>
    <% end %>
    <section class="journal-glance__new" aria-labelledby="sheet_journal_new">
      <h3 id="sheet_journal_new" class="journal-glance__title">New page</h3>
      <%= render "campaigns/journals/form", journal: journal, page: JournalPage.new, viewer: viewer, character: character %>
    </section>
    <p class="sheet-fold__actions">
      <%= link_to "Open the journal", campaign_journal_path(campaign, owner), class: "button button--small button--ghost" %>
    </p>
  </details>
<% end %>
