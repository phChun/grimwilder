<%# locals: (character:, viewer:) %>
<%# The player's journal at this character's table (Journal), folded on the sheet: a New page button that opens its form in place, then the latest few pages this viewer may read, starred first, each with Edit. The player sees their own; a GM sees the player's pages while they're shared, and the GM's always (Character Secrets among them). Nobody else sees the card. %>
<% campaign = character.campaign %>
<% owner = campaign&.memberships&.find_by(identity_id: character.identity_id) %>
<% journal = owner&.journal %>
<% if journal&.readable_by?(viewer) %>
  <details id="journal" class="card sheet-fold" data-details-memory-target="section" data-section="character-<%= character.id %>-journal">
    <summary class="gm-fold__summary"><h2 class="card__title sheet-fold__title">Journal</h2><%= icon(:chevron, size: 18) %></summary>
    <%= render "campaigns/journals/new_button", journal: journal, character: character %>
    <hr class="journal__rule">
    <% pages = journal.pages_for(viewer).limit(5) %>
    <% if pages.any? %>
      <div class="journal-glance">
        <%= render partial: "campaigns/journals/page", collection: pages, as: :page, locals: { journal: journal, viewer: viewer, compact: true, character: character } %>
      </div>
    <% else %>
      <p class="empty">No pages yet.</p>
    <% end %>
    <% if viewer.gm? && !owner.journal_shared? %>
      <p class="field__hint"><%= owner.identity.display_name %> keeps their journal private: you see only the GM's pages.</p>
    <% end %>
    <p class="sheet-fold__actions">
      <%= link_to "See the whole journal", campaign_journal_path(campaign, owner), class: "button button--small button--ghost" %>
    </p>
  </details>
<% end %>
