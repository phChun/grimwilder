<% content_for :title, "#{@roll.name}: #{@roll.stat.capitalize}" %>

<header class="page-header">
  <p class="eyebrow"><%= link_to @character.name, character_path(@character) %></p>
  <h1><%= @roll.stat.capitalize %> <%= @roll.kind %> roll</h1>
  <p class="page-header__lede"><%= roll_setup(@roll) %></p>
</header>

<section class="panel roll-outcome" aria-label="Result">
  <div class="tray"><%= roll_dice_tags(@roll) %></div>
  <p class="tray__summary"><%= roll_summary(@roll) %></p>

  <div class="<%= class_names("result", "result--#{@roll.outcome}") %>">
    <h2 class="result__name"><%= @roll.outcome.capitalize %></h2>
    <p class="result__text"><%= roll_result_text(@roll) %></p>
    <% if @roll.critical? %>
      <div class="critical">
        <h3 class="critical__title">Critical</h3>
        <p>Pick one: <strong>Greater effect</strong> (drop 1d from the task pool before rolling), <strong>Secondary effect</strong> (gain another related perfect), or <strong>Setup</strong> (a riskless assist on a follow-up). If nothing comes to mind, take spark.</p>
        <% if @character.can_take_spark_for?(@roll) %>
          <%= button_to "Nothing fits: take spark", character_roll_critical_spark_path(@character, @roll), class: "button button--small critical__spark" %>
        <% elsif !@roll.spark_gained? && @character.spark >= Grimwild::MAX_SPARK %>
          <p class="field__hint"><%= @character.name %> already holds <%= Grimwild::MAX_SPARK %> spark.</p>
        <% end %>
      </div>
    <% end %>
    <% if (note = roll_spark_note(@roll)) %>
      <p class="roll-outcome__spark"><%= note %></p>
    <% end %>
  </div>
</section>

<p class="roll-next">
  <%= link_to "Roll #{@roll.stat.capitalize} again", new_character_roll_path(@character, stat: @roll.stat), class: "button button--primary" %>
  <%= link_to "Back to sheet", character_path(@character), class: "button" %>
  <% if @roll.campaign %><%= link_to "Table log", campaign_path(@roll.campaign, anchor: "roll-log"), class: "button button--quiet" %><% end %>
</p>
