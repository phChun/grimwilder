<% content_for :title, "#{@character.name}: #{@stat.capitalize}" %>
<% damage = @character.damage_reasons(@stat) %>

<header class="page-header">
  <p class="eyebrow"><%= link_to @character.name, character_path(@character) %></p>
  <h1>Roll <%= @stat.capitalize %></h1>
  <p class="page-header__lede">
    <%= @character.stat(@stat) %>d from <%= @stat.capitalize %><% if damage.any? %>, +<%= damage.size %>t from damage (<%= damage.to_sentence %>)<% end %>.
    <% if @character.campaign %>The whole table sees the roll in <%= link_to @character.campaign.name, campaign_path(@character.campaign) %>'s log.<% end %>
  </p>
</header>

<%= form_with url: character_rolls_path(@character), class: "panel roll-setup" do %>
  <input type="hidden" name="stat" value="<%= @stat %>">

  <fieldset class="segmented">
    <legend class="visually-hidden">Roll type</legend>
    <label class="segmented__option">
      <input type="radio" name="mode" value="action" checked>
      <span>Action</span>
    </label>
    <label class="segmented__option">
      <input type="radio" name="mode" value="defense">
      <span>Defense</span>
    </label>
  </fieldset>

  <fieldset class="roll-setup__group">
    <legend class="field__label">Spend spark <small>+1d each</small></legend>
    <% if @character.spark.zero? %>
      <p class="field__hint">No spark to spend. A disaster gives you some.</p>
    <% else %>
      <div class="segmented segmented--auto">
        <% (0..@character.spark).each do |amount| %>
          <label class="segmented__option">
            <%= radio_button_tag :spark, amount, amount.zero? %>
            <span><%= amount %></span>
          </label>
        <% end %>
      </div>
      <p class="field__hint"><%= @character.name %> holds <%= pluralize(@character.spark, "spark") %>.</p>
    <% end %>
  </fieldset>

  <div class="field">
    <label class="field__label" for="roll_help">Help <small>d6</small></label>
    <input type="number" id="roll_help" name="help" value="0" min="0" max="<%= Character::Rolling::MAX_EXTRA %>" inputmode="numeric" autocomplete="off" class="field__input roll-setup__number">
    <p class="field__hint">Extra dice from assists and talents.</p>
  </div>

  <div class="field">
    <label class="field__label" for="roll_thorns">Situational thorns <small>d8</small></label>
    <input type="number" id="roll_thorns" name="thorns" value="0" min="0" max="<%= Character::Rolling::MAX_EXTRA %>" inputmode="numeric" autocomplete="off" class="field__input roll-setup__number">
    <p class="field__hint">One per difficulty factor; typical play is 0–2.<% if damage.any? %> Damage thorns are already counted.<% end %></p>
  </div>

  <button type="submit" class="button button--primary">Roll</button>
<% end %>
