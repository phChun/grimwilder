<% content_for :title, @character.name %>
<% content_for :head do %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>
<%# The GM can mark harm here too; the owner's open sheet refreshes when they do. %>
<%= turbo_stream_from @character %>
<% editable = @character.owned_by?(Current.identity) %>
<% tends = can_change_damage?(@character) %>
<% campaign = @character.campaign %>
<% short = @character.short_name %>

<%# The character view: the sheet, plus (for a seated character) the table's rail beside it. Everyone who can see the sheet sees the same page; only the owner gets the controls. %>
<div class="<%= class_names("fluid", "play-view", "play-view--solo": !campaign) %>" data-controller="details-memory" data-details-memory-campaign-value="<%= campaign&.id %>" data-action="toggle->details-memory#toggled:capture turbo:morph@document->details-memory#restore">
  <div class="fluid__main sheet">
    <section class="identity" aria-labelledby="sheet-name">
      <span class="monogram monogram--76" aria-hidden="true"><%= initial(short) %></span>
      <div class="identity__who">
        <h1 id="sheet-name" class="identity__name"><%= @character.name %></h1>
        <p class="identity__line">
          <%= @character.path %> <%= @character.level %><% @character.backgrounds.each do |background| %> · <%= background["name"] %><% end %><% if @character.features.any? %> · <em><%= @character.features.to_sentence %></em><% end %>
          <% unless editable %> · played by <%= @character.identity.display_name %><% end %>
        </p>
      </div>

      <div class="identity__meta">
        <div class="meter">
          <span class="meter__label">Spark</span>
          <%= render "shared/pips", kind: "spark", value: @character.spark, max: Grimwild::MAX_SPARK %>
        </div>
        <div class="meter">
          <span class="meter__label">Thread</span>
          <%= render "shared/pips", kind: "thread", value: @character.thread, max: @character.session_thread %>
        </div>
        <div class="meter">
          <span class="meter__label">XP</span>
          <% if @character.max_level? %>
            <span class="meter__count" aria-label="Level <%= Grimwild::MAX_LEVEL %>, the top">Max</span>
          <% else %>
            <span class="meter__count" aria-label="<%= @character.xp %> of <%= @character.xp_to_next_level %> XP to level <%= @character.level + 1 %>"><%= @character.xp %><span class="meter__of">/<%= @character.xp_to_next_level %></span></span>
          <% end %>
        </div>

        <% if editable %>
          <details class="adjust">
            <summary class="button button--ghost adjust__toggle">Adjust</summary>
            <div class="adjust__panel">
              <% { "spark" => [ Grimwild::MAX_SPARK, "Spend before a roll for +1d each. Hold up to #{Grimwild::MAX_SPARK}." ], "thread" => [ @character.session_thread, "Spend to add a story detail. Resets to #{@character.session_thread} each session." ] }.each do |currency, (most, hint)| %>
                <% value = @character.public_send(currency) %>
                <div class="adjust__row">
                  <span class="adjust__name"><%= currency.capitalize %></span>
                  <%= button_to "−", character_path(@character), method: :patch, params: { quick: 1, character: { currency => value - 1 } }, class: "stepper__step", disabled: value.zero?, "aria-label": "Spend #{currency}" %>
                  <span class="adjust__value"><%= value %></span>
                  <%= button_to "+", character_path(@character), method: :patch, params: { quick: 1, character: { currency => value + 1 } }, class: "stepper__step", disabled: value >= most, "aria-label": "Take #{currency}" %>
                  <p class="adjust__hint"><%= hint %></p>
                </div>
              <% end %>
              <% unless @character.max_level? %>
                <div class="adjust__row">
                  <span class="adjust__name">XP</span>
                  <%= button_to "+1 XP", character_experience_path(@character), class: "button" %>
                  <p class="adjust__hint">Take 1 XP after each session. <%= @character.xp_to_next_level %> fills level <%= @character.level + 1 %>.</p>
                </div>
              <% end %>
              <%= link_to "Edit sheet", edit_character_path(@character), class: "button button--ghost" %>
            </div>
          </details>
        <% end %>
      </div>
    </section>

    <% if @character.errors.any? %>
      <p class="flash flash--alert"><%= @character.errors.full_messages.to_sentence %></p>
    <% end %>

    <section id="stats" class="stat-grid" aria-label="Stats">
      <% Grimwild.stats.each do |stat, description| %>
        <article class="<%= class_names("stat-card", "stat-card--marked": @character.marked?(stat)) %>">
          <div class="stat-card__head">
            <h2 class="stat-card__name"><%= stat.capitalize %></h2>
            <% if @character.marked?(stat) %><span class="tag tag--marked">Marked</span><% end %>
            <span class="stat-card__dice"><%= @character.stat(stat) %>d</span>
          </div>
          <p class="stat-card__desc"><%= description %></p>
          <% if editable %>
            <%= render "characters/roll_form", character: @character, stat: stat, allies: @allies %>
          <% end %>
        </article>
      <% end %>
    </section>

    <div class="sheet__row">
      <% if @last_roll %>
        <%= render "characters/last_roll", character: @character, roll: @last_roll, editable: editable %>
      <% end %>

      <section id="damage" class="card harm" aria-labelledby="sheet-harm">
        <h2 id="sheet-harm" class="card__title">Harm</h2>
        <div class="harm__toggles">
          <% { "bloodied" => "+1t to Brawn and Agility", "rattled" => "+1t to Wits and Presence", "desperate" => "+1t to every roll; more harm drops you" }.each do |harm, effect| %>
            <% on = @character.public_send(:"#{harm}?") %>
            <% if tends %>
              <%= button_to harm.capitalize, character_damage_path(@character), method: :patch, params: { character: { harm => !on } }, class: "harm-toggle", "aria-pressed": on.to_s, title: effect %>
            <% else %>
              <span class="<%= class_names("harm-toggle", "harm-toggle--on": on) %>"><%= harm.capitalize %><span class="visually-hidden"><%= on ? ": yes" : ": no" %></span></span>
            <% end %>
          <% end %>
        </div>

        <div class="harm__marks">
          <span class="harm__label">Marks</span>
          <% Grimwild::STATS.each do |stat| %>
            <% marked = @character.marked?(stat) %>
            <% if tends %>
              <%= button_to stat.capitalize, character_damage_path(@character), method: :patch, params: { character: { "marked_#{stat}" => !marked } }, class: "mark-toggle", "aria-pressed": marked.to_s, title: "A mark adds +1t to the next roll with this stat, then clears" %>
            <% elsif marked %>
              <span class="mark-toggle mark-toggle--on"><%= stat.capitalize %> marked</span>
            <% end %>
          <% end %>
        </div>

        <% if @character.conditions.any? %>
          <ul class="conditions">
            <% @character.conditions.each_with_index do |condition, index| %>
              <% size, pool_name = @character.condition_pool(condition) %>
              <li class="condition">
                <span class="condition__name"><%= size ? pool_name.capitalize : condition["name"] %><% if condition["lasts"] == "scene" %> <span class="tag">clears after scene</span><% end %></span>
                <% if size %><span class="condition__size"><%= size %>d</span><% end %>
                <% if tends %>
                  <% if size&.positive? %>
                    <%= button_to "Roll", character_condition_roll_path(@character, index), class: "button button--small", "aria-label": "Roll #{condition["name"]}" %>
                  <% end %>
                  <%= button_to "Clear", character_condition_path(@character, index), method: :delete, class: "button button--ghost button--small", "aria-label": "Clear #{condition["name"]}" %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>

        <% if tends %>
          <%= form_with url: character_conditions_path(@character), class: "condition-form" do |form| %>
            <%= form.text_field :condition, placeholder: "4d poisoned, broken arm…", autocomplete: "off", class: "field__input", "aria-label": "New condition" %>
            <label class="check">
              <%= check_box_tag :lasts, "scene", false, id: "condition_lasts" %>
              Clears after scene
            </label>
            <%= form.submit "Add condition", class: "button button--small" %>
          <% end %>
        <% end %>

        <% if @character.harm_changed_by_someone_else? %>
          <p class="harm__changed"><%= harm_change_line(@character) %></p>
        <% end %>
      </section>
    </div>

    <div class="sheet__row sheet__row--even">
      <section class="card" aria-labelledby="sheet-who">
        <h2 id="sheet-who" class="card__title">Who <%= short %> is</h2>
        <dl class="facts">
          <div>
            <dt>Backgrounds</dt>
            <dd><%= @character.backgrounds.pluck("name").join(" · ").presence || "—" %></dd>
          </div>
          <div>
            <dt>Wises</dt>
            <dd><%= @character.backgrounds.flat_map { _1["wises"] }.join(", ").presence || "—" %></dd>
          </div>
          <div>
            <dt>Traits</dt>
            <dd><%= @character.traits.join(" and ").presence || "—" %><% if @character.not_trait.present? %>, but not <%= @character.not_trait %><% end %></dd>
          </div>
          <div>
            <dt>Desires</dt>
            <dd><%= @character.desires.join(" and ").presence || "—" %><% if @character.not_desire.present? %>, but not <%= @character.not_desire %><% end %></dd>
          </div>
          <div>
            <dt>Carrying</dt>
            <dd><%= @character.weapons.presence || "—" %><% if @character.weapon_styles.any? %> (<%= @character.weapon_styles.join(", ") %>)<% end %></dd>
          </div>
          <div>
            <dt>Bonds</dt>
            <dd>
              <% if @character.bonds.any? %>
                <% @character.bonds.each do |bond| %>
                  <span class="facts__line"><%= bond["to"] %> · <%= bond["bond"].presence || "not set yet" %></span>
                <% end %>
              <% else %>
                —
              <% end %>
            </dd>
          </div>
        </dl>
      </section>

      <section id="talents" class="card" aria-labelledby="sheet-talents">
        <h2 id="sheet-talents" class="card__title">Talents &amp; arcs</h2>
        <% if (core = @character.core_talent_entry) %>
          <article class="talent-card">
            <div class="talent-card__head">
              <h3 class="talent-card__name"><%= core.name %></h3>
              <span class="talent-card__core">Core</span>
            </div>
            <% core.paragraphs.each do |paragraph| %><p class="talent-card__text"><%= paragraph %></p><% end %>
          </article>
        <% end %>
        <% @character.chosen_talents.each do |talent| %>
          <article class="talent-card">
            <div class="talent-card__head">
              <h3 class="talent-card__name"><%= talent.name %></h3>
              <span class="talent-card__source"><%= talent.group.path? ? talent.group.name : "Background" %> · pg. <%= talent.page %></span>
            </div>
            <% talent.paragraphs.each do |paragraph| %><p class="talent-card__text"><%= paragraph %></p><% end %>
            <% if talent.note.present? %><p class="talent-card__note"><%= talent.note %></p><% end %>
            <% if editable %>
              <%= button_to "Remove", character_talent_path(@character, talent.key), method: :delete, class: "button button--ghost button--small", "aria-label": "Remove #{talent.name}", form: { data: { turbo_confirm: "Remove #{talent.name}?" } } %>
            <% end %>
          </article>
        <% end %>
        <% if editable %>
          <% if @character.talents_to_choose.positive? %>
            <%= link_to "Pick a talent at level #{@character.level}", new_character_talent_path(@character), class: "talent-slot" %>
          <% else %>
            <%= link_to "Change talents", new_character_talent_path(@character), class: "button button--ghost button--small" %>
          <% end %>
        <% end %>

        <dl class="arcs">
          <div>
            <dt><%= @character.arcs.many? ? "My arcs" : "My arc" %></dt>
            <dd><%= @character.arcs.join("; ").presence || "none yet" %></dd>
          </div>
        </dl>

        <% if @character.talents.present? %>
          <div class="sheet-notes">
            <h3 class="sheet-notes__title">Talent notes</h3>
            <%= simple_format(@character.talents) %>
          </div>
        <% end %>
      </section>
    </div>

    <% if @character.use_counters.any? || @character.pool_uses.any? %>
      <%= render "characters/talent_uses", character: @character, can_spend: can_spend_talent_uses?(@character) %>
    <% end %>

    <% if @character.notes.present? %>
      <section class="card" aria-labelledby="sheet-notes">
        <h2 id="sheet-notes" class="card__title">Notes</h2>
        <div class="sheet-notes"><%= simple_format(@character.notes) %></div>
      </section>
    <% end %>
  </div>

  <% if campaign %>
    <%= render "campaigns/table_rail", campaign: campaign, membership: @membership, feed: @feed, speakers: @speakers, speaker: (@character if editable && @character.active?), suspense: true, quick_roll: ("#stats" if editable), classes: "fluid__rail" %>
  <% end %>
</div>
