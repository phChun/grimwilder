<% content_for :title, @character.name %>
<% content_for :head do %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>
<%# The GM can mark harm here too; the owner's open sheet refreshes when they do. %>
<%= turbo_stream_from @character %>
<% editable = @character.owned_by?(Current.identity) %>
<% tends = can_change_damage?(@character) %>
<% campaign = @character.campaign %>
<% short = @character.short_name %>

<%# The character view: the sheet, plus (for a seated character) the table's rail beside it. Everyone who can see the sheet sees the same page; only the owner gets the controls. %>
<div class="<%= class_names("fluid", "play-view", "play-view--solo": !campaign) %>" data-controller="details-memory" data-details-memory-campaign-value="<%= campaign&.id %>" data-action="toggle->details-memory#toggled:capture turbo:morph@document->details-memory#restore">
  <div class="fluid__main sheet">
    <section class="identity" aria-labelledby="sheet-name">
      <span class="monogram monogram--76" aria-hidden="true"><%= initial(short) %></span>
      <div class="identity__who">
        <h1 id="sheet-name" class="identity__name"><%= @character.name %></h1>
        <p class="identity__line">
          <%= @character.path %> <%= @character.level %><% @character.backgrounds.each do |background| %> · <%= background["name"] %><% end %><% if @character.features.any? %> · <em><%= @character.features.to_sentence %></em><% end %>
          <% unless editable %> · played by <%= @character.identity.display_name %><% end %>
        </p>
      </div>

      <div class="<%= class_names("identity__meta", "identity__meta--controls": editable) %>">
        <% if editable %>
          <%# The owner's spark, thread and XP: tap − or + right here. Everything else that changes the character is on the edit page. %>
          <% { "spark" => Grimwild::MAX_SPARK, "thread" => @character.session_thread }.each do |currency, most| %>
            <% value = @character.public_send(currency) %>
            <%= render "shared/tally", kind: currency, noun: currency, value: value, of: most,
              down: { url: character_path(@character), method: :patch, params: { quick: 1, character: { currency => value - 1 } }, disabled: value.zero?, label: "Spend #{currency}" },
              up: { url: character_path(@character), method: :patch, params: { quick: 1, character: { currency => value + 1 } }, disabled: value >= most, label: "Take #{currency}" } %>
          <% end %>
          <% if @character.max_level? %>
            <div class="meter">
              <span class="meter__label">XP</span>
              <span class="meter__count" aria-label="Level <%= Grimwild::MAX_LEVEL %>, the top">Max</span>
            </div>
          <% else %>
            <%# + goes through gain_xp!, so filling the boxes levels up and opens the talent picker. %>
            <%= render "shared/tally", kind: "xp", noun: "XP", group_label: "XP", value: @character.xp, of: @character.xp_to_next_level,
              down: { url: character_path(@character), method: :patch, params: { quick: 1, character: { xp: @character.xp - 1 } }, disabled: @character.xp.zero?, label: "Take back 1 XP" },
              up: { url: character_experience_path(@character), label: "Take 1 XP (#{@character.xp_to_next_level} fills level #{@character.level + 1})" } %>
          <% end %>
          <%= link_to "Edit sheet", edit_character_path(@character), class: "button button--ghost" %>
        <% else %>
          <div class="meter">
            <span class="meter__label">Spark</span>
            <%= render "shared/pips", kind: "spark", value: @character.spark, max: Grimwild::MAX_SPARK %>
          </div>
          <div class="meter">
            <span class="meter__label">Thread</span>
            <%= render "shared/pips", kind: "thread", value: @character.thread, max: @character.session_thread %>
          </div>
          <div class="meter">
            <span class="meter__label">XP</span>
            <% if @character.max_level? %>
              <span class="meter__count" aria-label="Level <%= Grimwild::MAX_LEVEL %>, the top">Max</span>
            <% else %>
              <span class="meter__count" aria-label="<%= @character.xp %> of <%= @character.xp_to_next_level %> XP to level <%= @character.level + 1 %>"><%= @character.xp %><span class="meter__of">/<%= @character.xp_to_next_level %></span></span>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

    <%# A done campaign's sheet is for reading (Character#in_play?); the owner can seat them somewhere new. %>
    <% if campaign&.done? && @character.active? %>
      <div class="claim-bar">
        <p class="claim-bar__text"><strong><%= campaign.name %> is done.</strong> <%= editable ? "Seat #{short} somewhere new to play them again." : "This sheet is for reading now." %></p>
        <% if editable %>
          <%= link_to "Move #{short}", edit_character_path(@character, anchor: "at-the-table"), class: "button button--ghost button--small" %>
        <% end %>
      </div>
    <% end %>

    <%# A fallen or retired character's sheet says so, with the player's farewell; the owner can bring them back. %>
    <% if @character.gone? %>
      <div class="<%= class_names("farewell-banner", "farewell-banner--fallen": @character.fallen?) %>">
        <div>
          <p class="farewell-banner__status"><strong><%= @character.status.capitalize %></strong><% if @character.status_changed_at %> · <%= l(@character.status_changed_at.to_date, format: :long) %><% end %></p>
          <% if @character.farewell.present? %><blockquote class="farewell-banner__words">“<%= @character.farewell %>”</blockquote><% end %>
          <p class="farewell-banner__hint"><%= short %> is out of the party, remembered under it<%= " on #{campaign.name}'s page" if campaign %>.</p>
        </div>
        <% if editable %>
          <%= button_to "Return #{short} to play", character_story_end_path(@character), method: :delete, class: "button button--small" %>
        <% end %>
      </div>
    <% end %>

    <%# Up for grabs (Character::Claiming): who holds it, and the way to pick it; a GM looking at someone else's can put it up for grabs. The owner gives theirs back from the edit page. %>
    <% if @character.up_for_grabs? %>
      <div class="claim-bar claim-bar--open">
        <p class="claim-bar__text"><strong>Up for grabs.</strong> <%= @character.claimable_by?(Current.identity) && !@membership&.gm? ? "Pick #{short} to play them: they become yours." : "Waiting for a player at the table to pick #{short}." %></p>
        <% if @character.claimable_by?(Current.identity) && !@membership&.gm? %>
          <%= button_to "Play #{short}", character_claim_path(@character), class: "button button--small button--primary" %>
        <% end %>
      </div>
    <% elsif @character.releasable_by?(Current.identity) && !editable %>
      <div class="claim-bar">
        <p class="claim-bar__text">Played by <%= @character.identity.display_name %>. Put <%= short %> up for grabs to let another player pick them.</p>
        <%= button_to "Put up for grabs", character_claim_path(@character), method: :delete, class: "button button--ghost button--small", form: { data: { turbo_confirm: "#{@character.name} goes back to the GM, for any player to pick. Continue?" } } %>
      </div>
    <% end %>

    <div class="sheet__top">
      <section id="stats" class="stat-grid" aria-label="Stats">
        <% Grimwild.stats.each do |stat, description| %>
          <article class="<%= class_names("stat-card", "stat-card--marked": @character.marked?(stat)) %>">
            <div class="stat-card__head">
              <h2 class="stat-card__name"><%= stat.capitalize %></h2>
              <% marked = @character.marked?(stat) %>
              <% if tends %>
                <%= button_to (marked ? "Marked" : "Mark"), character_damage_path(@character), method: :patch, params: { character: { "marked_#{stat}" => !marked } }, class: "mark-toggle stat-card__mark", "aria-pressed": marked.to_s, "aria-label": "Mark #{stat.capitalize}", title: "A mark adds +1t to the next roll with this stat, then clears. A second mark becomes harm.", form: { class: "stat-card__mark-form" } %>
              <% elsif marked %>
                <span class="tag tag--marked">Marked</span>
              <% end %>
              <span class="stat-card__dice"><%= @character.stat(stat) %>d</span>
            </div>
            <p class="stat-card__desc"><%= description %></p>
            <% if editable && @character.in_play? %>
              <%= render "characters/roll_form", character: @character, stat: stat, allies: @allies %>
            <% end %>
          </article>
        <% end %>
      </section>

      <section id="damage" class="card harm" aria-labelledby="sheet-harm">
        <h2 id="sheet-harm" class="card__title">Harm</h2>
        <div class="harm__toggles">
          <% { "bloodied" => "+1t to Brawn and Agility", "rattled" => "+1t to Wits and Presence", "desperate" => "+1t to every roll; more harm drops you" }.each do |harm, effect| %>
            <% on = @character.public_send(:"#{harm}?") %>
            <% if tends %>
              <%= button_to harm.capitalize, character_damage_path(@character), method: :patch, params: { character: { harm => !on } }, class: "harm-toggle", "aria-pressed": on.to_s, title: effect %>
            <% else %>
              <span class="<%= class_names("harm-toggle", "harm-toggle--on": on) %>"><%= harm.capitalize %><span class="visually-hidden"><%= on ? ": yes" : ": no" %></span></span>
            <% end %>
          <% end %>
        </div>
        <%# Flesh Wounds (pg. 58): when they'd be bloodied, a scene-long condition instead. %>
        <% if tends && !@character.bloodied? && @character.flesh_wounds? && !@character.flesh_wound? %>
          <%= button_to "Take a Flesh Wound instead", character_conditions_path(@character), params: { condition: Character::Damage::FLESH_WOUND, lasts: "scene" }, class: "button button--small harm__flesh-wound", title: "+1t on every roll until the scene ends; on a disaster, take the harm as normal" %>
        <% end %>
        <%# Desperate isn't death: more harm drops them, and a story roll says how bad (pg. 27). If that's the end, the owner gets a quiet way there. %>
        <% if editable && @character.desperate? && @character.in_play? && !@character.up_for_grabs? %>
          <div class="harm__end">
            <p class="harm__end-text">Down for good?</p>
            <%= link_to "#{short}'s story ends…", edit_character_path(@character, anchor: "story-ends"), class: "button button--danger button--small" %>
          </div>
        <% end %>

        <% if @character.conditions.any? %>
          <ul class="conditions">
            <% @character.conditions.each_with_index do |condition, index| %>
              <% size, pool_name = @character.condition_pool(condition) %>
              <li class="condition">
                <span class="condition__name"><%= size ? pool_name.capitalize : condition["name"] %><% if condition["lasts"] == "scene" %> <span class="tag">clears after scene</span><% end %></span>
                <% if size %><span class="condition__size"><%= size %>d</span><% end %>
                <% if tends %>
                  <% if size&.positive? && @character.in_play? %>
                    <%= button_to "Roll", character_condition_roll_path(@character, index), class: "button button--small", "aria-label": "Roll #{condition["name"]}" %>
                  <% end %>
                  <%= button_to "Clear", character_condition_path(@character, index), method: :delete, class: "button button--ghost button--small", "aria-label": "Clear #{condition["name"]}" %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>

        <% if tends %>
          <%= form_with url: character_conditions_path(@character), class: "condition-form" do |form| %>
            <span class="condition-form__dice" title="For a condition that runs down like a pool; leave blank for one that doesn't">
              <%= form.number_field :dice, min: 1, max: Character::Damage::CONDITION_MAX_DICE, placeholder: "–", inputmode: "numeric", autocomplete: "off", class: "field__input condition-form__count", "aria-label": "Dice (optional)" %>
              <span class="condition-form__d" aria-hidden="true">d</span>
            </span>
            <%= form.text_field :condition, placeholder: "poisoned, broken arm…", maxlength: 76, autocomplete: "off", class: "field__input", "aria-label": "New condition" %>
            <label class="check">
              <%= check_box_tag :lasts, "scene", false, id: "condition_lasts" %>
              Clears after scene
            </label>
            <%= form.submit "Add condition", class: "button button--small" %>
          <% end %>
        <% end %>

        <% if @character.harm_changed_by_someone_else? %>
          <p class="harm__changed"><%= harm_change_line(@character) %></p>
        <% end %>
      </section>
    </div>

    <section id="talents" class="card" aria-labelledby="sheet-talents" data-controller="talent-uses">
      <div class="talents__head">
        <h2 id="sheet-talents" class="card__title">Talents</h2>
        <% if editable %>
          <%= link_to "Edit talents", new_character_talent_path(@character), class: "button button--small" %>
        <% end %>
      </div>
      <% talent_pools = @character.talent_pools.includes(:campaign).to_a %>
      <%# The core talent on its own, then the rest in a grid of matching heights. %>
      <% core, chosen = @character.talent_entries.partition(&:core?) %>
      <% core.each do |talent| %>
        <%= render "characters/talent", talent: talent, character: @character, editable: editable, tends: tends, pools: talent_pools %>
      <% end %>
      <% if chosen.any? %>
        <div class="talent-list">
          <% chosen.each do |talent| %>
            <%= render "characters/talent", talent: talent, character: @character, editable: editable, tends: tends, pools: talent_pools %>
          <% end %>
        </div>
      <% end %>
      <% if tends && @character.use_counters.any? %>
        <label class="check use-note">
          <input type="checkbox" data-talent-uses-target="note" data-action="talent-uses#remember">
          Post to the table log when spending
        </label>
      <% end %>
      <% if editable && @character.talents_to_choose.positive? %>
        <%= link_to "Pick a talent at level #{@character.level}", new_character_talent_path(@character), class: "talent-slot" %>
      <% end %>
      <%# A warlock's Eldritch Talents (Pact): their own slots, on top of the one per level. %>
      <% if @character.eldritch_talents? %>
        <div class="eldritch">
          <div class="talents__head">
            <h3 class="eldritch__title">Eldritch Talents <span class="eldritch__count"><%= @character.eldritch_talent_keys.size %> of <%= @character.eldritch_talent_slots %></span></h3>
            <% if editable %>
              <%= link_to "Choose", new_character_talent_path(@character, eldritch: 1), class: "button button--small" %>
            <% end %>
          </div>
          <p class="field__hint">Gifts from your patron, on top of your own talents, with one more at levels 3 and 6. Given time to commune, you can change one: remove it, pick another and roll your Patience pool.</p>
          <% if @character.eldritch_talent_keys.any? %>
            <div class="talent-list">
              <% @character.eldritch_talent_entries.each do |talent| %>
                <%= render "characters/talent", talent: talent, character: @character, editable: editable, tends: tends, pools: talent_pools, eldritch: true %>
              <% end %>
            </div>
          <% end %>
          <% if editable && @character.eldritch_talents_to_choose.positive? %>
            <%= link_to "Pick #{@character.eldritch_talents_to_choose == 1 ? "an Eldritch Talent" : "#{@character.eldritch_talents_to_choose} Eldritch Talents"}", new_character_talent_path(@character, eldritch: 1), class: "talent-slot" %>
          <% end %>
          <% if editable && @character.extra_eldritch_talents.positive? %>
            <p class="talent-over">Level <%= @character.level %> has room for <%= pluralize(@character.eldritch_talent_slots, "Eldritch Talent") %>. Remove <%= @character.extra_eldritch_talents == 1 ? "one" : @character.extra_eldritch_talents %> from its ⋯ menu.</p>
          <% end %>
        </div>
      <% end %>

      <% if editable && @character.extra_talents.positive? %>
        <p class="talent-over">Level <%= @character.level %> has room for <%= pluralize(@character.expected_talent_count, "talent") %> besides <%= @character.core_talent %>. Remove <%= @character.extra_talents == 1 ? "one" : @character.extra_talents %> from its ⋯ menu.</p>
      <% end %>

      <% if @character.talents.present? %>
        <div class="sheet-notes">
          <h3 class="sheet-notes__title">Talent notes</h3>
          <%= simple_format(@character.talents) %>
        </div>
      <% end %>
    </section>

    <%= render "characters/arcana", character: @character, tends: tends, pools: talent_pools %>

    <section class="card" aria-labelledby="sheet-who">
      <h2 id="sheet-who" class="card__title">Who <%= short %> is</h2>
      <%# Each fact that can hold several things is a list, title-cased (the book's lists are lowercase; what's stored isn't changed). Names (bonds' characters) and the weapons line are shown as written. %>
      <% wises = @character.backgrounds.flat_map { _1["wises"].to_a }.compact_blank %>
      <dl class="facts">
        <div>
          <dt>Backgrounds</dt>
          <dd><% if @character.backgrounds.any? %><ul class="facts__list"><% @character.backgrounds.each do |background| %><li><%= title_case(background["name"]) %></li><% end %></ul><% else %>—<% end %></dd>
        </div>
        <div>
          <dt>Wises</dt>
          <dd><% if wises.any? %><ul class="facts__list"><% wises.each do |wise| %><li><%= title_case(wise) %></li><% end %></ul><% else %>—<% end %></dd>
        </div>
        <div>
          <dt>Traits</dt>
          <dd>
            <% if @character.traits.any? || @character.not_trait.present? %>
              <ul class="facts__list">
                <% @character.traits.each do |trait| %><li><%= title_case(trait) %></li><% end %>
                <% if @character.not_trait.present? %><li class="facts__not"><span class="facts__but">But not</span> <%= title_case(@character.not_trait) %></li><% end %>
              </ul>
            <% else %>
              —
            <% end %>
          </dd>
        </div>
        <div>
          <dt>Desires</dt>
          <dd>
            <% if @character.desires.any? || @character.not_desire.present? %>
              <ul class="facts__list">
                <% @character.desires.each do |desire| %><li><%= title_case(desire) %></li><% end %>
                <% if @character.not_desire.present? %><li class="facts__not"><span class="facts__but">But not</span> <%= title_case(@character.not_desire) %></li><% end %>
              </ul>
            <% else %>
              —
            <% end %>
          </dd>
        </div>
        <div>
          <dt>Carrying</dt>
          <dd>
            <%= @character.weapons.presence || "—" %>
            <% if @character.weapon_styles.any? %>
              <ul class="facts__list"><% @character.weapon_styles.each do |style| %><li><%= title_case(style) %></li><% end %></ul>
            <% end %>
          </dd>
        </div>
        <div>
          <dt>Bonds</dt>
          <dd>
            <%# Everyone at the table (by their name now), then bonds to anyone else. %>
            <% party = @character.bond_party.to_a %>
            <% bond_lines = party.map { |other| [ other.name, @character.bond_for(other)&.dig("bond") ] } + @character.bonds_beyond(party).map { [ _1["to"], _1["bond"] ] } %>
            <% if bond_lines.any? %>
              <ul class="facts__list"><% bond_lines.each do |to, bond| %><li><%= to %> · <%= bond.present? ? title_case(bond) : "not set yet" %></li><% end %></ul>
            <% else %>
              —
            <% end %>
          </dd>
        </div>
        <div>
          <dt><%= @character.arcs.many? ? "Arcs" : "Arc" %></dt>
          <dd>
            <% if @character.arcs.any? %>
              <ul class="facts__list"><% @character.arcs.each do |arc| %><li class="facts__arc"><%= title_case(arc) %></li><% end %></ul>
            <% else %>
              none yet
            <% end %>
          </dd>
        </div>
      </dl>
    </section>

    <% if @character.notes.present? %>
      <section class="card" aria-labelledby="sheet-notes">
        <h2 id="sheet-notes" class="card__title">Notes</h2>
        <div class="sheet-notes"><%= simple_format(@character.notes) %></div>
      </section>
    <% end %>
  </div>

  <% if campaign %>
    <%= render "campaigns/table_rail", campaign: campaign, membership: @membership, feed: @feed, speakers: @speakers, speaker: (@character if editable && @character.active?), suspense: true, quick_roll: ("#stats" if editable), classes: "fluid__rail" %>
  <% end %>
</div>
