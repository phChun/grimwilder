<%# locals: (character:, roll:, editable:) %>
<%# The sheet's newest action or defense roll, shown right where it was made. Its only follow-up is the one the rules allow after the roll: taking spark for a critical where nothing fits. Spark and assists go in before a roll (pg. 12–13), so there's no reroll. %>
<section id="last-roll" class="<%= class_names("last-roll", "last-roll--#{roll_result_tier(roll)}") %>" aria-labelledby="last-roll-title" aria-live="polite">
  <h2 id="last-roll-title" class="last-roll__title"><%= last_roll_heading(roll) %></h2>

  <%= render "shared/roll_result", roll: roll, detail: roll_result_text(roll) %>

  <p class="last-roll__setup"><%= roll_setup(roll) %></p>

  <% if roll.critical? %>
    <div class="critical">
      <p>Pick one: <strong>Greater effect</strong> (drop 1d from the task pool before rolling), <strong>Secondary effect</strong> (gain another related perfect), or <strong>Setup</strong> (a riskless assist on a follow-up). If nothing comes to mind, take spark.</p>
      <% if editable && character.can_take_spark_for?(roll) %>
        <%= button_to "Nothing fits: take spark", character_roll_critical_spark_path(character, roll), class: "button critical__spark" %>
      <% elsif !roll.spark_gained? && character.spark >= Grimwild::MAX_SPARK %>
        <p class="last-roll__note"><%= character.name %> already holds <%= Grimwild::MAX_SPARK %> spark.</p>
      <% end %>
    </div>
  <% end %>
  <% if roll.assists.any? && roll.outcome != "perfect" %>
    <p class="last-roll__note"><%= roll.assists.pluck("name").to_sentence %> assisted, so the impact move can hit them too.</p>
  <% end %>
  <% if (note = roll_spark_note(roll)) %>
    <p class="last-roll__note last-roll__note--spark"><%= note %></p>
  <% end %>
</section>
