<%# locals: (character:, roll:, editable:) %>
<%# The roll just made from the sheet, as a toast that goes after ROLL_TOAST_SECONDS (toast_controller.js; hovering or focusing it holds it). A critical still waiting on "Nothing fits: take spark" stays until it's closed. Spark and assists go in before a roll (pg. 12–13), so there's no reroll. %>
<aside id="roll-toast" class="<%= class_names("roll-toast", "roll-toast--#{roll_result_tier(roll)}") %>" role="status" aria-labelledby="roll-toast-title" data-controller="toast" data-toast-key-value="<%= roll_toast_key(roll) %>" data-toast-seconds-value="<%= roll_toast_seconds_left(roll) %>" data-toast-sticky-value="<%= roll_toast_sticky?(character, roll, editable) %>" data-action="mouseenter->toast#pause mouseleave->toast#resume focusin->toast#pause focusout->toast#resume turbo:morph@document->toast#sync">
  <div class="roll-toast__head">
    <h2 id="roll-toast-title" class="roll-toast__title"><%= roll_toast_heading(roll) %></h2>
    <button type="button" class="roll-toast__close" aria-label="Close" data-action="toast#close"><%= icon(:close, size: 18) %></button>
  </div>

  <%= render "shared/roll_result", roll: roll, detail: roll_result_text(roll) %>

  <p class="roll-toast__setup"><%= roll_setup(roll) %></p>

  <% if roll.critical? %>
    <div class="critical">
      <p>Pick one: <strong>Greater effect</strong> (drop 1d from the task pool before rolling), <strong>Secondary effect</strong> (gain another related perfect), or <strong>Setup</strong> (a riskless assist on a follow-up). If nothing comes to mind, take spark.</p>
      <% if editable && character.can_take_spark_for?(roll) %>
        <%= button_to "Nothing fits: take spark", character_roll_critical_spark_path(character, roll), class: "button critical__spark" %>
      <% elsif !roll.spark_gained? && character.spark >= Grimwild::MAX_SPARK %>
        <p class="roll-toast__note"><%= character.name %> already holds <%= Grimwild::MAX_SPARK %> spark.</p>
      <% end %>
    </div>
  <% end %>
  <% if roll.assists.any? && roll.outcome != "perfect" %>
    <p class="roll-toast__note"><%= roll.assists.pluck("name").to_sentence %> assisted, so the impact move can hit them too.</p>
  <% end %>
  <% if (note = roll_spark_note(roll)) %>
    <p class="roll-toast__note roll-toast__note--spark"><%= note %></p>
  <% end %>
</aside>
