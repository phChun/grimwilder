<section class="hero">
  <p class="eyebrow">A play toolkit for Grimwild: Community Edition</p>
  <h1 class="hero__title">Grimwilder</h1>
  <p class="hero__lede">
    Everything you reach for at the table, without the page-flipping: roll stat dice against thorns,
    track diminishing pools, smash crucibles together, and keep your adventurers close at hand.
  </p>
  <div class="hero__actions">
    <%= link_to "Make an action roll", roll_path, class: "button button--primary" %>
  </div>
</section>

<section class="tool-grid" aria-labelledby="tools-heading">
  <h2 id="tools-heading" class="section-title">The toolkit</h2>

  <ul class="tool-grid__list">
    <li>
      <%= link_to roll_path, class: "tool-card tool-card--ready" do %>
        <span class="tool-card__glyph" aria-hidden="true">d6</span>
        <span class="tool-card__name">Action roll</span>
        <span class="tool-card__desc">Stat dice against thorns. Reads the highest die, applies cuts, calls criticals.</span>
      <% end %>
    </li>
    <li>
      <div class="tool-card">
        <span class="tool-card__glyph" aria-hidden="true">4d</span>
        <span class="tool-card__name">Pools</span>
        <span class="tool-card__desc">Task, pressure, timer and resource pools for your campaign. Roll them, drop the 1–3s, watch them run out.</span>
      </div>
    </li>
    <li>
      <div class="tool-card">
        <span class="tool-card__glyph" aria-hidden="true">6&times;6</span>
        <span class="tool-card__name">Crucibles</span>
        <span class="tool-card__desc">Roll 2d6 on the book's tables and smash the results together for NPCs, sites and settlements.</span>
      </div>
    </li>
    <li>
      <div class="tool-card">
        <span class="tool-card__glyph" aria-hidden="true">&#9776;</span>
        <span class="tool-card__name">Characters</span>
        <span class="tool-card__desc">Stats, damage, spark, bonds and talents on a sheet that rolls for you.</span>
      </div>
    </li>
  </ul>
</section>
