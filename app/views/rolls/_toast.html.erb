<%# locals: (roll:) %>
<%# The roll you just made, of any kind, as a toast on whatever page you land on (the layout renders it from RollsHelper#toast_roll). toast_controller.js hides it after ROLL_TOAST_SECONDS; hovering or focusing it holds it. A critical still waiting on "Nothing fits: take spark" stays until it's closed. Spark and assists go in before a roll (pg. 12–13); talents that change a roll after it's made (Luck, Blessed, an ally's Inspiration) are behind "After the roll…" (Roll::FollowUps). %>
<aside id="roll-toast" class="<%= class_names("roll-toast", "roll-toast--#{roll_result_tier(roll)}": roll.outcome) %>" role="status" aria-labelledby="roll-toast-title" data-controller="toast" data-toast-key-value="<%= roll_toast_key(roll) %>" data-toast-seconds-value="<%= roll_toast_seconds_left(roll) %>" data-toast-sticky-value="<%= roll_toast_sticky?(roll) %>" data-action="mouseenter->toast#pause mouseleave->toast#resume focusin->toast#pause focusout->toast#resume turbo:morph@document->toast#sync">
  <div class="roll-toast__head">
    <h2 id="roll-toast-title" class="roll-toast__title"><%= roll_toast_heading(roll) %></h2>
    <button type="button" class="roll-toast__close" aria-label="Close" data-action="toast#close"><%= icon(:close, size: 18) %></button>
  </div>

  <% if roll.question %>
    <p class="roll-toast__question"><%= roll.quarrel? ? "Stakes: #{roll.question}" : roll.question %></p>
  <% end %>

  <% if roll.quarrel? || roll.montage? %>
    <%= render "rolls/sides", roll: roll %>
  <% elsif roll.pool? && roll.outcome.nil? %>
    <div class="roll-toast__pool">
      <div class="roll-result__dice"><%= roll_dice_tags(roll, size: 32) %></div>
      <% if roll.dropped %><span class="feed-pool__change"><%= roll.remaining + roll.dropped.to_i %>d → <strong><%= roll.remaining %>d</strong></span><% end %>
    </div>
    <p class="roll-toast__setup"><%= pool_roll_summary(roll) %></p>
  <% else %>
    <%= render "shared/roll_result", roll: roll, detail: (roll_result_text(roll) unless roll.pool?) %>
    <p class="roll-toast__setup"><%= roll.pool? ? pool_roll_summary(roll) : roll_setup(roll) %></p>

    <% if roll.critical? && (roll.action? || roll.defense?) %>
      <div class="critical">
        <%= render "shared/critical_choices" %>
        <% if roll_toast_sticky?(roll) %>
          <%= button_to "Nothing fits: take spark", character_roll_critical_spark_path(roll.character, roll), class: "button critical__spark" %>
        <% elsif !roll.spark_gained? && roll.character && roll.character.spark >= Grimwild::MAX_SPARK %>
          <p class="roll-toast__note"><%= roll.character.name %> already holds <%= Grimwild::MAX_SPARK %> spark.</p>
        <% end %>
      </div>
    <% end %>
    <% if roll_follow_ups_offered?(roll) %>
      <p class="roll-toast__follow-up"><%= link_to "After the roll…", new_campaign_roll_follow_up_path(roll.campaign, roll), class: "button button--small", data: { turbo_frame: "modal" } %></p>
    <% end %>
    <% if roll.assists.any? && roll.outcome != "perfect" %>
      <p class="roll-toast__note"><%= roll.assists.pluck("name").to_sentence %> assisted, so the impact move can hit them too.</p>
    <% end %>
    <% if (note = roll_spark_note(roll)) %>
      <p class="roll-toast__note roll-toast__note--spark"><%= note %></p>
    <% end %>
  <% end %>
</aside>
