<% content_for :preheader, "Your account is ready on the #{@identity.current_plan.name} plan. Sign in with an emailed code." %>
<% content_for :footer do %>You're getting this because you asked to try Grimwilder. If you didn't, you can ignore it.<br><% end %>

<%# A roll to open on: three d6s, highest counts, and it's a 6. The word goes next to the color, as everywhere. %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 28px;">
  <tr>
    <% [ 2, 4 ].each do |face| %>
      <td style="padding-right: 8px;">
        <div style="width: 40px; height: 40px; line-height: 40px; text-align: center; border: 1px solid #4a4536; border-radius: 8px; background-color: #27241d; color: #8f8774; font-family: Menlo, Consolas, monospace; font-size: 18px;"><%= face %></div>
      </td>
    <% end %>
    <td style="padding-right: 14px;">
      <div style="width: 40px; height: 40px; line-height: 40px; text-align: center; border: 2px solid #9cc47a; border-radius: 8px; background-color: #1f2a18; color: #9cc47a; font-family: Menlo, Consolas, monospace; font-size: 20px; font-weight: bold;">6</div>
    </td>
    <td style="font-family: Georgia, 'Times New Roman', serif; font-size: 20px; color: #9cc47a; font-style: italic;">Perfect</td>
  </tr>
</table>

<h1 class="night-title" style="margin: 0 0 12px; font-family: Georgia, 'Times New Roman', serif; font-size: 30px; line-height: 1.2; font-weight: normal; color: #eee7d6;">Your seat at the table is ready</h1>

<p style="margin: 0 0 20px;">You asked to try it, and your account is open on the
  <span style="display: inline-block; padding: 1px 10px; border: 1px solid #5a3a26; border-radius: 999px; background-color: #2a1d14; color: #f0a274; font-size: 13px; white-space: nowrap;"><%= @identity.current_plan.name %></span> plan.</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 12px;">
  <tr>
    <td bgcolor="#e8834a" style="border-radius: 10px; background-color: #e8834a;">
      <a href="<%= new_session_url %>" style="display: inline-block; padding: 13px 28px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 16px; font-weight: bold; color: #1b120b; text-decoration: none; border-radius: 10px;">Sign in to Grimwilder</a>
    </td>
  </tr>
</table>
<p style="margin: 0 0 32px; font-size: 13px; color: #b0a791;">Use <strong style="color: #eee7d6;"><%= @identity.email_address %></strong>. We email you a code each time, so there's no password to remember.</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top: 1px solid #383428;">
  <tr><td colspan="2" style="padding: 20px 0 6px; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #8f8774;">What's waiting</td></tr>
  <% [
    [ "#e6b450", "50%", "Run a campaign", "Invite your players with a link, then run the table: scenes, pools, suspense and crucibles." ],
    [ "#8fc0e8", "2px", "Make a character", "A sheet that tracks spark, thread, marks and harm, and rolls for you." ],
    [ "#b88ce6", "2px", "Roll together", "Every roll lands in the table's log as it happens, so everyone sees the dice." ]
  ].each do |color, radius, title, text| %>
    <tr>
      <td width="22" valign="top" style="padding: 12px 0 0;">
        <div style="width: 10px; height: 10px; margin-top: 5px; background-color: <%= color %>; border-radius: <%= radius %>;<%= " transform: rotate(45deg);" unless radius == "50%" %>"></div>
      </td>
      <td style="padding: 8px 0 4px;">
        <strong style="color: #eee7d6; font-weight: 600;"><%= title %></strong><br>
        <span style="color: #b0a791; font-size: 14px;"><%= text %></span>
      </td>
    </tr>
  <% end %>
</table>
