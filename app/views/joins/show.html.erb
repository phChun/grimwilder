<% content_for :title, "Join #{@campaign.name}" %>

<div class="auth">
  <header class="page-header">
    <p class="eyebrow">You're invited</p>
    <h1><%= @campaign.name %></h1>
    <p class="page-header__lede">
      <% if (gm = @campaign.gms.first) %>Run by <%= gm.display_name %>. <% end %>Join to sit at this table as a player.
    </p>
  </header>

  <section class="panel auth__panel stack">
    <% if @membership %>
      <p>You're already at this table.</p>
      <%= link_to "Open campaign", campaign_path(@campaign), class: "button button--primary button--wide" %>
    <% elsif @blocked %>
      <p>The GM has blocked you from <%= @campaign.name %>, so this link won't let you in.</p>
      <%= link_to "Your campaigns", campaigns_path, class: "button button--wide" %>
    <% elsif @campaign.done? %>
      <p><%= @campaign.name %> is done, so no one can join it now.</p>
    <% elsif @no_room %>
      <p><%= Current.identity.plan_limit_message(:player) %> Then come back to this link.</p>
      <%= link_to "Your campaigns", campaigns_path, class: "button button--wide" %>
    <% elsif authenticated? %>
      <%= button_to "Join as #{Current.identity.display_name}", join_path(@campaign.join_code), class: "button button--primary button--wide" %>
    <% else %>
      <%= link_to "Sign in to join", new_session_path, class: "button button--primary button--wide" %>
      <p class="field__hint">New to Grimwilder? Signing in with your email creates your account.</p>
    <% end %>
  </section>
</div>
