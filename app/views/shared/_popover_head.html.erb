<%# locals: (title:, list: nil) %>
<%# The top row of a floating <details> panel: its title, and the ✕ that closes it. In a <ul> menu pass list: true, so it's a <li>. %>
<% if list %>
  <li class="popover__head"><span class="popover__title"><%= title %></span><%= render "shared/close_button" %></li>
<% else %>
  <div class="popover__head"><span class="popover__title"><%= title %></span><%= render "shared/close_button" %></div>
<% end %>
