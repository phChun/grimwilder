<%# locals: (label: nil, action: nil, css: nil) %>
<%# The ✕ that closes a popover or modal. With no action it closes the <details> it's in (dismiss_controller.js); a dialog passes its own controller's action. %>
<% label ||= "Close" %>
<% if action %>
  <button type="button" class="<%= class_names("close-button", css) %>" aria-label="<%= label %>" data-action="<%= action %>"><%= icon(:close, size: 18) %></button>
<% else %>
  <button type="button" class="<%= class_names("close-button", css) %>" aria-label="<%= label %>" data-controller="dismiss" data-action="dismiss#close"><%= icon(:close, size: 18) %></button>
<% end %>
