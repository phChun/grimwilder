<%# Toasts at the top center of the screen, so they're seen wherever the page is scrolled, stacking if there's more than one: the roll you just made (rolls/_toast), news like a pool removed (flash[:toast]), and failures: an alert flash, a form sent back to fix (422), or (from toasts_controller.js) a save that couldn't reach the server. Each small toast is data-turbo-permanent with its own id, so a morph refresh neither wipes it nor stops a newer one arriving. %>
<% message = alert.presence || ("That didn't save. Check the form for what to fix." if response.status == 422) %>
<div id="toasts" class="toasts" data-controller="toasts" data-action="turbo:fetch-request-error@document->toasts#unreachable toasts:show@document->toasts#announce turbo:before-cache@document->toasts#clear">
  <% if toast_roll %>
    <%= render "rolls/toast", roll: toast_roll %>
  <% end %>
  <% if flash[:toast].present? %>
    <%= render "shared/toast", message: flash[:toast], tone: :notice %>
  <% end %>
  <% if message %>
    <%= render "shared/toast", message: message %>
  <% end %>
  <template data-toasts-target="template"><%= render "shared/toast", message: "" %></template>
</div>
