<%# locals: (message:) %>
<%# One failure toast (see shared/_toasts). toast_controller.js hides and removes it after FAILURE_TOAST_SECONDS; hovering or focusing it holds it. %>
<% key = SecureRandom.hex(6) %>
<div id="toast-<%= key %>" class="toast" role="alert" data-turbo-permanent data-controller="toast" data-toast-key-value="<%= key %>" data-toast-seconds-value="<%= ApplicationHelper::FAILURE_TOAST_SECONDS %>" data-toast-remove-value="true" data-action="mouseenter->toast#pause mouseleave->toast#resume focusin->toast#pause focusout->toast#resume">
  <p class="toast__message"><%= message %></p>
  <button type="button" class="toast__close" aria-label="Close" data-action="toast#close"><%= icon(:close, size: 18) %></button>
</div>
