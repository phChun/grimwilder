<%# locals: (text:, name:, id:, value: 0, min: 0, max: nil, suffix: nil) %>
<%# − value +: a real number input (so it submits and types like one) with step buttons. stepper_controller.js does the stepping. %>
<div class="stepper" data-controller="stepper">
  <label class="stepper__label" for="<%= id %>"><%= text %></label>
  <div class="stepper__control">
    <button type="button" class="stepper__step" data-action="stepper#down" aria-label="One fewer: <%= text %>">−</button>
    <input type="number" id="<%= id %>" name="<%= name %>" value="<%= value %>" min="<%= min %>"<% if max %> max="<%= max %>"<% end %> inputmode="numeric" autocomplete="off" class="stepper__value" data-stepper-target="input">
    <button type="button" class="stepper__step" data-action="stepper#up" aria-label="One more: <%= text %>">+</button>
  </div>
  <% if suffix %><span class="stepper__suffix"><%= suffix %></span><% end %>
</div>
