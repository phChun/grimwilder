<%# locals: (talent:, character: nil, eldritch: nil) %>
<article id="talent-<%= talent.key %>" class="<%= class_names("talent", "talent--core": talent.core?) %>" data-talent-filter-target="item" data-search="<%= [ talent.name, talent.group.name, talent.summary, talent.text ].join(" ").downcase %>">
  <header class="talent__header">
    <h3 class="talent__name"><%= talent.name %></h3>
    <span class="talent__meta">
      <% if talent.core? %><span class="tag">Core</span> <% end %>
      <% talent.prohibited_paths.each do |path| %><span class="tag" title="Not available to the <%= path %> path">Not for <%= path %></span> <% end %>
      <% talent.only_paths.each do |path| %><span class="tag" title="Only the <%= path %> path can take it"><%= path %> only</span> <% end %>
      pg. <%= talent.page %>
    </span>
  </header>
  <%= render "talents/kinds", talent: talent %>
  <p class="talent__summary"><%= talent.summary %></p>
  <% if talent.choices.any? %><p class="talent__choices">Choose <%= talent.choices.map(&:to_s).to_sentence %></p><% end %>
  <% if talent.core? && talent.growth %><p class="talent-card__growth"><span class="talent-card__label">Grows</span> <%= talent.growth %></p><% end %>
  <%# The summary is our gist; the book's text and tip fold away (search still matches them). %>
  <details class="fold talent__more">
    <summary class="fold__summary">From the book</summary>
    <div class="talent__text">
      <% talent.paragraphs.each do |paragraph| %>
        <p><%= paragraph %></p>
      <% end %>
    </div>
    <% if talent.note.present? %>
      <p class="talent__note"><%= talent.note %></p>
    <% end %>
  </details>
  <% if character && !talent.core? %>
    <%# On the picker (characters/talents/new): an Add toggle tied to the Taken panel's form, so several can be picked and saved at once (talent_picker_controller.js). %>
    <div class="talent__take">
      <% chosen = eldritch ? character.has_eldritch_talent?(talent) : character.has_talent?(talent) %>
      <% unavailable = eldritch ? !character.eldritch_choosable?(talent) : talent.prohibited_for?(character.path) %>
      <% if eldritch && character.has_talent?(talent) %>
        <span class="tag">Taken</span>
      <% elsif !eldritch && character.has_eldritch_talent?(talent) %>
        <span class="tag">Eldritch</span>
      <% elsif !chosen && unavailable %>
        <span class="field__hint">Not available to a <%= character.path %>.</span>
      <% else %>
        <label class="talent-toggle">
          <%= check_box_tag "talents[]", talent.key, chosen, id: "pick-#{talent.key}", form: "talent-list", class: "talent-toggle__box", data: { talent_picker_target: "box", action: "talent-picker#update", name: talent.name, summary: talent.summary } %>
          <span class="button button--small talent-toggle__add">Add<span class="visually-hidden"> <%= talent.name %></span></span>
          <span class="button button--small button--primary talent-toggle__added"><%= icon(:check, size: 16) %> Added<span class="visually-hidden"> <%= talent.name %></span></span>
        </label>
        <% if eldritch && talent.one_time_only? %><p class="field__hint">Its "One time only" feature won't work as an Eldritch Talent.</p><% end %>
      <% end %>
    </div>
  <% end %>
</article>
