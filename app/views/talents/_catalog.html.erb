<%# locals: (groups:, character: nil) %>
<div class="talent-catalog" data-controller="talent-filter">
  <div class="talent-catalog__tools">
    <input type="search" class="field__input talent-catalog__search" placeholder="Search talents: stealth, spark, potent…" autocomplete="off" aria-label="Search talents" data-talent-filter-target="query" data-action="input->talent-filter#filter">
    <nav class="talent-catalog__jump" aria-label="Jump to a path">
      <% groups.each do |group| %>
        <a href="#group-<%= group.key %>" class="chip chip--link"><%= group.path? ? group.name : "Background" %></a>
      <% end %>
    </nav>
    <p class="field__hint" data-talent-filter-target="count" aria-live="polite"></p>
  </div>

  <% groups.each do |group| %>
    <section id="group-<%= group.key %>" class="talent-group" data-talent-filter-target="group" aria-labelledby="heading-<%= group.key %>">
      <header class="talent-group__header">
        <h2 id="heading-<%= group.key %>" class="section-title"><%= group.path? ? "The #{group.name}" : group.name %></h2>
        <% if group.aka %><p class="field__hint">AKA the <%= group.aka %></p><% end %>
        <% if group.tagline %><p class="talent-group__tagline"><%= group.tagline %></p><% end %>
      </header>
      <div class="talent-grid">
        <% group.talents.each do |talent| %>
          <%= render "talents/talent", talent: talent, character: character %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
