[
    {
        "label": "🤖 Claude",
        "command": "claude",
        "use_new_terminal": true
    },
    {
        "label": "🤖 Claude Resume",
        "command": "claude",
        "args": ["--resume"],
        "use_new_terminal": true
    },
    {
        "label": "💎 Rails Server",
        "command": "bundle",
        "args": ["exec", "rails", "server"],
        "env": {
            "RAILS_ENV": "development"
        },
        "use_new_terminal": true
    },
    {
        "label": "🖥️ Rails Console",
        "command": "bundle",
        "args": ["exec", "rails", "console"],
        "use_new_terminal": true
    },
    {
        "label": "🧪 Run All Tests",
        "command": "bin/rails",
        "args": ["test"],
        "use_new_terminal": false
    },
    {
        "label": "🧪 Run Current Test File",
        "command": "bin/rails",
        "args": ["test", "${ZED_FILE}"],
        "use_new_terminal": false
    },
    {
        "label": "🧪 Run Test at Cursor",
        "command": "bin/rails",
        "args": ["test", "${ZED_FILE}:${ZED_ROW}"],
        "use_new_terminal": false
    },
    {
        "label": "🎲 Run Dice Tests (JS)",
        "command": "node",
        "args": ["--test", "test/javascript/dice.test.mjs"],
        "use_new_terminal": false
    },
    {
        "label": "🗄️ DB Migrate",
        "command": "bundle",
        "args": ["exec", "rails", "db:migrate"],
        "use_new_terminal": false
    },
    {
        "label": "🗄️ DB Rollback",
        "command": "bundle",
        "args": ["exec", "rails", "db:rollback"],
        "use_new_terminal": false
    },
    {
        "label": "🗄️ DB Reset",
        "command": "bundle",
        "args": ["exec", "rails", "db:reset"],
        "use_new_terminal": false
    },
    {
        "label": "🌱 DB Seed",
        "command": "bundle",
        "args": ["exec", "rails", "db:seed"],
        "use_new_terminal": false
    },
    {
        "label": "🔧 RuboCop Fix",
        "command": "bin/rubocop",
        "args": ["-a"],
        "use_new_terminal": false
    },
    {
        "label": "🔍 RuboCop Check",
        "command": "bin/rubocop",
        "args": [],
        "use_new_terminal": false
    },
    {
        "label": "💎 Bundle Install",
        "command": "bundle",
        "args": ["install"],
        "use_new_terminal": false
    },
    {
        "label": "🚀 Rails Generate",
        "command": "bundle",
        "args": ["exec", "rails", "generate"],
        "use_new_terminal": true
    },
    {
        "label": "🧹 Clean Logs",
        "command": "rm",
        "args": ["-f", "log/*.log"],
        "use_new_terminal": false
    },
    {
        "label": "🪵 Follow Developer Logs",
        "command": "tail",
        "args": ["-f", "log/development.log"],
        "use_new_terminal": false
    }
]
